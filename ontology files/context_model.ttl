    :hasContextId "CTX-PWR-001" ;
    :hasContextName "LowBattery" ;
    :hasPriority 70 ;
    :isActive false ;
    :isExclusive false ;
    :maximumDuration 1800000 ;  # 30 minutes in ms
    :contextDescription "Low battery condition - triggers power saving actions"@en ;
    :contextDescription "低电量状态 - 触发省电动作"@zh .

:context_PowerSave rdf:type :PowerSaveContext ;
