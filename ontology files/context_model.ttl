# =============================================================================
# INDIVIDUALS - Context Transitions
# =============================================================================

# Transition: Normal -> Maintenance
:transition_NormalToMaintenance rdf:type :ContextTransition ;
    rdfs:label "Normal to Maintenance Transition"@en ;
    rdfs:label "正常到维护切换"@zh ;
    :transitionId "TRANS-001" ;
    :fromContext :context_NormalOperation ;
    :toContext :context_MaintenanceMode ;
    :transitionPriority 30 ;
    rdfs:comment "Transition from normal operation to maintenance mode"@en ;
    rdfs:comment "从正常运行到维护模式的切换"@zh .

# Transition: Normal -> OTA
:transition_NormalToOTA rdf:type :ContextTransition ;
    rdfs:label "Normal to OTA Transition"@en ;
    rdfs:label "正常到OTA切换"@zh ;
    :transitionId "TRANS-002" ;
    :fromContext :context_NormalOperation ;
    :toContext :context_NormalOTA ;
    :transitionPriority 60 ;
    rdfs:comment "Transition from normal operation to OTA update"@en ;
    rdfs:comment "从正常运行到OTA更新的切换"@zh .

# Transition: Normal -> Low Battery
:transition_NormalToLowBattery rdf:type :ContextTransition ;
    rdfs:label "Normal to Low Battery Transition"@en ;
    rdfs:label "正常到低电量切换"@zh ;
    :transitionId "TRANS-003" ;
    :fromContext :context_NormalOperation ;
    :toContext :context_LowBattery ;
    :transitionPriority 70 ;
    rdfs:comment "Transition triggered by low battery detection"@en ;
    rdfs:comment "由低电量检测触发的切换"@zh .

# Transition: OTA -> Normal
:transition_OTAToNormal rdf:type :ContextTransition ;
    rdfs:label "OTA to Normal Transition"@en ;
    rdfs:label "OTA到正常切换"@zh ;
    :transitionId "TRANS-004" ;
    :fromContext :context_NormalOTA ;
    :toContext :context_NormalOperation ;
    :transitionPriority 10 ;
    rdfs:comment "Transition from OTA update back to normal operation"@en ;
    rdfs:comment "从OTA更新返回正常运行的切换"@zh .

# Transition: Maintenance -> Normal
:transition_MaintenanceToNormal rdf:type :ContextTransition ;
    rdfs:label "Maintenance to Normal Transition"@en ;
    rdfs:label "维护到正常切换"@zh ;
    :transitionId "TRANS-005" ;
    :fromContext :context_MaintenanceMode ;
    :toContext :context_NormalOperation ;
    :transitionPriority 10 ;
    rdfs:comment "Transition from maintenance mode back to normal operation"@en ;
    rdfs:comment "从维护模式返回正常运行的切换"@zh .

# Transition: Low Battery -> Power Save
:transition_LowBatteryToPowerSave rdf:type :ContextTransition ;
    rdfs:label "Low Battery to Power Save Transition"@en ;
    rdfs:label "低电量到省电切换"@zh ;
    :transitionId "TRANS-006" ;
    :fromContext :context_LowBattery ;
    :toContext :context_PowerSave ;
    :transitionPriority 65 ;
    rdfs:comment "Transition to power save mode from low battery context"@en ;
    rdfs:comment "从低电量上下文切换到省电模式"@zh .

# Transition: Normal -> Exhibition
:transition_NormalToExhibition rdf:type :ContextTransition ;
    rdfs:label "Normal to Exhibition Transition"@en ;
    rdfs:label "正常到展示切换"@zh ;
    :transitionId "TRANS-007" ;
    :fromContext :context_NormalOperation ;
    :toContext :context_ExhibitionMode ;
    :transitionPriority 25 ;
    rdfs:comment "Transition from normal operation to exhibition mode"@en ;
    rdfs:comment "从正常运行到展示模式的切换"@zh .

# Transition: Exhibition -> Normal
:transition_ExhibitionToNormal rdf:type :ContextTransition ;
    rdfs:label "Exhibition to Normal Transition"@en ;
    rdfs:label "展示到正常切换"@zh ;
    :transitionId "TRANS-008" ;
    :fromContext :context_ExhibitionMode ;
    :toContext :context_NormalOperation ;
    :transitionPriority 10 ;
    rdfs:comment "Transition from exhibition mode back to normal operation"@en ;
    rdfs:comment "从展示模式返回正常运行的切换"@zh .

# =============================================================================
# INDIVIDUALS - Valid Operations
# =============================================================================

:op_PowerOn rdf:type :ValidOperation ;
    rdfs:label "Power On Operation"@en ;
    rdfs:label "上电操作"@zh ;
    rdfs:comment "Operation to power on the vehicle"@en ;
    rdfs:comment "为车辆上电的操作"@zh .

:op_PowerOff rdf:type :ValidOperation ;
    rdfs:label "Power Off Operation"@en ;
    rdfs:label "下电操作"@zh ;
    rdfs:comment "Operation to power off the vehicle"@en ;
    rdfs:comment "为车辆下电的操作"@zh .

:op_RemoteStart rdf:type :ValidOperation ;
    rdfs:label "Remote Start Operation"@en ;
    rdfs:label "远程启动操作"@zh ;
    rdfs:comment "Operation to remotely start the vehicle"@en ;
    rdfs:comment "远程启动车辆的操作"@zh .

:op_DoorLock rdf:type :ValidOperation ;
    rdfs:label "Door Lock Operation"@en ;
    rdfs:label "门锁操作"@zh ;
    rdfs:comment "Operation to lock/unlock doors"@en ;
    rdfs:comment "锁止/解锁车门的操作"@zh .

:op_OTAUpdate rdf:type :ValidOperation ;
    rdfs:label "OTA Update Operation"@en ;
    rdfs:label "OTA更新操作"@zh ;
    rdfs:comment "Operation to perform OTA update"@en ;
    rdfs:comment "执行OTA更新的操作"@zh .

:op_DiagnosticRead rdf:type :ValidOperation ;
    rdfs:label "Diagnostic Read Operation"@en ;
    rdfs:label "诊断读取操作"@zh ;
    rdfs:comment "Operation to read diagnostic data"@en ;
    rdfs:comment "读取诊断数据的操作"@zh .

:op_ClimateControl rdf:type :ValidOperation ;
    rdfs:label "Climate Control Operation"@en ;
    rdfs:label "空调控制操作"@zh ;
    rdfs:comment "Operation to control climate system"@en ;
    rdfs:comment "控制空调系统的操作"@zh .

# =============================================================================
# INDIVIDUALS - Forbidden Operations
# =============================================================================

:op_FactoryReset rdf:type :ForbiddenOperation ;
    rdfs:label "Factory Reset Operation"@en ;
    rdfs:label "恢复出厂设置操作"@zh ;
    rdfs:comment "Operation to reset vehicle to factory settings - forbidden in normal operation"@en ;
    rdfs:comment "将车辆恢复出厂设置的操作 - 正常运行中禁止"@zh .

:op_FirmwareFlash rdf:type :ForbiddenOperation ;
    rdfs:label "Firmware Flash Operation"@en ;
    rdfs:label "固件刷写操作"@zh ;
    rdfs:comment "Operation to flash firmware - forbidden in normal operation"@en ;
    rdfs:comment "刷写固件的操作 - 正常运行中禁止"@zh .

:op_ImmobilizerBypass rdf:type :ForbiddenOperation ;
    rdfs:label "Immobilizer Bypass Operation"@en ;
    rdfs:label "防盗系统旁路操作"@zh ;
    rdfs:comment "Operation to bypass immobilizer - always forbidden"@en ;
    rdfs:comment "旁路防盗系统的操作 - 始终禁止"@zh .

# =============================================================================
# CONTEXT-OPERATION MAPPINGS
# =============================================================================

# Normal Operation Context - Allowed Operations
:context_NormalOperation :allowsOperation :op_PowerOn ;
    :allowsOperation :op_PowerOff ;
    :allowsOperation :op_RemoteStart ;
    :allowsOperation :op_DoorLock ;
    :allowsOperation :op_ClimateControl .

# Maintenance Context - Allowed Operations
:context_MaintenanceMode :allowsOperation :op_DiagnosticRead ;
    :allowsOperation :op_FirmwareFlash ;
    :forbidsOperation :op_RemoteStart .

# OTA Context - Allowed Operations
:context_NormalOTA :allowsOperation :op_OTAUpdate ;
    :allowsOperation :op_DiagnosticRead ;
    :forbidsOperation :op_PowerOff .

# Exhibition Context - Allowed Operations
:context_ExhibitionMode :allowsOperation :op_ClimateControl ;
    :forbidsOperation :op_PowerOn ;
    :forbidsOperation :op_PowerOff .

# Transportation Context - Allowed Operations
:context_TransportationMode :allowsOperation :op_PowerOn ;
    :forbidsOperation :op_RemoteStart ;
    :forbidsOperation :op_ClimateControl .

# Factory Context - Allowed Operations
:context_FactoryMode :allowsOperation :op_FactoryReset ;
    :allowsOperation :op_FirmwareFlash ;
    :allowsOperation :op_DiagnosticRead .

# Low Battery Context - Allowed Operations
:context_LowBattery :allowsOperation :op_PowerOff ;
    :forbidsOperation :op_ClimateControl ;
    :forbidsOperation :op_RemoteStart .

# Valet Mode Context - Allowed Operations
:context_ValetMode :allowsOperation :op_PowerOn ;
    :allowsOperation :op_DowerOff ;
    :forbidsOperation :op_RemoteStart ;
    :forbidsOperation :op_DiagnosticRead .

# =============================================================================
# CONTEXT TRANSITION LINKS
# =============================================================================

:context_NormalOperation :hasContextTransition :transition_NormalToMaintenance ;
    :hasContextTransition :transition_NormalToOTA ;
    :hasContextTransition :transition_NormalToLowBattery ;
    :hasContextTransition :transition_NormalToExhibition .

:context_MaintenanceMode :hasContextTransition :transition_MaintenanceToNormal .

:context_NormalOTA :hasContextTransition :transition_OTAToNormal .

:context_LowBattery :hasContextTransition :transition_LowBatteryToPowerSave .

:context_ExhibitionMode :hasContextTransition :transition_ExhibitionToNormal .

# =============================================================================
# COMPLEX OWL CONSTRUCTS
# =============================================================================

# -----------------------------------------------------------------------------
# Active Context Definition
# -----------------------------------------------------------------------------

:ActiveContext rdf:type owl:Class ;
    rdfs:label "Active Context"@en ;
    rdfs:label "激活上下文"@zh ;
    rdfs:comment "A context that is currently active"@en ;
    rdfs:comment "当前处于激活状态的上下文"@zh ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Context
            [ rdf:type owl:Restriction ;
              owl:onProperty :isActive ;
              owl:hasValue true
            ]
        )
    ] .

# -----------------------------------------------------------------------------
# Exclusive Context Definition
# -----------------------------------------------------------------------------

:ExclusiveActiveContext rdf:type owl:Class ;
    rdfs:label "Exclusive Active Context"@en ;
    rdfs:label "互斥激活上下文"@zh ;
    rdfs:comment "A context that is exclusive and active"@en ;
    rdfs:comment "处于激活状态的互斥上下文"@zh ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Context
            [ rdf:type owl:Restriction ;
              owl:onProperty :isExclusive ;
              owl:hasValue true
            ]
            [ rdf:type owl:Restriction ;
              owl:onProperty :isActive ;
              owl:hasValue true
            ]
        )
    ] .

# -----------------------------------------------------------------------------
# High Priority Context Definition
# -----------------------------------------------------------------------------

:HighPriorityContext rdf:type owl:Class ;
    rdfs:label "High Priority Context"@en ;
    rdfs:label "高优先级上下文"@zh ;
    rdfs:comment "A context with priority >= 50"@en ;
    rdfs:comment "优先级大于等于50的上下文"@zh ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Context
            [ rdf:type owl:Restriction ;
              owl:onProperty :hasPriority ;
              owl:someValuesFrom [
                  rdf:type rdfs:Datatype ;
                  owl:onDatatype xsd:integer ;
                  owl:withRestrictions ([ xsd:minInclusive 50 ])
              ]
            ]
        )
    ] .

# -----------------------------------------------------------------------------
# Diagnostic Context Union
# -----------------------------------------------------------------------------

:AnyDiagnosticContext rdf:type owl:Class ;
    rdfs:label "Any Diagnostic Context"@en ;
    rdfs:label "任意诊断上下文"@zh ;
    rdfs:comment "Union of all diagnostic context types"@en ;
    rdfs:comment "所有诊断上下文类型的联合"@zh ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:unionOf (:OBDDiagnosticContext :RemoteDiagnosticContext :SilentOTAContext :NormalOTAContext)
    ] .

# -----------------------------------------------------------------------------
# Power Context Union
# -----------------------------------------------------------------------------

:AnyPowerContext rdf:type owl:Class ;
    rdfs:label "Any Power Context"@en ;
    rdfs:label "任意电源上下文"@zh ;
    rdfs:comment "Union of all power context types"@en ;
    rdfs:comment "所有电源上下文类型的联合"@zh ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:unionOf (:LowPowerContext :PowerSaveContext :EmergencyPowerContext)
    ] .

# -----------------------------------------------------------------------------
# Security Context Union
# -----------------------------------------------------------------------------

:AnySecurityContext rdf:type owl:Class ;
    rdfs:label "Any Security Context"@en ;
    rdfs:label "任意安全上下文"@zh ;
    rdfs:comment "Union of all security context types"@en ;
    rdfs:comment "所有安全上下文类型的联合"@zh ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:unionOf (:TheftAlertContext :ValetModeContext :RemoteAccessContext)
    ] .

# =============================================================================
# CONSTRAINTS
# =============================================================================

# Priority must be non-negative
:hasPriority rdfs:range [
    rdf:type rdfs:Datatype ;
    owl:onDatatype xsd:integer ;
    owl:withRestrictions ([ xsd:minInclusive 0 ])
] .

# Duration must be non-negative
:hasDuration rdfs:range [
    rdf:type rdfs:Datatype ;
    owl:onDatatype xsd:integer ;
    owl:withRestrictions ([ xsd:minInclusive 0 ])
] .

# Maximum duration must be non-negative
:maximumDuration rdfs:range [
    rdf:type rdfs:Datatype ;
    owl:onDatatype xsd:integer ;
    owl:withRestrictions ([ xsd:minInclusive 0 ])
] .

# =============================================================================
# ANNOTATION PROPERTIES
# =============================================================================

:contextVersion rdf:type owl:AnnotationProperty ;
    rdfs:label "context version"@en ;
    rdfs:label "上下文版本"@zh ;
    rdfs:comment "Version of the context definition"@en ;
    rdfs:comment "上下文定义的版本"@zh ;
    rdfs:domain :Context ;
    rdfs:range xsd:string .

:contextOwner rdf:type owl:AnnotationProperty ;
    rdfs:label "context owner"@en ;
    rdfs:label "上下文所有者"@zh ;
    rdfs:comment "Owner or responsible party for the context"@en ;
    rdfs:comment "上下文的所有者或负责方"@zh ;
    rdfs:domain :Context ;
    rdfs:range xsd:string .

# =============================================================================
# ONTOLOGY ANNOTATIONS
# =============================================================================

<http://example.org/vehicle-power-management/context> 
    :contextVersion "1.0" ;
    rdfs:seeAlso <http://example.org/vehicle-power-management> ;
    rdfs:seeAlso <http://example.org/vehicle-power-management/action> .
