# Power On Event Example
# -----------------------------------------------------------------------------

:event_PowerOn_DoorOpen_20240315 rdf:type :DoorOpenPowerOnEvent ;
    rdfs:label "Power On by Door Open - 2024-03-15"@en ;
    rdfs:label "车门打开上电 - 2024-03-15"@zh ;
    :hasEventId "EVT-PO-20240315-001" ;
    :hasEventName "DoorOpenPowerOn" ;
    :hasEventType "PowerOn" ;
    :hasTimestamp "2024-03-15T08:30:45.123Z"^^xsd:dateTime ;
    :hasSource :sourceUser ;
    :hasEventPriority 10 ;
    :hasEventSeverity 1 ;
    :hasPreviousPowerMode :OffMode ;
    :hasNewPowerMode :LocalOnMode ;
    :triggersAction :action_DoorOpenPowerOn ;
    rdfs:comment "Vehicle powered on by driver door open with valid BLE key"@en ;
    rdfs:comment "驾驶员车门打开时使用有效蓝牙钥匙上电"@zh .

