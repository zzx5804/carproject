    :hasPreviousDoorLockState :DoorUnlocked ;
    :hasNewDoorLockState :DoorLocked ;
    :causes :event_PowerOff_DoorLock_20240315 ;
    rdfs:comment "All doors locked via key fob"@en ;
    rdfs:comment "通过遥控钥匙锁止所有车门"@zh .

