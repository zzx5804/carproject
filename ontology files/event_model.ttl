# =============================================================================
# INDIVIDUALS - Event Sequences
# =============================================================================

# -----------------------------------------------------------------------------
# Power On Sequence Example
# -----------------------------------------------------------------------------

:sequence_PowerOnSequence rdf:type :CausationChain ;
    rdfs:label "Power On Sequence"@en ;
    rdfs:label "上电序列"@zh ;
    :hasEventId "SEQ-PO-20240315-001" ;
    :sequenceLength 4 ;
    :sequenceStartTime "2024-03-15T08:30:40.000Z"^^xsd:dateTime ;
    :sequenceEndTime "2024-03-15T08:30:45.500Z"^^xsd:dateTime ;
    :hasFirstEvent :event_DoorOpen_FL_20240315 ;
    :hasLastEvent :event_PowerOn_DoorOpen_20240315 ;
    :containsEvent :event_DoorOpen_FL_20240315 ;
    :containsEvent :event_KeyValid_BLE_20240315 ;
    :containsEvent :event_PowerOn_DoorOpen_20240315 ;
    rdfs:comment "Complete power on sequence from door open to vehicle powered on"@en ;
    rdfs:comment "从车门打开到车辆上电的完整序列"@zh .

# Link events in the sequence
:event_DoorOpen_FL_20240315 
    :hasNextEvent :event_KeyValid_BLE_20240315 ;
    :sequencePosition 1 .

:event_KeyValid_BLE_20240315 
    :hasPreviousEvent :event_DoorOpen_FL_20240315 ;
    :hasNextEvent :event_PowerOn_DoorOpen_20240315 ;
    :sequencePosition 2 .

:event_PowerOn_DoorOpen_20240315 
    :hasPreviousEvent :event_KeyValid_BLE_20240315 ;
    :sequencePosition 3 .

# -----------------------------------------------------------------------------
# Power Off Sequence Example
# -----------------------------------------------------------------------------

:sequence_PowerOffSequence rdf:type :CausationChain ;
    rdfs:label "Power Off Sequence"@en ;
    rdfs:label "下电序列"@zh ;
    :hasEventId "SEQ-PF-20240315-001" ;
    :sequenceLength 3 ;
    :sequenceStartTime "2024-03-15T18:45:25.000Z"^^xsd:dateTime ;
    :sequenceEndTime "2024-03-15T18:45:35.000Z"^^xsd:dateTime ;
    :hasFirstEvent :event_DoorLock_20240315 ;
    :hasLastEvent :event_PowerOff_DoorLock_20240315 ;
    :containsEvent :event_DoorLock_20240315 ;
    :containsEvent :event_PowerOff_DoorLock_20240315 ;
    rdfs:comment "Complete power off sequence from door lock to vehicle powered off"@en ;
    rdfs:comment "从门锁到车辆下电的完整序列"@zh .

:event_DoorLock_20240315 
    :hasNextEvent :event_PowerOff_DoorLock_20240315 ;
    :sequencePosition 1 .

:event_PowerOff_DoorLock_20240315 
    :hasPreviousEvent :event_DoorLock_20240315 ;
    :sequencePosition 2 .

# =============================================================================
# COMPLEX OWL CONSTRUCTS
# =============================================================================

# -----------------------------------------------------------------------------
# Critical Event (High Severity)
# -----------------------------------------------------------------------------

:CriticalEvent rdf:type owl:Class ;
    rdfs:label "Critical Event"@en ;
    rdfs:label "严重事件"@zh ;
    rdfs:comment "Event with high severity level (>= 3)"@en ;
    rdfs:comment "高严重性级别（>=3）的事件"@zh ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Event
            [ rdf:type owl:Restriction ;
              owl:onProperty :hasEventSeverity ;
              owl:someValuesFrom [
                  rdf:type rdfs:Datatype ;
                  owl:onDatatype xsd:integer ;
                  owl:withRestrictions ([ xsd:minInclusive 3 ])
              ]
            ]
        )
    ] .

# -----------------------------------------------------------------------------
# Causally Linked Events
# -----------------------------------------------------------------------------

:CausallyLinkedEvent rdf:type owl:Class ;
    rdfs:label "Causally Linked Event"@en ;
    rdfs:label "因果链接事件"@zh ;
    rdfs:comment "Event that is part of a causation chain"@en ;
    rdfs:comment "作为因果链一部分的事件"@zh ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:unionOf (
            [ rdf:type owl:Restriction ;
              owl:onProperty :causes ;
              owl:someValuesFrom :Event
            ]
            [ rdf:type owl:Restriction ;
              owl:onProperty :causedBy ;
              owl:someValuesFrom :Event
            ]
        )
    ] .

# -----------------------------------------------------------------------------
# Power On Event Chain
# -----------------------------------------------------------------------------

:PowerOnEventChain rdf:type owl:Class ;
    rdfs:label "Power On Event Chain"@en ;
    rdfs:label "上电事件链"@zh ;
    rdfs:comment "A chain of events that leads to power on"@en ;
    rdfs:comment "导致上电的事件链"@zh ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :CausationChain
            [ rdf:type owl:Restriction ;
              owl:onProperty :hasLastEvent ;
              owl:someValuesFrom :PowerOnEvent
            ]
        )
    ] .

# -----------------------------------------------------------------------------
# Power Off Event Chain
# -----------------------------------------------------------------------------

:PowerOffEventChain rdf:type owl:Class ;
    rdfs:label "Power Off Event Chain"@en ;
    rdfs:label "下电事件链"@zh ;
    rdfs:comment "A chain of events that leads to power off"@en ;
    rdfs:comment "导致下电的事件链"@zh ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :CausationChain
            [ rdf:type owl:Restriction ;
              owl:onProperty :hasLastEvent ;
              owl:someValuesFrom :PowerOffEvent
            ]
        )
    ] .

# -----------------------------------------------------------------------------
# Fault Event with ECU Source
# -----------------------------------------------------------------------------

:FaultEventWithECUSource rdf:type owl:Class ;
    rdfs:label "Fault Event With ECU Source"@en ;
    rdfs:label "具有ECU源的故障事件"@zh ;
    rdfs:comment "Fault event that has an ECU as its source"@en ;
    rdfs:comment "以ECU为源的故障事件"@zh ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :FaultDetectedEvent
            [ rdf:type owl:Restriction ;
              owl:onProperty :hasFaultSource ;
              owl:someValuesFrom :ECU
            ]
        )
    ] .

# -----------------------------------------------------------------------------
# Sequential Events (within a time window)
# -----------------------------------------------------------------------------

:SequentialEvents rdf:type owl:Class ;
    rdfs:label "Sequential Events"@en ;
    rdfs:label "顺序事件"@zh ;
    rdfs:comment "Events that have explicit next/previous relationships"@en ;
    rdfs:comment "具有明确下一/前一关系的事件"@zh ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:unionOf (
            [ rdf:type owl:Restriction ;
              owl:onProperty :hasNextEvent ;
              owl:someValuesFrom :Event
            ]
            [ rdf:type owl:Restriction ;
              owl:onProperty :hasPreviousEvent ;
              owl:someValuesFrom :Event
            ]
        )
    ] .

# =============================================================================
# USAGE NOTES
# =============================================================================

# This event model extends the vehicle_power_management_ontology.ttl and
# action_model.ttl by adding event semantics with timestamps, causation,
# and sequencing.
#
# Usage:
# 1. Import this model into applications that need event tracking
# 2. Use hasTimestamp for temporal ordering
# 3. Use causedBy/causes for causation chains
# 4. Use hasPreviousEvent/hasNextEvent for explicit sequencing
# 5. Use EventSequence for grouping related events
#
# Example causation chain:
# :event_DoorOpen :causes :event_KeyValidation .
# :event_KeyValidation :causes :event_PowerOn .
#
# Example sequence:
# :sequence_PowerOn
#     :hasFirstEvent :event_DoorOpen ;
#     :hasLastEvent :event_PowerOn ;
#     :sequenceLength 3 .
# :event_DoorOpen :hasNextEvent :event_KeyValidation ; :sequencePosition 1 .
# :event_KeyValidation :hasNextEvent :event_PowerOn ; :sequencePosition 2 .
# :event_PowerOn :sequencePosition 3 .
