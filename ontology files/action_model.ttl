:action_KeyValidation rdf:type :KeyValidationAction ;
    rdfs:label "Key Validation Action"@en ;
    rdfs:label "钥匙验证动作"@zh ;
    :actionId "ACT-VAL-001" ;
    :actionName "KeyValidation" ;
