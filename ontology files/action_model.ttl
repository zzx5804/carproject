# =============================================================================
# COMPLEX OWL CONSTRUCTS
# =============================================================================

# -----------------------------------------------------------------------------
# Power On Action with Valid Key Restriction
# -----------------------------------------------------------------------------

:PowerOnActionWithValidKey rdf:type owl:Class ;
    rdfs:label "Power On Action With Valid Key"@en ;
    rdfs:label "具有有效钥匙的上电动作"@zh ;
    rdfs:comment "Power on action that requires valid key"@en ;
    rdfs:comment "需要有效钥匙的上电动作"@zh ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :PowerOnAction
            [ rdf:type owl:Restriction ;
              owl:onProperty :hasPrecondition ;
              owl:someValuesFrom [
                  rdf:type owl:Class ;
                  owl:intersectionOf (
                      :StateCondition
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :requiresKeyValidity ;
                        owl:hasValue :KeyValid
                      ]
                  )
              ]
            ]
        )
    ] .

# -----------------------------------------------------------------------------
# Emergency Action (High Priority)
# -----------------------------------------------------------------------------

:EmergencyAction rdf:type owl:Class ;
    rdfs:label "Emergency Action"@en ;
    rdfs:label "紧急动作"@zh ;
    rdfs:comment "Action with high priority level (>= 15)"@en ;
    rdfs:comment "高优先级（>=15）的动作"@zh ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Action
            [ rdf:type owl:Restriction ;
              owl:onProperty :priorityLevel ;
              owl:someValuesFrom [
                  rdf:type rdfs:Datatype ;
                  owl:onDatatype xsd:integer ;
                  owl:withRestrictions ([ xsd:minInclusive 15 ])
              ]
            ]
        )
    ] .

# -----------------------------------------------------------------------------
# Reversible Action
# -----------------------------------------------------------------------------

:ReversibleAction rdf:type owl:Class ;
    rdfs:label "Reversible Action"@en ;
    rdfs:label "可逆动作"@zh ;
    rdfs:comment "Action that can be reversed or undone"@en ;
    rdfs:comment "可以逆转或撤销的动作"@zh ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Action
            [ rdf:type owl:Restriction ;
              owl:onProperty :isReversible ;
              owl:hasValue true
            ]
        )
    ] .

# -----------------------------------------------------------------------------
# Action Chain (Sequence of Actions)
# -----------------------------------------------------------------------------

:ActionChain rdf:type owl:Class ;
    rdfs:label "Action Chain"@en ;
    rdfs:label "动作链"@zh ;
    rdfs:comment "A sequence of actions where each action triggers the next"@en ;
    rdfs:comment "一系列动作，每个动作触发下一个动作"@zh ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Action
            [ rdf:type owl:Restriction ;
              owl:onProperty :triggersAction ;
              owl:someValuesFrom :Action
            ]
        )
    ] .

# =============================================================================
# SIGNAL REFERENCE (Links to main ontology signals)
# =============================================================================

# Reference to signal from main ontology
:signalLVEM_LowBattPowerOff_Req rdf:type owl:Class ;
    rdfs:subClassOf :CANSignal ;
    rdfs:label "Low Battery Power Off Request Signal Reference"@en ;
    rdfs:label "低电量下电请求信号引用"@zh ;
    rdfs:comment "Reference to signal defined in main ontology"@en ;
    rdfs:comment "主本体中定义的信号引用"@zh .

# =============================================================================
# USAGE NOTES
# =============================================================================

# This action model extends the main vehicle_power_management_ontology.ttl
# by adding action semantics with preconditions, effects, and execution properties.
#
# Usage:
# 1. Import this model into the main ontology
# 2. Use hasPrecondition, hasEffect, hasActor to define action semantics
# 3. Create CompositeCondition for complex preconditions
# 4. Use TransitionEffect to model state machine transitions
#
# Example:
# :action_DoorOpenPowerOn
#     :hasPrecondition :cond_DoorOpenPowerOnPrecondition ;
#     :hasEffect :effect_TransitionToLocalOn ;
#     :hasActor :actorPowerModeManagement .
