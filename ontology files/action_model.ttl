    rdfs:comment "效果设置钥匙有效性状态"@zh ;
    rdfs:domain :StateEffect ;
    rdfs:range :KeyValidityStatus .

:setsPowerMode rdf:type owl:ObjectProperty ;
    rdfs:label "sets power mode"@en ;
    rdfs:label "设置电源模式"@zh ;
    rdfs:comment "Effect sets the power mode"@en ;
    rdfs:comment "效果设置电源模式"@zh ;
    rdfs:domain :StateEffect ;
    rdfs:range :PowerMode .

:setsPowerOnSource rdf:type owl:ObjectProperty ;
    rdfs:label "sets power on source"@en ;
    rdfs:label "设置上电源"@zh ;
    rdfs:comment "Effect sets the power on source"@en ;
    rdfs:comment "效果设置上电源"@zh ;
