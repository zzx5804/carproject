    :hasEffect :effect_SetPowerOffSourceForced ;
    :hasEffect :effect_TransmitPowerModeSignal ;
    :hasEffect :effect_TransmitPowerOffSourceSignal ;
    :hasEffect :effect_DisableReady ;
    :hasActor :actorPowerModeManagement ;
    :executionTimeout 1000 ;
    :priorityLevel 20 ;
    :isReversible false ;
    rdfs:comment "Power off action triggered by forced power off switch or button sequence"@en ;
    rdfs:comment "由强制下电开关或按钮序列触发的下电动作"@zh .

:action_LowBatteryPowerOff rdf:type :LowBatteryPowerOff ;
    rdfs:label "Low Battery Power Off Action"@en ;
    rdfs:label "低电量下电动作"@zh ;
    :actionId "ACT-PF-004" ;
    :actionName "LowBatteryPowerOff" ;
