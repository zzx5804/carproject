@prefix : <http://example.org/vehicle-power-management#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# =============================================================================
# ONTOLOGY METADATA
# =============================================================================

<http://example.org/vehicle-power-management/action> rdf:type owl:Ontology ;
    rdfs:label "Vehicle Power Management Action Model"@en ;
    rdfs:label "车辆电源管理动作模型"@zh ;
    rdfs:comment "Action component for Data Agent Design - defines actions, preconditions, effects, and execution semantics"@en ;
    rdfs:comment "数据代理设计的动作组件 - 定义动作、前置条件、效果和执行语义"@zh ;
    owl:versionInfo "1.0" ;
    owl:imports <http://example.org/vehicle-power-management/core> .

# =============================================================================
# CLASSES - Core Action Framework
# =============================================================================

# -----------------------------------------------------------------------------
# Action Base Class
# -----------------------------------------------------------------------------

:Action rdf:type owl:Class ;
    rdfs:label "Action"@en ;
    rdfs:label "动作"@zh ;
    rdfs:comment "Base class for all executable actions in the power management system"@en ;
    rdfs:comment "电源管理系统中所有可执行动作的基类"@zh ;
    skos:definition "An action is an operation that can be executed by an actor, with defined preconditions and effects"@en ;
    skos:definition "动作是可以由执行者执行的操作，具有定义的前置条件和效果"@zh .

# -----------------------------------------------------------------------------
# Actor Class
# -----------------------------------------------------------------------------

:Actor rdf:type owl:Class ;
    rdfs:label "Actor"@en ;
    rdfs:label "执行者"@zh ;
    rdfs:comment "An entity that can execute actions - can be a system component, user, or automated process"@en ;
    rdfs:comment "可以执行动作的实体 - 可以是系统组件、用户或自动化流程"@zh .

:SystemActor rdf:type owl:Class ;
    rdfs:subClassOf :Actor ;
    rdfs:label "System Actor"@en ;
    rdfs:label "系统执行者"@zh ;
    rdfs:comment "Automated system component that executes actions"@en ;
    rdfs:comment "执行动作的自动化系统组件"@zh .

:UserActor rdf:type owl:Class ;
    rdfs:subClassOf :Actor ;
    rdfs:label "User Actor"@en ;
    rdfs:label "用户执行者"@zh ;
    rdfs:comment "Human user that triggers actions"@en ;
    rdfs:comment "触发动作的人类用户"@zh .

:ECUActor rdf:type owl:Class ;
    rdfs:subClassOf :SystemActor ;
    rdfs:label "ECU Actor"@en ;
    rdfs:label "ECU执行者"@zh ;
    rdfs:comment "Electronic Control Unit that executes actions"@en ;
    rdfs:comment "执行动作的电子控制单元"@zh .

:LogicalComponentActor rdf:type owl:Class ;
    rdfs:subClassOf :SystemActor ;
    rdfs:label "Logical Component Actor"@en ;
    rdfs:label "逻辑部件执行者"@zh ;
    rdfs:comment "Logical software component that executes actions"@en ;
    rdfs:comment "执行动作的逻辑软件部件"@zh .

# -----------------------------------------------------------------------------
# Condition Class (Preconditions)
# -----------------------------------------------------------------------------

:Condition rdf:type owl:Class ;
    rdfs:label "Condition"@en ;
    rdfs:label "条件"@zh ;
    rdfs:comment "A condition that must be satisfied before an action can execute"@en ;
    rdfs:comment "动作执行前必须满足的条件"@zh ;
    skos:definition "A precondition or guard condition for action execution"@en ;
    skos:definition "动作执行的前置条件或守卫条件"@zh .

:Precondition rdf:type owl:Class ;
    rdfs:subClassOf :Condition ;
    rdfs:label "Precondition"@en ;
    rdfs:label "前置条件"@zh ;
    rdfs:comment "Condition that must be true before action execution"@en ;
    rdfs:comment "动作执行前必须为真的条件"@zh .

:GuardCondition rdf:type owl:Class ;
    rdfs:subClassOf :Condition ;
    rdfs:label "Guard Condition"@en ;
    rdfs:label "守卫条件"@zh ;
    rdfs:comment "Condition that guards action execution during runtime"@en ;
    rdfs:comment "运行时守卫动作执行的条件"@zh .

:StateCondition rdf:type owl:Class ;
    rdfs:subClassOf :Condition ;
    rdfs:label "State Condition"@en ;
    rdfs:label "状态条件"@zh ;
    rdfs:comment "Condition based on current system state"@en ;
    rdfs:comment "基于当前系统状态的条件"@zh .

:SignalCondition rdf:type owl:Class ;
    rdfs:subClassOf :Condition ;
    rdfs:label "Signal Condition"@en ;
    rdfs:label "信号条件"@zh ;
    rdfs:comment "Condition based on signal values"@en ;
    rdfs:comment "基于信号值的条件"@zh .

:TemporalCondition rdf:type owl:Class ;
    rdfs:subClassOf :Condition ;
    rdfs:label "Temporal Condition"@en ;
    rdfs:label "时间条件"@zh ;
    rdfs:comment "Condition based on time or timing constraints"@en ;
    rdfs:comment "基于时间或时序约束的条件"@zh .

:CompositeCondition rdf:type owl:Class ;
    rdfs:subClassOf :Condition ;
    rdfs:label "Composite Condition"@en ;
    rdfs:label "复合条件"@zh ;
    rdfs:comment "Condition composed of multiple sub-conditions using logical operators"@en ;
    rdfs:comment "使用逻辑运算符组合多个子条件的复合条件"@zh .

# -----------------------------------------------------------------------------
# Effect Class (Post-conditions)
# -----------------------------------------------------------------------------

:Effect rdf:type owl:Class ;
    rdfs:label "Effect"@en ;
    rdfs:label "效果"@zh ;
    rdfs:comment "The result or consequence of executing an action"@en ;
    rdfs:comment "执行动作产生的结果或后果"@zh ;
    skos:definition "A post-condition or outcome that holds after action execution"@en ;
    skos:definition "动作执行后成立的后置条件或结果"@zh .

:StateEffect rdf:type owl:Class ;
    rdfs:subClassOf :Effect ;
    rdfs:label "State Effect"@en ;
    rdfs:label "状态效果"@zh ;
    rdfs:comment "Effect that changes system state"@en ;
    rdfs:comment "改变系统状态的效果"@zh .

:SignalEffect rdf:type owl:Class ;
    rdfs:subClassOf :Effect ;
    rdfs:label "Signal Effect"@en ;
    rdfs:label "信号效果"@zh ;
    rdfs:comment "Effect that produces or modifies signals"@en ;
    rdfs:comment "产生或修改信号的效果"@zh .

:TransitionEffect rdf:type owl:Class ;
    rdfs:subClassOf :Effect ;
    rdfs:label "Transition Effect"@en ;
    rdfs:label "跳转效果"@zh ;
    rdfs:comment "Effect that causes state transitions"@en ;
    rdfs:comment "引起状态跳转的效果"@zh .

:OutputEffect rdf:type owl:Class ;
    rdfs:subClassOf :Effect ;
    rdfs:label "Output Effect"@en ;
    rdfs:label "输出效果"@zh ;
    rdfs:comment "Effect that produces output data or messages"@en ;
    rdfs:comment "产生输出数据或消息的效果"@zh .

# -----------------------------------------------------------------------------
# Input/Output Classes
# -----------------------------------------------------------------------------

:ActionInput rdf:type owl:Class ;
    rdfs:label "Action Input"@en ;
    rdfs:label "动作输入"@zh ;
    rdfs:comment "Input data required for action execution"@en ;
    rdfs:comment "动作执行所需的输入数据"@zh .

:ActionOutput rdf:type owl:Class ;
    rdfs:label "Action Output"@en ;
    rdfs:label "动作输出"@zh ;
    rdfs:comment "Output data produced by action execution"@en ;
    rdfs:comment "动作执行产生的输出数据"@zh .

:SignalInput rdf:type owl:Class ;
    rdfs:subClassOf :ActionInput ;
    rdfs:label "Signal Input"@en ;
    rdfs:label "信号输入"@zh ;
    rdfs:comment "Input consisting of signal values"@en ;
    rdfs:comment "由信号值组成的输入"@zh .

:SignalOutput rdf:type owl:Class ;
    rdfs:subClassOf :ActionOutput ;
    rdfs:label "Signal Output"@en ;
    rdfs:label "信号输出"@zh ;
    rdfs:comment "Output consisting of signal values"@en ;
    rdfs:comment "由信号值组成的输出"@zh .

:StateInput rdf:type owl:Class ;
    rdfs:subClassOf :ActionInput ;
    rdfs:label "State Input"@en ;
    rdfs:label "状态输入"@zh ;
    rdfs:comment "Input consisting of state information"@en ;
    rdfs:comment "由状态信息组成的输入"@zh .

:StateOutput rdf:type owl:Class ;
    rdfs:subClassOf :ActionOutput ;
    rdfs:label "State Output"@en ;
    rdfs:label "状态输出"@zh ;
    rdfs:comment "Output consisting of state information"@en ;
    rdfs:comment "由状态信息组成的输出"@zh .

# =============================================================================
# CLASSES - Action Subclasses
# =============================================================================

# -----------------------------------------------------------------------------
# Power Mode Actions
# -----------------------------------------------------------------------------

:PowerModeAction rdf:type owl:Class ;
    rdfs:subClassOf :Action ;
    rdfs:label "Power Mode Action"@en ;
    rdfs:label "电源模式动作"@zh ;
    rdfs:comment "Actions related to power mode changes"@en ;
    rdfs:comment "与电源模式变更相关的动作"@zh .

:PowerOnAction rdf:type owl:Class ;
    rdfs:subClassOf :PowerModeAction ;
    rdfs:label "Power On Action"@en ;
    rdfs:label "上电动作"@zh ;
    rdfs:comment "Action to power on the vehicle or component"@en ;
    rdfs:comment "为车辆或部件上电的动作"@zh .

:DoorOpenPowerOn rdf:type owl:Class ;
    rdfs:subClassOf :PowerOnAction ;
    rdfs:label "Door Open Power On"@en ;
    rdfs:label "车门打开上电"@zh ;
    rdfs:comment "Power on triggered by door open event"@en ;
    rdfs:comment "由车门打开事件触发的上电"@zh .

:BrakePressPowerOn rdf:type owl:Class ;
    rdfs:subClassOf :PowerOnAction ;
    rdfs:label "Brake Press Power On"@en ;
    rdfs:label "制动踏板上电"@zh ;
    rdfs:comment "Power on triggered by brake pedal press"@en ;
    rdfs:comment "由制动踏板踩下触发的上电"@zh .

:OTAPowerOn rdf:type owl:Class ;
    rdfs:subClassOf :PowerOnAction ;
    rdfs:label "OTA Power On"@en ;
    rdfs:label "OTA上电"@zh ;
    rdfs:comment "Power on triggered by OTA update request"@en ;
    rdfs:comment "由OTA更新请求触发的上电"@zh .

:RemoteDiagPowerOn rdf:type owl:Class ;
    rdfs:subClassOf :PowerOnAction ;
    rdfs:label "Remote Diagnostic Power On"@en ;
    rdfs:label "远程诊断上电"@zh ;
    rdfs:comment "Power on triggered by remote diagnostic request"@en ;
    rdfs:comment "由远程诊断请求触发的上电"@zh .

:XPURequestPowerOn rdf:type owl:Class ;
    rdfs:subClassOf :PowerOnAction ;
    rdfs:label "XPU Request Power On"@en ;
    rdfs:label "XPU请求上电"@zh ;
    rdfs:comment "Power on triggered by XPU (autonomous driving unit) request"@en ;
    rdfs:comment "由XPU（自动驾驶单元）请求触发的上电"@zh .

:PowerOffAction rdf:type owl:Class ;
    rdfs:subClassOf :PowerModeAction ;
    rdfs:label "Power Off Action"@en ;
    rdfs:label "下电动作"@zh ;
    rdfs:comment "Action to power off the vehicle or component"@en ;
    rdfs:comment "为车辆或部件下电的动作"@zh .

:DoorLockPowerOff rdf:type owl:Class ;
    rdfs:subClassOf :PowerOffAction ;
    rdfs:label "Door Lock Power Off"@en ;
    rdfs:label "门锁下电"@zh ;
    rdfs:comment "Power off triggered by door lock event"@en ;
    rdfs:comment "由门锁事件触发的下电"@zh .

:TimeoutPowerOff rdf:type owl:Class ;
    rdfs:subClassOf :PowerOffAction ;
    rdfs:label "Timeout Power Off"@en ;
    rdfs:label "超时下电"@zh ;
    rdfs:comment "Power off triggered by timeout (auto power off)"@en ;
    rdfs:comment "由超时触发的下电（自动下电）"@zh .

:ForcedPowerOffAction rdf:type owl:Class ;
    rdfs:subClassOf :PowerOffAction ;
    rdfs:label "Forced Power Off Action"@en ;
    rdfs:label "强制下电动作"@zh ;
    rdfs:comment "Power off triggered by forced power off switch or button sequence"@en ;
    rdfs:comment "由强制下电开关或按钮序列触发的下电"@zh .

:LowBatteryPowerOff rdf:type owl:Class ;
    rdfs:subClassOf :PowerOffAction ;
    rdfs:label "Low Battery Power Off"@en ;
    rdfs:label "低电量下电"@zh ;
    rdfs:comment "Power off triggered by low battery condition"@en ;
    rdfs:comment "由低电量状态触发的下电"@zh .

:OTAPowerOff rdf:type owl:Class ;
    rdfs:subClassOf :PowerOffAction ;
    rdfs:label "OTA Power Off"@en ;
    rdfs:label "OTA下电"@zh ;
    rdfs:comment "Power off triggered by OTA completion or request"@en ;
    rdfs:comment "由OTA完成或请求触发的下电"@zh .

:XPURequestPowerOff rdf:type owl:Class ;
    rdfs:subClassOf :PowerOffAction ;
    rdfs:label "XPU Request Power Off"@en ;
    rdfs:label "XPU请求下电"@zh ;
    rdfs:comment "Power off triggered by XPU request"@en ;
    rdfs:comment "由XPU请求触发的下电"@zh .

# -----------------------------------------------------------------------------
# Transition Actions
# -----------------------------------------------------------------------------

:TransitionAction rdf:type owl:Class ;
    rdfs:subClassOf :Action ;
    rdfs:label "Transition Action"@en ;
    rdfs:label "跳转动作"@zh ;
    rdfs:comment "Action that causes state transitions"@en ;
    rdfs:comment "引起状态跳转的动作"@zh .

:StateTransitionAction rdf:type owl:Class ;
    rdfs:subClassOf :TransitionAction ;
    rdfs:label "State Transition Action"@en ;
    rdfs:label "状态跳转动作"@zh ;
    rdfs:comment "Action that transitions between specific states"@en ;
    rdfs:comment "在特定状态之间跳转的动作"@zh .

:PowerModeTransition rdf:type owl:Class ;
    rdfs:subClassOf :StateTransitionAction ;
    rdfs:label "Power Mode Transition"@en ;
    rdfs:label "电源模式跳转"@zh ;
    rdfs:comment "Action that transitions power mode from one state to another"@en ;
    rdfs:comment "将电源模式从一个状态跳转到另一个状态的动作"@zh .

:ReadyEnableTransition rdf:type owl:Class ;
    rdfs:subClassOf :StateTransitionAction ;
    rdfs:label "Ready Enable Transition"@en ;
    rdfs:label "Ready使能跳转"@zh ;
    rdfs:comment "Action that transitions Ready Enable state"@en ;
    rdfs:comment "跳转Ready使能状态的动作"@zh .

# -----------------------------------------------------------------------------
# Validation Actions
# -----------------------------------------------------------------------------

:ValidationAction rdf:type owl:Class ;
    rdfs:subClassOf :Action ;
    rdfs:label "Validation Action"@en ;
    rdfs:label "验证动作"@zh ;
    rdfs:comment "Action that validates some condition or data"@en ;
    rdfs:comment "验证某些条件或数据的动作"@zh .

:KeyValidationAction rdf:type owl:Class ;
    rdfs:subClassOf :ValidationAction ;
    rdfs:label "Key Validation Action"@en ;
    rdfs:label "钥匙验证动作"@zh ;
    rdfs:comment "Action that validates key presence and validity"@en ;
    rdfs:comment "验证钥匙存在性和有效性的动作"@zh .

:BLEKeyValidation rdf:type owl:Class ;
    rdfs:subClassOf :KeyValidationAction ;
    rdfs:label "BLE Key Validation"@en ;
    rdfs:label "蓝牙钥匙验证"@zh ;
    rdfs:comment "Validation of Bluetooth Low Energy key"@en ;
    rdfs:comment "蓝牙低功耗钥匙的验证"@zh .

:RKEKeyValidation rdf:type owl:Class ;
    rdfs:subClassOf :KeyValidationAction ;
    rdfs:label "RKE Key Validation"@en ;
    rdfs:label "遥控钥匙验证"@zh ;
    rdfs:comment "Validation of Remote Keyless Entry key"@en ;
    rdfs:comment "遥控无钥匙进入钥匙的验证"@zh .

:NFCKeyValidation rdf:type owl:Class ;
    rdfs:subClassOf :KeyValidationAction ;
    rdfs:label "NFC Key Validation"@en ;
    rdfs:label "NFC钥匙验证"@zh ;
    rdfs:comment "Validation of NFC key"@en ;
    rdfs:comment "NFC钥匙的验证"@zh .

:SignalValidationAction rdf:type owl:Class ;
    rdfs:subClassOf :ValidationAction ;
    rdfs:label "Signal Validation Action"@en ;
    rdfs:label "信号验证动作"@zh ;
    rdfs:comment "Action that validates signal values or integrity"@en ;
    rdfs:comment "验证信号值或完整性的动作"@zh .

:AuthenticationAction rdf:type owl:Class ;
    rdfs:subClassOf :ValidationAction ;
    rdfs:label "Authentication Action"@en ;
    rdfs:label "认证动作"@zh ;
    rdfs:comment "Action that performs authentication between units"@en ;
    rdfs:comment "执行单元之间认证的动作"@zh .

# -----------------------------------------------------------------------------
# Diagnostic Actions
# -----------------------------------------------------------------------------

:DiagnosticAction rdf:type owl:Class ;
    rdfs:subClassOf :Action ;
    rdfs:label "Diagnostic Action"@en ;
    rdfs:label "诊断动作"@zh ;
    rdfs:comment "Action related to diagnostic operations"@en ;
    rdfs:comment "与诊断操作相关的动作"@zh .

:OBDDiagnosticAction rdf:type owl:Class ;
    rdfs:subClassOf :DiagnosticAction ;
    rdfs:label "OBD Diagnostic Action"@en ;
    rdfs:label "OBD诊断动作"@zh ;
    rdfs:comment "On-board diagnostic action via CAN or Ethernet"@en ;
    rdfs:comment "通过CAN或以太网的在线诊断动作"@zh .

:RemoteDiagnosticAction rdf:type owl:Class ;
    rdfs:subClassOf :DiagnosticAction ;
    rdfs:label "Remote Diagnostic Action"@en ;
    rdfs:label "远程诊断动作"@zh ;
    rdfs:comment "Remote diagnostic action via telematics"@en ;
    rdfs:comment "通过远程通信的远程诊断动作"@zh .

:OTAUpdateAction rdf:type owl:Class ;
    rdfs:subClassOf :DiagnosticAction ;
    rdfs:label "OTA Update Action"@en ;
    rdfs:label "OTA更新动作"@zh ;
    rdfs:comment "Over-the-air software update action"@en ;
    rdfs:comment "空中软件更新动作"@zh .

:FaultDetectionAction rdf:type owl:Class ;
    rdfs:subClassOf :DiagnosticAction ;
    rdfs:label "Fault Detection Action"@en ;
    rdfs:label "故障检测动作"@zh ;
    rdfs:comment "Action that detects and records faults"@en ;
    rdfs:comment "检测并记录故障的动作"@zh .

:ErrorMonitoringAction rdf:type owl:Class ;
    rdfs:subClassOf :DiagnosticAction ;
    rdfs:label "Error Monitoring Action"@en ;
    rdfs:label "异常监控动作"@zh ;
    rdfs:comment "Action that monitors for power control errors"@en ;
    rdfs:comment "监控电源控制异常的动作"@zh .

# -----------------------------------------------------------------------------
# Control Actions
# -----------------------------------------------------------------------------

:ControlAction rdf:type owl:Class ;
    rdfs:subClassOf :Action ;
    rdfs:label "Control Action"@en ;
    rdfs:label "控制动作"@zh ;
    rdfs:comment "Action that controls system behavior"@en ;
    rdfs:comment "控制系统行为的动作"@zh .

:TimerAction rdf:type owl:Class ;
    rdfs:subClassOf :ControlAction ;
    rdfs:label "Timer Action"@en ;
    rdfs:label "计时器动作"@zh ;
    rdfs:comment "Action related to timer operations"@en ;
    rdfs:comment "与计时器操作相关的动作"@zh .

:StartTimer rdf:type owl:Class ;
    rdfs:subClassOf :TimerAction ;
    rdfs:label "Start Timer"@en ;
    rdfs:label "启动计时器"@zh ;
    rdfs:comment "Action to start a timer"@en ;
    rdfs:comment "启动计时器的动作"@zh .

:StopTimer rdf:type owl:Class ;
    rdfs:subClassOf :TimerAction ;
    rdfs:label "Stop Timer"@en ;
    rdfs:label "停止计时器"@zh ;
    rdfs:comment "Action to stop a timer"@en ;
    rdfs:comment "停止计时器的动作"@zh .

:ResetTimer rdf:type owl:Class ;
    rdfs:subClassOf :TimerAction ;
    rdfs:label "Reset Timer"@en ;
    rdfs:label "重置计时器"@zh ;
    rdfs:comment "Action to reset a timer"@en ;
    rdfs:comment "重置计时器的动作"@zh .

:CancelAction rdf:type owl:Class ;
    rdfs:subClassOf :ControlAction ;
    rdfs:label "Cancel Action"@en ;
    rdfs:label "取消动作"@zh ;
    rdfs:comment "Action that cancels another ongoing action"@en ;
    rdfs:comment "取消另一个正在进行的动作的动作"@zh .

# =============================================================================
# OBJECT PROPERTIES - Action Properties
# =============================================================================

# -----------------------------------------------------------------------------
# Core Action Properties
# -----------------------------------------------------------------------------

:hasPrecondition rdf:type owl:ObjectProperty ;
    rdfs:label "has precondition"@en ;
    rdfs:label "具有前置条件"@zh ;
    rdfs:comment "Links an action to its preconditions that must be satisfied before execution"@en ;
    rdfs:comment "将动作链接到其执行前必须满足的前置条件"@zh ;
    rdfs:domain :Action ;
    rdfs:range :Condition .

:hasEffect rdf:type owl:ObjectProperty ;
    rdfs:label "has effect"@en ;
    rdfs:label "具有效果"@zh ;
    rdfs:comment "Links an action to its effects that result from execution"@en ;
    rdfs:comment "将动作链接到其执行产生的效果"@zh ;
    rdfs:domain :Action ;
    rdfs:range :Effect .

:hasActor rdf:type owl:ObjectProperty ;
    rdfs:label "has actor"@en ;
    rdfs:label "具有执行者"@zh ;
    rdfs:comment "Links an action to the actor that executes it"@en ;
    rdfs:comment "将动作链接到执行它的执行者"@zh ;
    rdfs:domain :Action ;
    rdfs:range :Actor .

:hasInput rdf:type owl:ObjectProperty ;
    rdfs:label "has input"@en ;
    rdfs:label "具有输入"@zh ;
    rdfs:comment "Links an action to its required input data"@en ;
    rdfs:comment "将动作链接到其所需的输入数据"@zh ;
    rdfs:domain :Action ;
    rdfs:range :ActionInput .

:hasOutput rdf:type owl:ObjectProperty ;
    rdfs:label "has output"@en ;
    rdfs:label "具有输出"@zh ;
    rdfs:comment "Links an action to its output data"@en ;
    rdfs:comment "将动作链接到其输出数据"@zh ;
    rdfs:domain :Action ;
    rdfs:range :ActionOutput .

# -----------------------------------------------------------------------------
# Condition Properties
# -----------------------------------------------------------------------------

:hasSubCondition rdf:type owl:ObjectProperty ;
    rdfs:label "has sub-condition"@en ;
    rdfs:label "具有子条件"@zh ;
    rdfs:comment "Links a composite condition to its sub-conditions"@en ;
    rdfs:comment "将复合条件链接到其子条件"@zh ;
    rdfs:domain :CompositeCondition ;
    rdfs:range :Condition .

:requiresState rdf:type owl:ObjectProperty ;
    rdfs:label "requires state"@en ;
    rdfs:label "要求状态"@zh ;
    rdfs:comment "Condition requires a specific state"@en ;
    rdfs:comment "条件要求特定状态"@zh ;
    rdfs:domain :StateCondition ;
    rdfs:range :PowerMode .

:requiresSignalValue rdf:type owl:ObjectProperty ;
    rdfs:label "requires signal value"@en ;
    rdfs:label "要求信号值"@zh ;
    rdfs:comment "Condition requires a specific signal value"@en ;
