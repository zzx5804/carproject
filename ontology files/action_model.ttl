    :executionTimeout 30000 ;
    :priorityLevel 18 ;
    :isReversible false ;
    rdfs:comment "Power off action triggered by low battery condition"@en ;
    rdfs:comment "由低电量状态触发的下电动作"@zh .

:action_OTAPowerOff rdf:type :OTAPowerOff ;
    rdfs:label "OTA Power Off Action"@en ;
    rdfs:label "OTA下电动作"@zh ;
    :actionId "ACT-PF-005" ;
    :actionName "OTAPowerOff" ;
    :hasPrecondition :cond_VehicleRemoteOn ;
    :hasEffect :effect_TransitionRemoteToOff ;
    :hasEffect :effect_TransmitPowerModeSignal ;
    :hasEffect :effect_TransmitPowerOffSourceSignal ;
    :hasActor :actorPowerModeManagement ;
