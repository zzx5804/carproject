    :actionName "BLEKeyValidation" ;
    :hasActor :actorKeySearchAndValidation ;
    :hasSignalInput :signalLDCU_BLEKeyValidSt ;
    :executionTimeout 3000 ;
    :priorityLevel 10 ;
