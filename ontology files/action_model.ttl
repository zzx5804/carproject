    :isReversible false ;
    rdfs:comment "Power off action triggered by OTA completion or request"@en ;
    rdfs:comment "由OTA完成或请求触发的下电动作"@zh .

:action_XPURequestPowerOff rdf:type :XPURequestPowerOff ;
    rdfs:label "XPU Request Power Off Action"@en ;
    rdfs:label "XPU请求下电动作"@zh ;
    :actionId "ACT-PF-006" ;
    :actionName "XPURequestPowerOff" ;
