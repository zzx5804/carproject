# -----------------------------------------------------------------------------
# Action Relationship Properties
# -----------------------------------------------------------------------------

:triggersAction rdf:type owl:ObjectProperty ;
    rdfs:label "triggers action"@en ;
    rdfs:label "触发动作"@zh ;
    rdfs:comment "One action triggers another action"@en ;
    rdfs:comment "一个动作触发另一个动作"@zh ;
    rdfs:domain :Action ;
    rdfs:range :Action .

:followsAction rdf:type owl:ObjectProperty ;
    rdfs:label "follows action"@en ;
    rdfs:label "跟随动作"@zh ;
    rdfs:comment "This action follows another action"@en ;
    rdfs:comment "此动作跟随另一个动作"@zh ;
    rdfs:domain :Action ;
    rdfs:range :Action ;
    owl:inverseOf :triggersAction .

:cancelsAction rdf:type owl:ObjectProperty ;
    rdfs:label "cancels action"@en ;
    rdfs:label "取消动作"@zh ;
    rdfs:comment "This action cancels another action"@en ;
    rdfs:comment "此动作取消另一个动作"@zh ;
    rdfs:domain :CancelAction ;
    rdfs:range :Action .

:executedBy rdf:type owl:ObjectProperty ;
    rdfs:label "executed by"@en ;
    rdfs:label "由...执行"@zh ;
    rdfs:comment "Action is executed by a logical component"@en ;
    rdfs:comment "动作由逻辑部件执行"@zh ;
    rdfs:domain :Action ;
    rdfs:range :LogicalComponent ;
    owl:inverseOf :hasActor .

# -----------------------------------------------------------------------------
# Input/Output Properties
# -----------------------------------------------------------------------------

:hasSignalInput rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasInput ;
    rdfs:label "has signal input"@en ;
    rdfs:label "具有信号输入"@zh ;
    rdfs:comment "Action has signal input"@en ;
    rdfs:comment "动作具有信号输入"@zh ;
    rdfs:domain :Action ;
    rdfs:range :Signal .

:hasSignalOutput rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasOutput ;
    rdfs:label "has signal output"@en ;
    rdfs:label "具有信号输出"@zh ;
    rdfs:comment "Action has signal output"@en ;
    rdfs:comment "动作具有信号输出"@zh ;
    rdfs:domain :Action ;
    rdfs:range :Signal .

:hasStateInput rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasInput ;
    rdfs:label "has state input"@en ;
    rdfs:label "具有状态输入"@zh ;
    rdfs:comment "Action has state input"@en ;
    rdfs:comment "动作具有状态输入"@zh ;
    rdfs:domain :Action ;
    rdfs:range :PowerMode .

:hasStateOutput rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :hasOutput ;
    rdfs:label "has state output"@en ;
    rdfs:label "具有状态输出"@zh ;
    rdfs:comment "Action has state output"@en ;
    rdfs:comment "动作具有状态输出"@zh ;
    rdfs:domain :Action ;
    rdfs:range :PowerMode .

# =============================================================================
# DATA PROPERTIES
# =============================================================================

# -----------------------------------------------------------------------------
# Action Data Properties
# -----------------------------------------------------------------------------

:actionId rdf:type owl:DatatypeProperty ;
    rdfs:label "action ID"@en ;
    rdfs:label "动作编号"@zh ;
    rdfs:comment "Unique identifier for an action"@en ;
    rdfs:comment "动作的唯一标识符"@zh ;
    rdfs:domain :Action ;
    rdfs:range xsd:string .

:actionName rdf:type owl:DatatypeProperty ;
    rdfs:label "action name"@en ;
    rdfs:label "动作名称"@zh ;
    rdfs:comment "Human-readable name of the action"@en ;
    rdfs:comment "动作的可读名称"@zh ;
    rdfs:domain :Action ;
    rdfs:range xsd:string .

:executionTimeout rdf:type owl:DatatypeProperty ;
    rdfs:label "execution timeout"@en ;
    rdfs:label "执行超时"@zh ;
    rdfs:comment "Maximum time allowed for action execution in milliseconds"@en ;
    rdfs:comment "动作执行允许的最大时间，单位：毫秒"@zh ;
    rdfs:domain :Action ;
    rdfs:range xsd:integer .

:retryCount rdf:type owl:DatatypeProperty ;
    rdfs:label "retry count"@en ;
    rdfs:label "重试次数"@zh ;
    rdfs:comment "Number of times to retry action on failure"@en ;
    rdfs:comment "失败时重试动作的次数"@zh ;
    rdfs:domain :Action ;
    rdfs:range xsd:integer .

:isReversible rdf:type owl:DatatypeProperty ;
    rdfs:label "is reversible"@en ;
    rdfs:label "可逆"@zh ;
    rdfs:comment "Indicates if the action can be reversed"@en ;
    rdfs:comment "表示动作是否可以逆转"@zh ;
    rdfs:domain :Action ;
    rdfs:range xsd:boolean .

:priorityLevel rdf:type owl:DatatypeProperty ;
    rdfs:label "priority level"@en ;
    rdfs:label "优先级"@zh ;
    rdfs:comment "Priority level of the action (higher number = higher priority)"@en ;
    rdfs:comment "动作的优先级（数字越大优先级越高）"@zh ;
    rdfs:domain :Action ;
    rdfs:range xsd:integer .

# -----------------------------------------------------------------------------
# Condition Data Properties
# -----------------------------------------------------------------------------

:conditionId rdf:type owl:DatatypeProperty ;
    rdfs:label "condition ID"@en ;
    rdfs:label "条件编号"@zh ;
    rdfs:comment "Unique identifier for a condition"@en ;
    rdfs:comment "条件的唯一标识符"@zh ;
    rdfs:domain :Condition ;
    rdfs:range xsd:string .

:conditionExpression rdf:type owl:DatatypeProperty ;
    rdfs:label "condition expression"@en ;
    rdfs:label "条件表达式"@zh ;
    rdfs:comment "Formal expression of the condition"@en ;
    rdfs:comment "条件的正式表达式"@zh ;
    rdfs:domain :Condition ;
    rdfs:range xsd:string .

:logicalOperator rdf:type owl:DatatypeProperty ;
    rdfs:label "logical operator"@en ;
    rdfs:label "逻辑运算符"@zh ;
    rdfs:comment "Logical operator for composite conditions (AND, OR, NOT)"@en ;
    rdfs:comment "复合条件的逻辑运算符（AND、OR、NOT）"@zh ;
    rdfs:domain :CompositeCondition ;
    rdfs:range xsd:string .

:requiredValue rdf:type owl:DatatypeProperty ;
    rdfs:label "required value"@en ;
    rdfs:label "要求值"@zh ;
    rdfs:comment "Required value for the condition"@en ;
    rdfs:comment "条件要求的值"@zh ;
    rdfs:domain :SignalCondition ;
    rdfs:range xsd:string .

:timeoutValue rdf:type owl:DatatypeProperty ;
    rdfs:label "timeout value"@en ;
    rdfs:label "超时值"@zh ;
    rdfs:comment "Timeout value in milliseconds"@en ;
    rdfs:comment "超时值，单位：毫秒"@zh ;
    rdfs:domain :TemporalCondition ;
    rdfs:range xsd:integer .

# -----------------------------------------------------------------------------
# Effect Data Properties
# -----------------------------------------------------------------------------

:effectId rdf:type owl:DatatypeProperty ;
    rdfs:label "effect ID"@en ;
    rdfs:label "效果编号"@zh ;
    rdfs:comment "Unique identifier for an effect"@en ;
    rdfs:comment "效果的唯一标识符"@zh ;
    rdfs:domain :Effect ;
    rdfs:range xsd:string .

:effectDescription rdf:type owl:DatatypeProperty ;
    rdfs:label "effect description"@en ;
    rdfs:label "效果描述"@zh ;
    rdfs:comment "Description of the effect"@en ;
    rdfs:comment "效果的描述"@zh ;
    rdfs:domain :Effect ;
    rdfs:range xsd:string .

:outputValue rdf:type owl:DatatypeProperty ;
    rdfs:label "output value"@en ;
    rdfs:label "输出值"@zh ;
    rdfs:comment "Value produced by the effect"@en ;
    rdfs:comment "效果产生的值"@zh ;
    rdfs:domain :SignalEffect ;
    rdfs:range xsd:string .

# =============================================================================
# INDIVIDUALS - Actors
# =============================================================================

:actorLDCU rdf:type :ECUActor ;
    rdfs:label "LDCU Actor"@en ;
    rdfs:label "LDCU执行者"@zh ;
    rdfs:comment "Left Domain Control Unit as action executor"@en ;
    rdfs:comment "作为动作执行者的左域控制器"@zh .

:actorRDCU rdf:type :ECUActor ;
    rdfs:label "RDCU Actor"@en ;
    rdfs:label "RDCU执行者"@zh ;
    rdfs:comment "Right Domain Control Unit as action executor"@en ;
    rdfs:comment "作为动作执行者的右域控制器"@zh .

:actorCDCU rdf:type :ECUActor ;
    rdfs:label "CDCU Actor"@en ;
    rdfs:label "CDCU执行者"@zh ;
    rdfs:comment "Central Domain Control Unit as action executor"@en ;
    rdfs:comment "作为动作执行者的中央域控制器"@zh .

:actorTBOX rdf:type :ECUActor ;
    rdfs:label "TBOX Actor"@en ;
    rdfs:label "TBOX执行者"@zh ;
    rdfs:comment "Telematics Box as action executor"@en ;
    rdfs:comment "作为动作执行者的远程通信单元"@zh .

:actorXPU rdf:type :ECUActor ;
    rdfs:label "XPU Actor"@en ;
    rdfs:label "XPU执行者"@zh ;
    rdfs:comment "Autonomous Driving Unit as action executor"@en ;
    rdfs:comment "作为动作执行者的自动驾驶单元"@zh .

:actorPowerModeManagement rdf:type :LogicalComponentActor ;
    rdfs:label "Power Mode Management Actor"@en ;
    rdfs:label "电源模式管理执行者"@zh ;
    rdfs:comment "LcPowerModeManagement as action executor"@en ;
    rdfs:comment "作为动作执行者的电源模式管理逻辑部件"@zh .

:actorKeySearchAndValidation rdf:type :LogicalComponentActor ;
    rdfs:label "Key Search and Validation Actor"@en ;
    rdfs:label "钥匙搜索验证执行者"@zh ;
    rdfs:comment "LcKeySearchAndValidation as action executor"@en ;
    rdfs:comment "作为动作执行者的钥匙搜索验证逻辑部件"@zh .

:actorUser rdf:type :UserActor ;
    rdfs:label "User Actor"@en ;
    rdfs:label "用户执行者"@zh ;
    rdfs:comment "Human user as action trigger"@en ;
    rdfs:comment "作为动作触发者的人类用户"@zh .

# =============================================================================
# INDIVIDUALS - Conditions
# =============================================================================

# -----------------------------------------------------------------------------
# Power On Preconditions
# -----------------------------------------------------------------------------

:cond_VehicleOffMode rdf:type :StateCondition ;
    rdfs:label "Vehicle in Off Mode"@en ;
    rdfs:label "车辆处于关闭模式"@zh ;
    :conditionId "COND-001" ;
    :requiresState :OffMode ;
    rdfs:comment "Vehicle power mode must be Off"@en ;
    rdfs:comment "车辆电源模式必须为关闭"@zh .

:cond_DoorOpen rdf:type :StateCondition ;
    rdfs:label "Door is Open"@en ;
    rdfs:label "车门已打开"@zh ;
    :conditionId "COND-002" ;
    :requiresDoorState :DoorOpen ;
    rdfs:comment "At least one door is open"@en ;
    rdfs:comment "至少一个车门已打开"@zh .

:cond_BrakePressed rdf:type :StateCondition ;
    rdfs:label "Brake Pedal Pressed"@en ;
    rdfs:label "制动踏板已踩下"@zh ;
    :conditionId "COND-003" ;
    :requiresBrakePedalState :BrakePressed ;
    rdfs:comment "Brake pedal is pressed"@en ;
    rdfs:comment "制动踏板已踩下"@zh .

:cond_ValidKeyPresent rdf:type :StateCondition ;
    rdfs:label "Valid Key Present"@en ;
    rdfs:label "存在有效钥匙"@zh ;
    :conditionId "COND-004" ;
    :requiresKeyValidity :KeyValid ;
    rdfs:comment "A valid key is present"@en ;
    rdfs:comment "存在有效钥匙"@zh .

:cond_KeyInCar rdf:type :StateCondition ;
    rdfs:label "Key In Car"@en ;
    rdfs:label "钥匙在车内"@zh ;
    :conditionId "COND-005" ;
    :requiresKeyLocation :KeyInCar ;
    rdfs:comment "Key is located inside the vehicle"@en ;
    rdfs:comment "钥匙位于车内"@zh .

:cond_GearInP rdf:type :StateCondition ;
    rdfs:label "Gear in P Position"@en ;
    rdfs:label "档位在P档"@zh ;
    :conditionId "COND-006" ;
    :requiresGearPosition :GearP ;
    rdfs:comment "Gear position is in Park"@en ;
    rdfs:comment "档位在驻车档"@zh .

:cond_OTAValid rdf:type :StateCondition ;
    rdfs:label "OTA Power On Valid"@en ;
    rdfs:label "OTA上电有效"@zh ;
    :conditionId "COND-007" ;
    :requiresOTAPowerOnValidState :OTAPowerOnValidValid ;
    rdfs:comment "OTA power on validation is valid"@en ;
    rdfs:comment "OTA上电验证有效"@zh .

:cond_DiagnosticOTA rdf:type :StateCondition ;
    rdfs:label "Diagnostic State is OTA or Remote Diag"@en ;
    rdfs:label "诊断状态为OTA或远程诊断"@zh ;
    :conditionId "COND-008" ;
    :requiresDiagnosticState :NormalOTA ;
    rdfs:comment "Diagnostic state is Normal OTA, Silent OTA, or Remote Diag"@en ;
    rdfs:comment "诊断状态为普通OTA、静默OTA或远程诊断"@zh .

:cond_XPUPowerOnRequest rdf:type :SignalCondition ;
    rdfs:label "XPU Power On Request Signal"@en ;
    rdfs:label "XPU上电请求信号"@zh ;
    :conditionId "COND-009" ;
    :requiresSignalValue :signalXPU_PowerReq ;
    :requiredValue "0x1" ;
    rdfs:comment "XPU has requested power on"@en ;
    rdfs:comment "XPU已请求上电"@zh .

# -----------------------------------------------------------------------------
# Power Off Preconditions
# -----------------------------------------------------------------------------

:cond_VehicleLocalOn rdf:type :StateCondition ;
    rdfs:label "Vehicle in Local On Mode"@en ;
    rdfs:label "车辆处于本地开启模式"@zh ;
    :conditionId "COND-010" ;
    :requiresState :LocalOnMode ;
    rdfs:comment "Vehicle power mode is Local On"@en ;
    rdfs:comment "车辆电源模式为本地开启"@zh .

:cond_VehicleRemoteOn rdf:type :StateCondition ;
    rdfs:label "Vehicle in Remote On Mode"@en ;
    rdfs:label "车辆处于远程开启模式"@zh ;
    :conditionId "COND-011" ;
    :requiresState :RemoteOnMode ;
    rdfs:comment "Vehicle power mode is Remote On"@en ;
    rdfs:comment "车辆电源模式为远程开启"@zh .

:cond_DoorLocked rdf:type :StateCondition ;
    rdfs:label "Door is Locked"@en ;
    rdfs:label "车门已锁止"@zh ;
    :conditionId "COND-012" ;
    :requiresDoorLockState :DoorLocked ;
    rdfs:comment "All doors are locked"@en ;
    rdfs:comment "所有车门已锁止"@zh .

:cond_AllDoorsClosed rdf:type :StateCondition ;
    rdfs:label "All Doors Closed"@en ;
    rdfs:label "所有车门关闭"@zh ;
    :conditionId "COND-013" ;
    :requiresDoorState :DoorClosed ;
    rdfs:comment "All doors are closed"@en ;
    rdfs:comment "所有车门已关闭"@zh .

:cond_LowBattery rdf:type :SignalCondition ;
    rdfs:label "Low Battery Condition"@en ;
    rdfs:label "低电量条件"@zh ;
    :conditionId "COND-014" ;
    :requiresSignalValue :signalLVEM_LowBattPowerOff_Req ;
    :requiredValue "0x1" ;
    rdfs:comment "Low battery power off request is active"@en ;
    rdfs:comment "低电量下电请求激活"@zh .

:cond_TimeoutExpired rdf:type :TemporalCondition ;
    rdfs:label "Timeout Expired"@en ;
    rdfs:label "超时已过期"@zh ;
    :conditionId "COND-015" ;
    rdfs:comment "Auto power off timeout has expired"@en ;
    rdfs:comment "自动下电超时已过期"@zh .

:cond_ForcePowerOffSwitch rdf:type :SignalCondition ;
    rdfs:label "Force Power Off Switch Pressed"@en ;
    rdfs:label "强制下电开关已按下"@zh ;
    :conditionId "COND-016" ;
    :requiresSignalValue :signalEmergencyPowerOffSwSt ;
    :requiredValue "0x1" ;
    rdfs:comment "Emergency power off switch is pressed"@en ;
    rdfs:comment "紧急下电开关已按下"@zh .

:cond_CancelPowerOffNotActive rdf:type :SignalCondition ;
    rdfs:label "Cancel Power Off Not Active"@en ;
    rdfs:label "取消下电未激活"@zh ;
    :conditionId "COND-017" ;
    :requiresSignalValue :signalCDCU_CancelPowerOffSW ;
    :requiredValue "0x0" ;
    rdfs:comment "Cancel power off switch is not active"@en ;
    rdfs:comment "取消下电开关未激活"@zh .

# -----------------------------------------------------------------------------
# Composite Conditions
# -----------------------------------------------------------------------------

:cond_DoorOpenPowerOnPrecondition rdf:type :CompositeCondition ;
    rdfs:label "Door Open Power On Precondition"@en ;
    rdfs:label "车门打开上电前置条件"@zh ;
    :conditionId "COND-COMP-001" ;
    :logicalOperator "AND" ;
    :hasSubCondition :cond_VehicleOffMode ;
    :hasSubCondition :cond_DoorOpen ;
    :hasSubCondition :cond_ValidKeyPresent ;
    rdfs:comment "Composite condition for door open power on: OffMode AND DoorOpen AND ValidKey"@en ;
    rdfs:comment "车门打开上电的复合条件：关闭模式 且 车门打开 且 有效钥匙"@zh .

:cond_BrakePressPowerOnPrecondition rdf:type :CompositeCondition ;
    rdfs:label "Brake Press Power On Precondition"@en ;
    rdfs:label "制动踏板上电前置条件"@zh ;
    :conditionId "COND-COMP-002" ;
    :logicalOperator "AND" ;
    :hasSubCondition :cond_VehicleOffMode ;
    :hasSubCondition :cond_BrakePressed ;
    :hasSubCondition :cond_ValidKeyPresent ;
    :hasSubCondition :cond_KeyInCar ;
    rdfs:comment "Composite condition for brake press power on: OffMode AND BrakePressed AND ValidKey AND KeyInCar"@en ;
    rdfs:comment "制动踏板上电的复合条件：关闭模式 且 制动踩下 且 有效钥匙 且 钥匙在车内"@zh .

:cond_OTAPowerOnPrecondition rdf:type :CompositeCondition ;
    rdfs:label "OTA Power On Precondition"@en ;
    rdfs:label "OTA上电前置条件"@zh ;
    :conditionId "COND-COMP-003" ;
    :logicalOperator "AND" ;
    :hasSubCondition :cond_VehicleOffMode ;
    :hasSubCondition :cond_OTAValid ;
    rdfs:comment "Composite condition for OTA power on: OffMode AND OTAValid"@en ;
    rdfs:comment "OTA上电的复合条件：关闭模式 且 OTA上电有效"@zh .

:cond_DoorLockPowerOffPrecondition rdf:type :CompositeCondition ;
    rdfs:label "Door Lock Power Off Precondition"@en ;
    rdfs:label "门锁下电前置条件"@zh ;
    :conditionId "COND-COMP-004" ;
    :logicalOperator "AND" ;
    :hasSubCondition :cond_VehicleLocalOn ;
    :hasSubCondition :cond_DoorLocked ;
    :hasSubCondition :cond_AllDoorsClosed ;
    rdfs:comment "Composite condition for door lock power off: LocalOn AND DoorLocked AND DoorsClosed"@en ;
    rdfs:comment "门锁下电的复合条件：本地开启 且 门锁锁止 且 车门关闭"@zh .

:cond_LowBatteryPowerOffPrecondition rdf:type :CompositeCondition ;
    rdfs:label "Low Battery Power Off Precondition"@en ;
    rdfs:label "低电量下电前置条件"@zh ;
    :conditionId "COND-COMP-005" ;
    :logicalOperator "AND" ;
    :hasSubCondition :cond_VehicleLocalOn ;
    :hasSubCondition :cond_LowBattery ;
    rdfs:comment "Composite condition for low battery power off: LocalOn AND LowBattery"@en ;
    rdfs:comment "低电量下电的复合条件：本地开启 且 低电量"@zh .

# =============================================================================
# INDIVIDUALS - Effects
# =============================================================================

# -----------------------------------------------------------------------------
# Power On Effects
# -----------------------------------------------------------------------------

:effect_TransitionToLocalOn rdf:type :TransitionEffect ;
    rdfs:label "Transition to Local On Mode"@en ;
    rdfs:label "跳转到本地开启模式"@zh ;
    :effectId "EFFECT-001" ;
    :causesTransitionFrom :OffMode ;
    :causesTransitionTo :LocalOnMode ;
    rdfs:comment "Effect that transitions power mode from Off to Local On"@en ;
    rdfs:comment "将电源模式从关闭跳转到本地开启的效果"@zh .

:effect_TransitionToRemoteOn rdf:type :TransitionEffect ;
    rdfs:label "Transition to Remote On Mode"@en ;
    rdfs:label "跳转到远程开启模式"@zh ;
    :effectId "EFFECT-002" ;
    :causesTransitionFrom :OffMode ;
    :causesTransitionTo :RemoteOnMode ;
    rdfs:comment "Effect that transitions power mode from Off to Remote On"@en ;
    rdfs:comment "将电源模式从关闭跳转到远程开启的效果"@zh .

:effect_SetPowerOnSourceDoorOpen rdf:type :StateEffect ;
    rdfs:label "Set Power On Source to Door Open"@en ;
    rdfs:label "设置上电源为车门打开"@zh ;
    :effectId "EFFECT-003" ;
    :setsPowerOnSource :PowerOnDoorOpen ;
    rdfs:comment "Effect that sets power on source to door open"@en ;
    rdfs:comment "设置上电源为车门打开的效果"@zh .

:effect_SetPowerOnSourceBrakePress rdf:type :StateEffect ;
    rdfs:label "Set Power On Source to Brake Press"@en ;
    rdfs:label "设置上电源为制动踏板"@zh ;
    :effectId "EFFECT-004" ;
    :setsPowerOnSource :PowerOnBrakePress ;
    rdfs:comment "Effect that sets power on source to brake press"@en ;
    rdfs:comment "设置上电源为制动踏板的效果"@zh .

:effect_SetPowerOnSourceOTA rdf:type :StateEffect ;
    rdfs:label "Set Power On Source to OTA"@en ;
    rdfs:label "设置上电源为OTA"@zh ;
    :effectId "EFFECT-005" ;
    :setsPowerOnSource :PowerOnOTARemoteDiag ;
    rdfs:comment "Effect that sets power on source to OTA/Remote Diag"@en ;
    rdfs:comment "设置上电源为OTA/远程诊断的效果"@zh .

:effect_StartKeySearch rdf:type :StateEffect ;
    rdfs:label "Start Key Search"@en ;
    rdfs:label "启动钥匙搜索"@zh ;
    :effectId "EFFECT-006" ;
    rdfs:comment "Effect that initiates key search process"@en ;
    rdfs:comment "启动钥匙搜索流程的效果"@zh .

:effect_EnableReady rdf:type :StateEffect ;
    rdfs:label "Enable Ready Enable State"@en ;
    rdfs:label "使能Ready使能状态"@zh ;
    :effectId "EFFECT-007" ;
    :setsReadyEnableState :EnableState ;
    rdfs:comment "Effect that enables the ready enable state"@en ;
    rdfs:comment "使能Ready使能状态的效果"@zh .

# -----------------------------------------------------------------------------
# Power Off Effects
# -----------------------------------------------------------------------------

:effect_TransitionToOff rdf:type :TransitionEffect ;
    rdfs:label "Transition to Off Mode"@en ;
    rdfs:label "跳转到关闭模式"@zh ;
    :effectId "EFFECT-010" ;
    :causesTransitionFrom :LocalOnMode ;
    :causesTransitionTo :OffMode ;
    rdfs:comment "Effect that transitions power mode to Off"@en ;
    rdfs:comment "将电源模式跳转到关闭的效果"@zh .

:effect_TransitionRemoteToOff rdf:type :TransitionEffect ;
    rdfs:label "Transition Remote On to Off Mode"@en ;
    rdfs:label "远程开启跳转到关闭模式"@zh ;
    :effectId "EFFECT-011" ;
    :causesTransitionFrom :RemoteOnMode ;
    :causesTransitionTo :OffMode ;
    rdfs:comment "Effect that transitions power mode from Remote On to Off"@en ;
    rdfs:comment "将电源模式从远程开启跳转到关闭的效果"@zh .

:effect_SetPowerOffSourceDoorLock rdf:type :StateEffect ;
    rdfs:label "Set Power Off Source to Door Lock"@en ;
    rdfs:label "设置下电源为门锁"@zh ;
    :effectId "EFFECT-012" ;
    :setsPowerOffSource :PowerOffDoorLock ;
    rdfs:comment "Effect that sets power off source to door lock"@en ;
    rdfs:comment "设置下电源为门锁的效果"@zh .

:effect_SetPowerOffSourceForced rdf:type :StateEffect ;
    rdfs:label "Set Power Off Source to Forced"@en ;
    rdfs:label "设置下电源为强制下电"@zh ;
    :effectId "EFFECT-013" ;
    :setsPowerOffSource :PowerOffForcePowerOff ;
    rdfs:comment "Effect that sets power off source to forced power off"@en ;
    rdfs:comment "设置下电源为强制下电的效果"@zh .

:effect_SetPowerOffSourceAuto rdf:type :StateEffect ;
    rdfs:label "Set Power Off Source to Auto"@en ;
    rdfs:label "设置下电源为自动下电"@zh ;
    :effectId "EFFECT-014" ;
    :setsPowerOffSource :PowerOffAutoPowerOff ;
    rdfs:comment "Effect that sets power off source to auto power off"@en ;
    rdfs:comment "设置下电源为自动下电的效果"@zh .

:effect_SetPowerOffSourceLowBattery rdf:type :StateEffect ;
    rdfs:label "Set Power Off Source to Low Battery"@en ;
    rdfs:label "设置下电源为低电量"@zh ;
    :effectId "EFFECT-015" ;
    :setsPowerOffSource :PowerOffAutoPowerOff ;
    rdfs:comment "Effect that sets power off source to low battery power off"@en ;
    rdfs:comment "设置下电源为低电量下电的效果"@zh .

:effect_DisableReady rdf:type :StateEffect ;
    rdfs:label "Disable Ready Enable State"@en ;
    rdfs:label "禁用Ready使能状态"@zh ;
    :effectId "EFFECT-016" ;
    :setsReadyEnableState :DisableState ;
    rdfs:comment "Effect that disables the ready enable state"@en ;
    rdfs:comment "禁用Ready使能状态的效果"@zh .

:effect_StopKeySearch rdf:type :StateEffect ;
    rdfs:label "Stop Key Search"@en ;
    rdfs:label "停止钥匙搜索"@zh ;
    :effectId "EFFECT-017" ;
    rdfs:comment "Effect that stops key search process"@en ;
    rdfs:comment "停止钥匙搜索流程的效果"@zh .

:effect_TransmitPowerModeSignal rdf:type :SignalEffect ;
    rdfs:label "Transmit Power Mode Signal"@en ;
    rdfs:label "发送电源模式信号"@zh ;
    :effectId "EFFECT-020" ;
    :producesSignal :signalLDCU_PowerMode ;
    rdfs:comment "Effect that transmits power mode signal via CAN"@en ;
    rdfs:comment "通过CAN发送电源模式信号的效果"@zh .

:effect_TransmitPowerOnSourceSignal rdf:type :SignalEffect ;
    rdfs:label "Transmit Power On Source Signal"@en ;
    rdfs:label "发送上电源信号"@zh ;
    :effectId "EFFECT-021" ;
    :producesSignal :signalLDCU_PowerONSource ;
    rdfs:comment "Effect that transmits power on source signal via CAN"@en ;
    rdfs:comment "通过CAN发送上电源信号的效果"@zh .

:effect_TransmitPowerOffSourceSignal rdf:type :SignalEffect ;
    rdfs:label "Transmit Power Off Source Signal"@en ;
    rdfs:label "发送下电源信号"@zh ;
    :effectId "EFFECT-022" ;
    :producesSignal :signalLDCU_PowerOFFSource ;
    rdfs:comment "Effect that transmits power off source signal via CAN"@en ;
    rdfs:comment "通过CAN发送下电源信号的效果"@zh .

:effect_TransmitReadyEnableSignal rdf:type :SignalEffect ;
    rdfs:label "Transmit Ready Enable Signal"@en ;
    rdfs:label "发送Ready使能信号"@zh ;
    :effectId "EFFECT-023" ;
    :producesSignal :signalLDCU_ReadyEnable ;
    rdfs:comment "Effect that transmits ready enable signal via CAN"@en ;
    rdfs:comment "通过CAN发送Ready使能信号的效果"@zh .

# =============================================================================
# INDIVIDUALS - Actions
# =============================================================================

# -----------------------------------------------------------------------------
# Power On Actions
# -----------------------------------------------------------------------------

:action_DoorOpenPowerOn rdf:type :DoorOpenPowerOn ;
    rdfs:label "Door Open Power On Action"@en ;
    rdfs:label "车门打开上电动作"@zh ;
    :actionId "ACT-PO-001" ;
    :actionName "DoorOpenPowerOn" ;
    :hasPrecondition :cond_DoorOpenPowerOnPrecondition ;
    :hasEffect :effect_TransitionToLocalOn ;
    :hasEffect :effect_SetPowerOnSourceDoorOpen ;
    :hasEffect :effect_TransmitPowerModeSignal ;
    :hasEffect :effect_TransmitPowerOnSourceSignal ;
    :hasEffect :effect_StartKeySearch ;
    :hasActor :actorPowerModeManagement ;
    :executionTimeout 5000 ;
    :priorityLevel 10 ;
    :isReversible false ;
    rdfs:comment "Power on action triggered by door open event with valid key"@en ;
    rdfs:comment "由车门打开事件触发的上电动作，需要有效钥匙"@zh .

:action_BrakePressPowerOn rdf:type :BrakePressPowerOn ;
    rdfs:label "Brake Press Power On Action"@en ;
    rdfs:label "制动踏板上电动作"@zh ;
    :actionId "ACT-PO-002" ;
    :actionName "BrakePressPowerOn" ;
    :hasPrecondition :cond_BrakePressPowerOnPrecondition ;
    :hasEffect :effect_TransitionToLocalOn ;
    :hasEffect :effect_SetPowerOnSourceBrakePress ;
    :hasEffect :effect_TransmitPowerModeSignal ;
    :hasEffect :effect_TransmitPowerOnSourceSignal ;
    :hasEffect :effect_EnableReady ;
    :hasActor :actorPowerModeManagement ;
    :executionTimeout 3000 ;
    :priorityLevel 15 ;
    :isReversible false ;
    rdfs:comment "Power on action triggered by brake pedal press with valid key in car"@en ;
    rdfs:comment "由制动踏板踩下触发的上电动作，需要有效钥匙在车内"@zh .

:action_OTAPowerOn rdf:type :OTAPowerOn ;
    rdfs:label "OTA Power On Action"@en ;
    rdfs:label "OTA上电动作"@zh ;
    :actionId "ACT-PO-003" ;
    :actionName "OTAPowerOn" ;
    :hasPrecondition :cond_OTAPowerOnPrecondition ;
    :hasEffect :effect_TransitionToRemoteOn ;
    :hasEffect :effect_SetPowerOnSourceOTA ;
    :hasEffect :effect_TransmitPowerModeSignal ;
    :hasEffect :effect_TransmitPowerOnSourceSignal ;
    :hasActor :actorPowerModeManagement ;
    :executionTimeout 10000 ;
    :priorityLevel 8 ;
    :isReversible false ;
    rdfs:comment "Power on action triggered by OTA update request"@en ;
    rdfs:comment "由OTA更新请求触发的上电动作"@zh .

:action_RemoteDiagPowerOn rdf:type :RemoteDiagPowerOn ;
    rdfs:label "Remote Diagnostic Power On Action"@en ;
    rdfs:label "远程诊断上电动作"@zh ;
    :actionId "ACT-PO-004" ;
    :actionName "RemoteDiagPowerOn" ;
    :hasPrecondition :cond_OTAPowerOnPrecondition ;
    :hasEffect :effect_TransitionToRemoteOn ;
    :hasEffect :effect_SetPowerOnSourceOTA ;
    :hasEffect :effect_TransmitPowerModeSignal ;
    :hasEffect :effect_TransmitPowerOnSourceSignal ;
    :hasActor :actorPowerModeManagement ;
    :executionTimeout 10000 ;
    :priorityLevel 8 ;
    :isReversible false ;
    rdfs:comment "Power on action triggered by remote diagnostic request"@en ;
    rdfs:comment "由远程诊断请求触发的上电动作"@zh .

:action_XPURequestPowerOn rdf:type :XPURequestPowerOn ;
    rdfs:label "XPU Request Power On Action"@en ;
    rdfs:label "XPU请求上电动作"@zh ;
    :actionId "ACT-PO-005" ;
    :actionName "XPURequestPowerOn" ;
    :hasPrecondition :cond_VehicleOffMode ;
    :hasPrecondition :cond_XPUPowerOnRequest ;
    :hasEffect :effect_TransitionToRemoteOn ;
    :hasEffect :effect_TransmitPowerModeSignal ;
    :hasEffect :effect_TransmitPowerOnSourceSignal ;
    :hasActor :actorPowerModeManagement ;
    :executionTimeout 5000 ;
    :priorityLevel 12 ;
    :isReversible false ;
    rdfs:comment "Power on action triggered by XPU (autonomous driving) request"@en ;
    rdfs:comment "由XPU（自动驾驶）请求触发的上电动作"@zh .

# -----------------------------------------------------------------------------
# Power Off Actions
# -----------------------------------------------------------------------------

:action_DoorLockPowerOff rdf:type :DoorLockPowerOff ;
    rdfs:label "Door Lock Power Off Action"@en ;
    rdfs:label "门锁下电动作"@zh ;
    :actionId "ACT-PF-001" ;
    :actionName "DoorLockPowerOff" ;
    :hasPrecondition :cond_DoorLockPowerOffPrecondition ;
    :hasEffect :effect_TransitionToOff ;
    :hasEffect :effect_SetPowerOffSourceDoorLock ;
    :hasEffect :effect_TransmitPowerModeSignal ;
    :hasEffect :effect_TransmitPowerOffSourceSignal ;
    :hasEffect :effect_DisableReady ;
    :hasEffect :effect_StopKeySearch ;
    :hasActor :actorPowerModeManagement ;
    :executionTimeout 5000 ;
    :priorityLevel 10 ;
    :isReversible false ;
    rdfs:comment "Power off action triggered by door lock event when all doors are closed"@en ;
    rdfs:comment "由门锁事件触发的下电动作，需要所有车门关闭"@zh .

:action_TimeoutPowerOff rdf:type :TimeoutPowerOff ;
