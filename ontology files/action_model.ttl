    :actionName "TimeoutPowerOff" ;
    :hasPrecondition :cond_VehicleLocalOn ;
    :hasPrecondition :cond_TimeoutExpired ;
    :hasPrecondition :cond_CancelPowerOffNotActive ;
    :hasEffect :effect_TransitionToOff ;
    :hasEffect :effect_SetPowerOffSourceAuto ;
    :hasEffect :effect_TransmitPowerModeSignal ;
    :hasEffect :effect_TransmitPowerOffSourceSignal ;
    :hasEffect :effect_DisableReady ;
    :hasActor :actorPowerModeManagement ;
    :executionTimeout 3000 ;
    :priorityLevel 5 ;
    :isReversible false ;
    rdfs:comment "Power off action triggered by auto power off timeout"@en ;
    rdfs:comment "由自动下电超时触发的下电动作"@zh .

:action_ForcedPowerOff rdf:type :ForcedPowerOffAction ;
    rdfs:label "Forced Power Off Action"@en ;
    rdfs:label "强制下电动作"@zh ;
    :actionId "ACT-PF-003" ;
    :actionName "ForcedPowerOff" ;
    :hasPrecondition :cond_VehicleLocalOn ;
    :hasPrecondition :cond_ForcePowerOffSwitch ;
