# =============================================================================
# COMPLEX OWL CONSTRUCTS
# =============================================================================

# -----------------------------------------------------------------------------
# Valid Key Union (OR) - Any of these key types is considered valid
# -----------------------------------------------------------------------------

:ValidKeyUnion rdf:type owl:Class ;
    rdfs:label "Valid Key Union"@en ;
    rdfs:label "有效钥匙联合"@zh ;
    rdfs:comment "Union of all valid key types"@en ;
    rdfs:comment "所有有效钥匙类型的联合"@zh ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:unionOf (:BLEKey :RKEKey :NFCKey :UWBKey :DigitalKey :PhysicalKey)
    ] .

# -----------------------------------------------------------------------------
# Vehicle with Valid Key Restriction
# -----------------------------------------------------------------------------

:VehicleWithValidKey rdf:type owl:Class ;
    rdfs:label "Vehicle With Valid Key"@en ;
    rdfs:label "具有有效钥匙的车辆"@zh ;
    rdfs:comment "Vehicle that has at least one valid key"@en ;
    rdfs:comment "至少具有一把有效钥匙的车辆"@zh ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasKey ;
        owl:someValuesFrom :ValidKey
    ] .

# -----------------------------------------------------------------------------
# Power Mode State Machine Transitions
# -----------------------------------------------------------------------------

# OffMode can transition to ConvenienceMode, LocalOnMode or RemoteOnMode
:OffModeTransitions rdf:type owl:Class ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :transitionsTo ;
        owl:allValuesFrom [
            rdf:type owl:Class ;
            owl:unionOf (:ConvenienceMode :LocalOnMode :RemoteOnMode)
        ]
    ] .

# LocalOnMode can transition to OffMode, ConvenienceMode or RemoteOnMode
:LocalOnModeTransitions rdf:type owl:Class ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :transitionsTo ;
        owl:allValuesFrom [
            rdf:type owl:Class ;
            owl:unionOf (:OffMode :ConvenienceMode :RemoteOnMode)
        ]
    ] .

# RemoteOnMode can transition to OffMode, ConvenienceMode or LocalOnMode
:RemoteOnModeTransitions rdf:type owl:Class ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :transitionsTo ;
        owl:allValuesFrom [
            rdf:type owl:Class ;
            owl:unionOf (:OffMode :ConvenienceMode :LocalOnMode)
        ]
    ] .

# -----------------------------------------------------------------------------
# Ready Enable State Machine Transitions
# -----------------------------------------------------------------------------

# Disable can transition to Enable
:DisableStateTransitions rdf:type owl:Class ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :transitionsToReadyEnable ;
        owl:allValuesFrom :EnableState
    ] .

# Enable can transition to Disable or Armed
:EnableStateTransitions rdf:type owl:Class ;
    rdfs:subClassOf [
        rdf:type owl:Restriction ;
        owl:onProperty :transitionsToReadyEnable ;
        owl:allValuesFrom [
            rdf:type owl:Class ;
            owl:unionOf (:DisableState :ArmedState)
        ]
    ] .

# -----------------------------------------------------------------------------
# Critical Vehicle State (Intersection)
# A vehicle is in critical state if it has high voltage on and is in motion
# -----------------------------------------------------------------------------

:CriticalVehicleState rdf:type owl:Class ;
    rdfs:label "Critical Vehicle State"@en ;
    rdfs:label "关键车辆状态"@zh ;
    rdfs:comment "Vehicle in critical operating state"@en ;
    rdfs:comment "处于关键运行状态的车辆"@zh ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Vehicle
            [ rdf:type owl:Restriction ;
              owl:onProperty :hasEVSystemState ;
              owl:hasValue :HighVoltageOn
            ]
        )
    ] .

# -----------------------------------------------------------------------------
# Vehicle Requiring Key Validation
# -----------------------------------------------------------------------------

:VehicleRequiringKeyValidation rdf:type owl:Class ;
    rdfs:label "Vehicle Requiring Key Validation"@en ;
    rdfs:label "需要钥匙验证的车辆"@zh ;
    rdfs:comment "Vehicle in power mode requiring key validation"@en ;
    rdfs:comment "处于需要钥匙验证的电源模式的车辆"@zh ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Vehicle
            [ rdf:type owl:Restriction ;
              owl:onProperty :hasPowerMode ;
              owl:someValuesFrom [
                  rdf:type owl:Class ;
                  owl:unionOf (:LocalOnMode :RemoteOnMode)
              ]
            ]
        )
    ] .

# -----------------------------------------------------------------------------
# Auto Power Off Active State
# -----------------------------------------------------------------------------

:AutoPowerOffActive rdf:type owl:Class ;
    rdfs:label "Auto Power Off Active"@en ;
    rdfs:label "自动下电激活"@zh ;
    rdfs:comment "Vehicle with auto power off countdown active"@en ;
    rdfs:comment "自动下电倒计时激活的车辆"@zh ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasStatus ;
        owl:someValuesFrom [
            rdf:type owl:Class ;
            owl:unionOf (:OneHourCountDownStarted :TenMinCountDownStarted)
        ]
    ] .

# -----------------------------------------------------------------------------
# Blocking Required for Vehicle Start
# -----------------------------------------------------------------------------

:BlockingRequiredForStart rdf:type owl:Class ;
    rdfs:label "Blocking Required For Start"@en ;
    rdfs:label "启动需要阻止"@zh ;
    rdfs:comment "Vehicle start is blocked due to alcohol interlock"@en ;
    rdfs:comment "由于酒精锁阻止车辆启动"@zh ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Vehicle
            [ rdf:type owl:Restriction ;
              owl:onProperty :hasStatus ;
              owl:someValuesFrom :Blocking
            ]
        )
    ] .

# =============================================================================
# END OF CORE MODEL
# =============================================================================
