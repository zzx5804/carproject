@prefix : <http://example.org/vehicle-power-management#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# =============================================================================
# CORE MODEL - Objects & Links (Data Agent Components 1-2)
# =============================================================================
#
# This file contains the core domain classes, properties, and individuals
# for the vehicle power management ontology.
# Part of Data Agent 10-Component framework (Components 1-2: Objects & Links)
#
# =============================================================================

<http://example.org/vehicle-power-management/core> rdf:type owl:Ontology ;
    rdfs:label "Vehicle Power Management Core Model"@en ;
    rdfs:label "车辆电源管理核心模型"@zh ;
    rdfs:comment "Core domain classes, properties, and individuals for vehicle power management"@en ;
    rdfs:comment "车辆电源管理的核心领域类、属性和实例"@zh ;
    owl:versionInfo "V1.0" .

# =============================================================================
# CLASSES - Core Domain Concepts
# =============================================================================

# -----------------------------------------------------------------------------
# Vehicle and Components
# -----------------------------------------------------------------------------

:Vehicle rdf:type owl:Class ;
    rdfs:label "Vehicle"@en ;
    rdfs:label "车辆"@zh ;
    rdfs:comment "The complete vehicle entity"@en ;
    rdfs:comment "完整的车辆实体"@zh .

:PhysicalComponent rdf:type owl:Class ;
    rdfs:label "Physical Component"@en ;
    rdfs:label "物理部件"@zh ;
    rdfs:comment "Physical hardware component in the vehicle"@en ;
    rdfs:comment "车辆中的物理硬件部件"@zh .

:ECU rdf:type owl:Class ;
    rdfs:subClassOf :PhysicalComponent ;
    rdfs:label "Electronic Control Unit"@en ;
    rdfs:label "电子控制单元"@zh .

:LDCU rdf:type owl:Class ;
    rdfs:subClassOf :ECU ;
    rdfs:label "Left Domain Control Unit"@en ;
    rdfs:label "左域控制器"@zh ;
    rdfs:comment "Left domain control unit responsible for power mode management"@en ;
    rdfs:comment "负责电源模式管理的左域控制器"@zh .

:RDCU rdf:type owl:Class ;
    rdfs:subClassOf :ECU ;
    rdfs:label "Right Domain Control Unit"@en ;
    rdfs:label "右域控制器"@zh ;
    rdfs:comment "Right domain control unit"@en ;
    rdfs:comment "右域控制器"@zh .

:CDCU rdf:type owl:Class ;
    rdfs:subClassOf :ECU ;
    rdfs:label "Central Domain Control Unit"@en ;
    rdfs:label "中央域控制器"@zh ;
    rdfs:comment "Central domain control unit for infotainment and vehicle coordination"@en ;
    rdfs:comment "用于信息娱乐和车辆协调的中央域控制器"@zh .

:TBOX rdf:type owl:Class ;
    rdfs:subClassOf :ECU ;
    rdfs:label "Telematics Box"@en ;
    rdfs:label "远程通信单元"@zh ;
    rdfs:comment "Telematics control unit for remote connectivity"@en ;
    rdfs:comment "用于远程连接的远程通信控制单元"@zh .

:XPU rdf:type owl:Class ;
    rdfs:subClassOf :ECU ;
    rdfs:label "Autonomous Driving Unit"@en ;
    rdfs:label "自动驾驶单元"@zh ;
    rdfs:comment "Autonomous driving processing unit"@en ;
    rdfs:comment "自动驾驶处理单元"@zh .

:IPB rdf:type owl:Class ;
    rdfs:subClassOf :ECU ;
    rdfs:label "Intelligent Power Brake"@en ;
    rdfs:label "智能制动系统"@zh .

:SRS rdf:type owl:Class ;
    rdfs:subClassOf :ECU ;
    rdfs:label "Safety Restraint System"@en ;
    rdfs:label "安全约束系统"@zh .

:IPUR rdf:type owl:Class ;
    rdfs:subClassOf :ECU ;
    rdfs:label "Rear Electric Drive Unit"@en ;
    rdfs:label "后电驱单元"@zh .

:BLE rdf:type owl:Class ;
    rdfs:subClassOf :ECU ;
    rdfs:label "Bluetooth Module"@en ;
    rdfs:label "蓝牙模块"@zh .

:AlcoholInterlock rdf:type owl:Class ;
    rdfs:subClassOf :PhysicalComponent ;
    rdfs:label "Alcohol Interlock"@en ;
    rdfs:label "酒精锁"@zh ;
    rdfs:comment "Alcohol interlock device for driver sobriety testing"@en ;
    rdfs:comment "用于驾驶员清醒度测试的酒精锁装置"@zh .

# -----------------------------------------------------------------------------
# Logical Components
# -----------------------------------------------------------------------------

:LogicalComponent rdf:type owl:Class ;
    rdfs:label "Logical Component"@en ;
    rdfs:label "逻辑部件"@zh ;
    rdfs:comment "Logical software component within ECU"@en ;
    rdfs:comment "ECU内的逻辑软件部件"@zh .

:LcPowerModeManagement rdf:type owl:Class ;
    rdfs:subClassOf :LogicalComponent ;
    rdfs:label "Logical Component - Power Mode Management"@en ;
    rdfs:label "逻辑部件 - 电源模式管理"@zh ;
    rdfs:comment "Responsible for implementing PowerMode state machine and all vehicle power on/off logic"@en ;
    rdfs:comment "负责实现电源模式状态机及所有车辆上下电功能逻辑"@zh .

:LcKeySearchAndValidation rdf:type owl:Class ;
    rdfs:subClassOf :LogicalComponent ;
    rdfs:label "Logical Component - Key Search and Validation"@en ;
    rdfs:label "逻辑部件 - 钥匙搜索和有效性判断"@zh ;
    rdfs:comment "Responsible for key search trigger logic and key validity judgment based on digital key, RKE key, and access subsystem positioning results"@en ;
    rdfs:comment "负责实现钥匙搜索触发逻辑，以及根据数字钥匙、遥控钥匙、进出入子系统给出的不同类型的钥匙的定位结果综合判断钥匙有效性"@zh .

:LcVehicleStartManagement rdf:type owl:Class ;
    rdfs:subClassOf :LogicalComponent ;
    rdfs:label "Logical Component - Vehicle Start Management"@en ;
    rdfs:label "逻辑部件 - 车辆启动管理"@zh .

:LcAlcoholInterlockManagement rdf:type owl:Class ;
    rdfs:subClassOf :LogicalComponent ;
    rdfs:label "Logical Component - Alcohol Interlock Management"@en ;
    rdfs:label "逻辑部件 - 酒精锁管理"@zh ;
    rdfs:comment "Responsible for managing alcohol interlock and outputting alcohol interlock start permission status"@en ;
    rdfs:comment "负责实现对酒精锁的管理，输出酒精锁启动允许状态"@zh .

# -----------------------------------------------------------------------------
# Power Mode State Machine
# -----------------------------------------------------------------------------

:PowerMode rdf:type owl:Class ;
    rdfs:label "Power Mode"@en ;
    rdfs:label "电源模式"@zh ;
    rdfs:comment "Vehicle power mode state"@en ;
    rdfs:comment "车辆电源模式状态"@zh .

:OffMode rdf:type owl:Class ;
    rdfs:subClassOf :PowerMode ;
    rdfs:label "Off Mode"@en ;
    rdfs:label "关闭模式"@zh ;
    rdfs:comment "Vehicle power off state (0x0)"@en ;
    rdfs:comment "车辆电源关闭状态 (0x0)"@zh .

:LocalOnMode rdf:type owl:Class ;
    rdfs:subClassOf :PowerMode ;
    rdfs:label "Local On Mode"@en ;
    rdfs:label "本地开启模式"@zh ;
    rdfs:comment "Vehicle locally powered on state (0x1)"@en ;
    rdfs:comment "车辆本地上电状态 (0x1)"@zh .

:RemoteOnMode rdf:type owl:Class ;
    rdfs:subClassOf :PowerMode ;
    rdfs:label "Remote On Mode"@en ;
    rdfs:label "远程开启模式"@zh ;
    rdfs:comment "Vehicle remotely powered on state (0x2)"@en ;
    rdfs:comment "车辆远程上电状态 (0x2)"@zh .

:ReservedPowerMode rdf:type owl:Class ;
    rdfs:subClassOf :PowerMode ;
    rdfs:label "Reserved Power Mode"@en ;
    rdfs:label "保留电源模式"@zh ;
    rdfs:comment "Reserved power mode value (0x3)"@en ;
    rdfs:comment "保留电源模式值 (0x3)"@zh .

:ConvenienceMode rdf:type owl:Class ;
    rdfs:subClassOf :PowerMode ;
    rdfs:label "Convenience Mode"@en ;
    rdfs:label "舒适模式"@zh ;
    rdfs:comment "Intermediate power state between Off and Local ON mode"@en ;
    rdfs:comment "介于关闭模式和本地开启模式之间的中间电源状态"@zh ;
    rdfs:comment "KL15 off / KLS on (KL15断开，KLS接通)"@en ;
    owl:disjointWith :OffMode, :LocalOnMode, :RemoteOnMode .

# -----------------------------------------------------------------------------
# Ready Enable State Machine
# -----------------------------------------------------------------------------

:ReadyEnable rdf:type owl:Class ;
    rdfs:label "Ready Enable State"@en ;
    rdfs:label "Ready使能状态"@zh ;
    rdfs:comment "Ready enable state for vehicle start authorization"@en ;
    rdfs:comment "车辆启动授权的Ready使能状态"@zh .

:DisableState rdf:type owl:Class ;
    rdfs:subClassOf :ReadyEnable ;
    rdfs:label "Disable State"@en ;
    rdfs:label "禁止状态"@zh ;
    rdfs:comment "Ready enable disabled (0x0)"@en ;
    rdfs:comment "Ready使能禁止 (0x0)"@zh .

:EnableState rdf:type owl:Class ;
    rdfs:subClassOf :ReadyEnable ;
    rdfs:label "Enable State"@en ;
    rdfs:label "使能状态"@zh ;
    rdfs:comment "Ready enable enabled (0x1)"@en ;
    rdfs:comment "Ready使能允许 (0x1)"@zh .

:ArmedState rdf:type owl:Class ;
    rdfs:subClassOf :ReadyEnable ;
    rdfs:label "Armed State"@en ;
    rdfs:label "预激活状态"@zh ;
    rdfs:comment "Ready enable armed state"@en ;
    rdfs:comment "Ready使能预激活状态"@zh .

# -----------------------------------------------------------------------------
# Key Types and Validation
# -----------------------------------------------------------------------------

:Key rdf:type owl:Class ;
    rdfs:label "Key"@en ;
    rdfs:label "钥匙"@zh ;
    rdfs:comment "Vehicle key entity"@en ;
    rdfs:comment "车辆钥匙实体"@zh .

:ValidKey rdf:type owl:Class ;
    rdfs:subClassOf :Key ;
    rdfs:label "Valid Key"@en ;
    rdfs:label "有效钥匙"@zh ;
    rdfs:comment "Valid key that can authorize vehicle operations"@en ;
    rdfs:comment "可以授权车辆操作的有效钥匙"@zh .

:BLEKey rdf:type owl:Class ;
    rdfs:subClassOf :Key ;
    rdfs:label "BLE Key"@en ;
    rdfs:label "蓝牙钥匙"@zh ;
    rdfs:comment "Bluetooth Low Energy based digital key"@en ;
    rdfs:comment "基于蓝牙低功耗的数字钥匙"@zh .

:RKEKey rdf:type owl:Class ;
    rdfs:subClassOf :Key ;
    rdfs:label "RKE Key"@en ;
    rdfs:label "遥控钥匙"@zh ;
    rdfs:comment "Remote Keyless Entry key"@en ;
    rdfs:comment "遥控无钥匙进入钥匙"@zh .

:NFCKey rdf:type owl:Class ;
    rdfs:subClassOf :Key ;
    rdfs:label "NFC Key"@en ;
    rdfs:label "NFC钥匙"@zh ;
    rdfs:comment "Near Field Communication based key"@en ;
    rdfs:comment "基于近场通信的钥匙"@zh .

:UWBKey rdf:type owl:Class ;
    rdfs:subClassOf :Key ;
    rdfs:label "UWB Key"@en ;
    rdfs:label "UWB钥匙"@zh ;
    rdfs:comment "Ultra-Wideband based key"@en ;
    rdfs:comment "基于超宽带的钥匙"@zh .

:DigitalKey rdf:type owl:Class ;
    rdfs:subClassOf :Key ;
    rdfs:label "Digital Key"@en ;
    rdfs:label "数字钥匙"@zh ;
    rdfs:comment "Generic digital key type"@en ;
    rdfs:comment "通用数字钥匙类型"@zh .

:PhysicalKey rdf:type owl:Class ;
    rdfs:subClassOf :Key ;
    rdfs:label "Physical Key"@en ;
    rdfs:label "物理钥匙"@zh ;
    rdfs:comment "Traditional physical key"@en ;
    rdfs:comment "传统物理钥匙"@zh .

:KeyLocation rdf:type owl:Class ;
    rdfs:label "Key Location"@en ;
    rdfs:label "钥匙位置"@zh ;
    rdfs:comment "Key position relative to vehicle"@en ;
    rdfs:comment "钥匙相对于车辆的位置"@zh .

:KeyNotSearched rdf:type owl:Class ;
    rdfs:subClassOf :KeyLocation ;
    rdfs:label "Key Not Searched"@en ;
    rdfs:label "未搜索钥匙"@zh .

:KeyInCar rdf:type owl:Class ;
    rdfs:subClassOf :KeyLocation ;
    rdfs:label "Key In Car"@en ;
    rdfs:label "钥匙在车内"@zh .

:KeyNearFLDoor rdf:type owl:Class ;
    rdfs:subClassOf :KeyLocation ;
    rdfs:label "Key Near Front Left Door"@en ;
    rdfs:label "钥匙在前左门附近"@zh .

:KeyInTrunk rdf:type owl:Class ;
    rdfs:subClassOf :KeyLocation ;
    rdfs:label "Key In Trunk"@en ;
    rdfs:label "钥匙在后备箱"@zh .

:KeyNearTrunk rdf:type owl:Class ;
    rdfs:subClassOf :KeyLocation ;
    rdfs:label "Key Near Trunk"@en ;
    rdfs:label "钥匙在后备箱附近"@zh .

:KeyNotFound rdf:type owl:Class ;
    rdfs:subClassOf :KeyLocation ;
    rdfs:label "Key Not Found"@en ;
    rdfs:label "未找到钥匙"@zh .

:KeyNearFRDoor rdf:type owl:Class ;
    rdfs:subClassOf :KeyLocation ;
    rdfs:label "Key Near Front Right Door"@en ;
    rdfs:label "钥匙在前右门附近"@zh .

:KeySearchResult rdf:type owl:Class ;
    rdfs:label "Key Search Result"@en ;
    rdfs:label "钥匙搜索结果"@zh ;
    rdfs:comment "Result of key search operation"@en ;
    rdfs:comment "钥匙搜索操作的结果"@zh .

:KeySearchNotFound rdf:type owl:Class ;
    rdfs:subClassOf :KeySearchResult ;
    rdfs:label "Key Search Not Found"@en ;
    rdfs:label "未找到钥匙"@zh .

:KeySearchInCar rdf:type owl:Class ;
    rdfs:subClassOf :KeySearchResult ;
    rdfs:label "Key Search In Car"@en ;
    rdfs:label "钥匙在车内"@zh .

:KeySearchNotInCar rdf:type owl:Class ;
    rdfs:subClassOf :KeySearchResult ;
    rdfs:label "Key Search Not In Car"@en ;
    rdfs:label "钥匙不在车内"@zh .

:KeySearchingState rdf:type owl:Class ;
    rdfs:label "Key Searching State"@en ;
    rdfs:label "搜钥匙状态"@zh ;
    rdfs:comment "Current state of key searching process"@en ;
    rdfs:comment "钥匙搜索过程的当前状态"@zh .

:NotSearching rdf:type owl:Class ;
    rdfs:subClassOf :KeySearchingState ;
    rdfs:label "Not Searching"@en ;
    rdfs:label "未搜索"@zh .

:InitialSearch rdf:type owl:Class ;
    rdfs:subClassOf :KeySearchingState ;
    rdfs:label "Initial Search"@en ;
    rdfs:label "初始搜索"@zh .

:TimeoutResearch rdf:type owl:Class ;
    rdfs:subClassOf :KeySearchingState ;
    rdfs:label "Timeout Research"@en ;
    rdfs:label "超时重新搜索"@zh .

:KeyValidityStatus rdf:type owl:Class ;
    rdfs:label "Key Validity Status"@en ;
    rdfs:label "钥匙有效性状态"@zh ;
    rdfs:comment "Validity status of a key"@en ;
    rdfs:comment "钥匙的有效性状态"@zh .

:KeyInvalid rdf:type owl:Class ;
    rdfs:subClassOf :KeyValidityStatus ;
    rdfs:label "Key Invalid"@en ;
    rdfs:label "钥匙无效"@zh .

:KeyValid rdf:type owl:Class ;
    rdfs:subClassOf :KeyValidityStatus ;
    rdfs:label "Key Valid"@en ;
    rdfs:label "钥匙有效"@zh .

# -----------------------------------------------------------------------------
# Door and Lock States
# -----------------------------------------------------------------------------

:Door rdf:type owl:Class ;
    rdfs:label "Door"@en ;
    rdfs:label "车门"@zh .

:DoorState rdf:type owl:Class ;
    rdfs:label "Door State"@en ;
    rdfs:label "车门状态"@zh ;
    rdfs:comment "Door open/close state"@en ;
    rdfs:comment "车门开关状态"@zh .

:DoorClosed rdf:type owl:Class ;
    rdfs:subClassOf :DoorState ;
    rdfs:label "Door Closed"@en ;
    rdfs:label "车门关闭"@zh .

:DoorOpen rdf:type owl:Class ;
    rdfs:subClassOf :DoorState ;
    rdfs:label "Door Open"@en ;
    rdfs:label "车门打开"@zh .

:DoorLockState rdf:type owl:Class ;
    rdfs:label "Door Lock State"@en ;
    rdfs:label "门锁状态"@zh ;
    rdfs:comment "Door lock/unlock state"@en ;
    rdfs:comment "车门锁止/解锁状态"@zh .

:DoorLocked rdf:type owl:Class ;
    rdfs:subClassOf :DoorLockState ;
    rdfs:label "Door Locked"@en ;
    rdfs:label "车门锁止"@zh .

:DoorUnlocked rdf:type owl:Class ;
    rdfs:subClassOf :DoorLockState ;
    rdfs:label "Door Unlocked"@en ;
    rdfs:label "车门解锁"@zh .

:DoorLockEvent rdf:type owl:Class ;
    rdfs:label "Door Lock Event"@en ;
    rdfs:label "门锁事件"@zh ;
    rdfs:comment "Door lock/unlock event"@en ;
    rdfs:comment "车门锁止/解锁事件"@zh .

:NoLockEvent rdf:type owl:Class ;
    rdfs:subClassOf :DoorLockEvent ;
    rdfs:label "No Lock Event"@en ;
    rdfs:label "无锁事件"@zh .

:LockEvent rdf:type owl:Class ;
    rdfs:subClassOf :DoorLockEvent ;
    rdfs:label "Lock Event"@en ;
    rdfs:label "锁止事件"@zh .

:UnlockEvent rdf:type owl:Class ;
    rdfs:subClassOf :DoorLockEvent ;
    rdfs:label "Unlock Event"@en ;
    rdfs:label "解锁事件"@zh .

:UnlockSource rdf:type owl:Class ;
    rdfs:label "Unlock Source"@en ;
    rdfs:label "解锁源"@zh ;
    rdfs:comment "Source of unlock command"@en ;
    rdfs:comment "解锁命令来源"@zh .

:LockSourceType rdf:type owl:Class ;
    rdfs:label "Lock Source Type"@en ;
    rdfs:label "闭锁源类型"@zh ;
    rdfs:comment "Type of lock command source"@en ;
    rdfs:comment "闭锁命令来源类型"@zh .

:TailGatePositionState rdf:type owl:Class ;
    rdfs:label "Tail Gate Position State"@en ;
    rdfs:label "尾门位置状态"@zh .

:TailGateUnknown rdf:type owl:Class ;
    rdfs:subClassOf :TailGatePositionState ;
    rdfs:label "Tail Gate Unknown"@en ;
    rdfs:label "尾门未知"@zh .

:TailGateFullClosed rdf:type owl:Class ;
    rdfs:subClassOf :TailGatePositionState ;
    rdfs:label "Tail Gate Full Closed"@en ;
    rdfs:label "尾门完全关闭"@zh .

:TailGateHalfClosed rdf:type owl:Class ;
    rdfs:subClassOf :TailGatePositionState ;
    rdfs:label "Tail Gate Half Closed"@en ;
    rdfs:label "尾门半关"@zh .

:TailGateOpened rdf:type owl:Class ;
    rdfs:subClassOf :TailGatePositionState ;
    rdfs:label "Tail Gate Opened"@en ;
    rdfs:label "尾门打开"@zh .

:TailGateFullOpened rdf:type owl:Class ;
    rdfs:subClassOf :TailGatePositionState ;
    rdfs:label "Tail Gate Full Opened"@en ;
    rdfs:label "尾门完全打开"@zh .

# -----------------------------------------------------------------------------
# Vehicle Mode
# -----------------------------------------------------------------------------

:VehicleMode rdf:type owl:Class ;
    rdfs:label "Vehicle Mode"@en ;
    rdfs:label "车辆模式"@zh ;
    rdfs:comment "Operating mode of the vehicle"@en ;
    rdfs:comment "车辆的运行模式"@zh .

:NormalMode rdf:type owl:Class ;
    rdfs:subClassOf :VehicleMode ;
    rdfs:label "Normal Mode"@en ;
    rdfs:label "正常模式"@zh .

:MaintenanceMode rdf:type owl:Class ;
    rdfs:subClassOf :VehicleMode ;
    rdfs:label "Maintenance Mode"@en ;
    rdfs:label "维护模式"@zh .

:ExhibitionMode rdf:type owl:Class ;
    rdfs:subClassOf :VehicleMode ;
    rdfs:label "Exhibition Mode"@en ;
    rdfs:label "展示模式"@zh .

:TransportationMode rdf:type owl:Class ;
    rdfs:subClassOf :VehicleMode ;
    rdfs:label "Transportation Mode"@en ;
    rdfs:label "运输模式"@zh .

:FactoryMode rdf:type owl:Class ;
    rdfs:subClassOf :VehicleMode ;
    rdfs:label "Factory Mode"@en ;
    rdfs:label "工厂模式"@zh .

:ProductionMode rdf:type owl:Class ;
    rdfs:subClassOf :VehicleMode ;
    rdfs:label "Production Mode"@en ;
    rdfs:label "生产模式"@zh .

:TrialDriveMode rdf:type owl:Class ;
    rdfs:subClassOf :VehicleMode ;
    rdfs:label "Trial Drive Mode"@en ;
    rdfs:label "试驾模式"@zh .

:InvalidVehicleMode rdf:type owl:Class ;
    rdfs:subClassOf :VehicleMode ;
    rdfs:label "Invalid Vehicle Mode"@en ;
    rdfs:label "无效车辆模式"@zh .

# -----------------------------------------------------------------------------
# Diagnostic States
# -----------------------------------------------------------------------------

:DiagnosticState rdf:type owl:Class ;
    rdfs:label "Diagnostic State"@en ;
    rdfs:label "诊断状态"@zh ;
    rdfs:comment "Current diagnostic state of the gateway"@en ;
    rdfs:comment "网关当前的诊断状态"@zh .

:NoDiagnostics rdf:type owl:Class ;
    rdfs:subClassOf :DiagnosticState ;
    rdfs:label "No Diagnostics"@en ;
    rdfs:label "无诊断"@zh .

:OBDCan rdf:type owl:Class ;
    rdfs:subClassOf :DiagnosticState ;
    rdfs:label "OBD-CAN"@en ;
    rdfs:label "OBD-CAN诊断"@zh .

:OBDEthernet rdf:type owl:Class ;
    rdfs:subClassOf :DiagnosticState ;
    rdfs:label "OBD-Ethernet"@en ;
    rdfs:label "OBD-Ethernet诊断"@zh .

:T1Diag rdf:type owl:Class ;
    rdfs:subClassOf :DiagnosticState ;
    rdfs:label "T1 Diagnostics"@en ;
    rdfs:label "T1诊断"@zh .

:SilentOTA rdf:type owl:Class ;
    rdfs:subClassOf :DiagnosticState ;
    rdfs:label "Silent OTA"@en ;
    rdfs:label "静默OTA"@zh .

:NormalOTA rdf:type owl:Class ;
    rdfs:subClassOf :DiagnosticState ;
    rdfs:label "Normal OTA"@en ;
    rdfs:label "普通OTA"@zh .

:RemoteDiag rdf:type owl:Class ;
