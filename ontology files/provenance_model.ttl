@prefix : <http://example.org/vehicle-power-management/provenance#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/vehicle-power-management/provenance> rdf:type owl:Ontology ;
    rdfs:label "Vehicle Power Management Provenance Model"@en ;
    rdfs:label "车辆电源管理溯源模型"@zh ;
    rdfs:comment "Provenance model aligned with PROV-O for tracking ontology generation sources and credibility"@en ;
    rdfs:comment "基于PROV-O的溯源模型，用于追踪本体生成来源和可信度"@zh ;
    owl:versionInfo "1.0" ;
    owl:imports <http://www.w3.org/ns/prov-o#> ;
    owl:imports <http://example.org/vehicle-power-management/core> .

# =============================================================================
# PROVENANCE CLASSES
# =============================================================================

# --- Entity Classes (prov:Entity subclasses) ---

:OntologyProvenance rdf:type owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Ontology Provenance"@en ;
    rdfs:label "本体溯源"@zh ;
    rdfs:comment "Records provenance information for ontology elements"@en ;
    rdfs:comment "记录本体元素的溯源信息"@zh .

:SourceDocument rdf:type owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Source Document"@en ;
    rdfs:label "来源文档"@zh ;
    rdfs:comment "Original source document used for ontology generation"@en ;
    rdfs:comment "用于本体生成的原始来源文档"@zh .

:PolarionDocument rdf:type owl:Class ;
    rdfs:subClassOf :SourceDocument ;
    rdfs:label "Polarion Document"@en ;
    rdfs:label "Polarion文档"@zh ;
    rdfs:comment "Document fetched from Polarion REST API"@en ;
    rdfs:comment "从Polarion REST API获取的文档"@zh .

:LocalDocument rdf:type owl:Class ;
    rdfs:subClassOf :SourceDocument ;
    rdfs:label "Local Document"@en ;
    rdfs:label "本地文档"@zh ;
    rdfs:comment "Document from local file system (PDF, DOCX, YAML, MD)"@en ;
    rdfs:comment "本地文件系统中的文档（PDF, DOCX, YAML, MD）"@zh .

# --- Activity Classes (prov:Activity subclasses) ---

:GenerationActivity rdf:type owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Generation Activity"@en ;
    rdfs:label "生成活动"@zh ;
    rdfs:comment "Activity that generates ontology content from sources"@en ;
    rdfs:comment "从来源生成本体内容的活动"@zh .

:OntologyExtraction rdf:type owl:Class ;
    rdfs:subClassOf :GenerationActivity ;
    rdfs:label "Ontology Extraction"@en ;
    rdfs:label "本体抽取"@zh ;
    rdfs:comment "Activity of extracting concepts from source documents"@en ;
    rdfs:comment "从来源文档中抽取概念的活动"@zh .

:OntologyValidation rdf:type owl:Class ;
    rdfs:subClassOf :GenerationActivity ;
    rdfs:label "Ontology Validation"@en ;
    rdfs:label "本体验证"@zh ;
    rdfs:comment "Activity of validating ontology against requirements"@en ;
    rdfs:comment "根据需求验证本体的活动"@zh .

# --- Agent Classes (prov:Agent subclasses) ---

:GeneratorAgent rdf:type owl:Class ;
    rdfs:subClassOf prov:Agent ;
    rdfs:label "Generator Agent"@en ;
    rdfs:label "生成代理"@zh ;
    rdfs:comment "AI agent or tool that generates ontology content"@en ;
    rdfs:comment "生成本体内容的AI代理或工具"@zh .

:AIModel rdf:type owl:Class ;
    rdfs:subClassOf :GeneratorAgent ;
    rdfs:label "AI Model"@en ;
    rdfs:label "AI模型"@zh ;
    rdfs:comment "Large language model used for ontology generation"@en ;
    rdfs:comment "用于本体生成的大语言模型"@zh .

:HumanExpert rdf:type owl:Class ;
    rdfs:subClassOf :GeneratorAgent ;
    rdfs:label "Human Expert"@en ;
    rdfs:label "人类专家"@zh ;
    rdfs:comment "Domain expert who validates or contributes to ontology"@en ;
    rdfs:comment "验证或贡献本体的领域专家"@zh .

# --- Verification Status Class ---

:VerificationStatus rdf:type owl:Class ;
    rdfs:label "Verification Status"@en ;
    rdfs:label "验证状态"@zh ;
    rdfs:comment "Enumeration of verification states for provenance records"@en ;
    rdfs:comment "溯源记录验证状态的枚举"@zh ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:oneOf (:VERIFIED :PENDING :DEPRECATED)
    ] .

# =============================================================================
# OBJECT PROPERTIES
# =============================================================================

# --- PROV-O Aligned Properties ---

:wasGeneratedBy rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasGeneratedBy ;
    rdfs:domain :OntologyProvenance ;
    rdfs:range :GenerationActivity ;
    rdfs:label "was generated by"@en ;
    rdfs:label "由...生成"@zh ;
    rdfs:comment "Links provenance record to the generation activity"@en ;
    rdfs:comment "将溯源记录链接到生成活动"@zh .

:wasDerivedFrom rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    rdfs:domain :OntologyProvenance ;
    rdfs:range :SourceDocument ;
    rdfs:label "was derived from"@en ;
    rdfs:label "派生自"@zh ;
    rdfs:comment "Links provenance to the source document"@en ;
    rdfs:comment "将溯源链接到来源文档"@zh .

:wasAttributedTo rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasAttributedTo ;
    rdfs:domain :OntologyProvenance ;
    rdfs:range :GeneratorAgent ;
    rdfs:label "was attributed to"@en ;
    rdfs:label "归因于"@zh ;
    rdfs:comment "Links provenance to the agent responsible"@en ;
    rdfs:comment "将溯源链接到负责的代理"@zh .

:wasAssociatedWith rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasAssociatedWith ;
    rdfs:domain :GenerationActivity ;
    rdfs:range :GeneratorAgent ;
    rdfs:label "was associated with"@en ;
    rdfs:label "关联于"@zh ;
    rdfs:comment "Links activity to the agent that performed it"@en ;
    rdfs:comment "将活动链接到执行该活动的代理"@zh .

:used rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf prov:used ;
    rdfs:domain :GenerationActivity ;
    rdfs:range :SourceDocument ;
    rdfs:label "used"@en ;
    rdfs:label "使用"@zh ;
    rdfs:comment "Links activity to the source documents it used"@en ;
    rdfs:comment "将活动链接到其使用的来源文档"@zh .

# --- Custom Properties ---

:hasSource rdf:type owl:ObjectProperty ;
    rdfs:domain :OntologyProvenance ;
    rdfs:range :SourceDocument ;
    rdfs:label "has source"@en ;
    rdfs:label "具有来源"@zh ;
    rdfs:comment "Direct link to source document for an ontology element"@en ;
    rdfs:comment "本体元素到来源文档的直接链接"@zh .

:hasGenerator rdf:type owl:ObjectProperty ;
    rdfs:domain :OntologyProvenance ;
    rdfs:range :GeneratorAgent ;
    rdfs:label "has generator"@en ;
    rdfs:label "具有生成器"@zh ;
    rdfs:comment "Links to the agent that generated this ontology"@en ;
    rdfs:comment "链接到生成此本体的代理"@zh .

:hasVerificationStatus rdf:type owl:ObjectProperty ;
    rdfs:domain :OntologyProvenance ;
    rdfs:range :VerificationStatus ;
    rdfs:label "has verification status"@en ;
    rdfs:label "具有验证状态"@zh ;
    rdfs:comment "Current verification status of the provenance record"@en ;
    rdfs:comment "溯源记录的当前验证状态"@zh .

:validatedBy rdf:type owl:ObjectProperty ;
    rdfs:domain :OntologyProvenance ;
    rdfs:range :HumanExpert ;
    rdfs:label "validated by"@en ;
    rdfs:label "由...验证"@zh ;
    rdfs:comment "Links to human expert who validated the content"@en ;
    rdfs:comment "链接到验证内容的人类专家"@zh .

# =============================================================================
# DATA PROPERTIES
# =============================================================================

# --- PROV-O Aligned Properties ---

:generatedAtTime rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf prov:generatedAtTime ;
    rdfs:domain :OntologyProvenance ;
    rdfs:range xsd:dateTime ;
    rdfs:label "generated at time"@en ;
    rdfs:label "生成时间"@zh ;
    rdfs:comment "Timestamp when the ontology was generated"@en ;
    rdfs:comment "本体生成的时间戳"@zh .

:startedAtTime rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf prov:startedAtTime ;
    rdfs:domain :GenerationActivity ;
    rdfs:range xsd:dateTime ;
    rdfs:label "started at time"@en ;
    rdfs:label "开始时间"@zh ;
    rdfs:comment "Timestamp when the activity started"@en ;
    rdfs:comment "活动开始的时间戳"@zh .

:endedAtTime rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf prov:endedAtTime ;
    rdfs:domain :GenerationActivity ;
    rdfs:range xsd:dateTime ;
    rdfs:label "ended at time"@en ;
    rdfs:label "结束时间"@zh ;
    rdfs:comment "Timestamp when the activity ended"@en ;
    rdfs:comment "活动结束的时间戳"@zh .

# --- Custom Properties ---

:hasCredibilityScore rdf:type owl:DatatypeProperty ;
    rdfs:domain :OntologyProvenance ;
    rdfs:range xsd:float ;
    rdfs:label "has credibility score"@en ;
    rdfs:label "具有可信度分数"@zh ;
    rdfs:comment "Credibility score between 0 and 1 (1 being most credible)"@en ;
    rdfs:comment "可信度分数，范围0到1（1为最可信）"@zh .

:hasSourceUri rdf:type owl:DatatypeProperty ;
    rdfs:domain :SourceDocument ;
    rdfs:range xsd:anyURI ;
    rdfs:label "has source URI"@en ;
    rdfs:label "具有来源URI"@zh ;
    rdfs:comment "URI or file path of the source document"@en ;
    rdfs:comment "来源文档的URI或文件路径"@zh .

:hasSourceTitle rdf:type owl:DatatypeProperty ;
    rdfs:domain :SourceDocument ;
    rdfs:range xsd:string ;
    rdfs:label "has source title"@en ;
    rdfs:label "具有来源标题"@zh ;
    rdfs:comment "Title or name of the source document"@en ;
    rdfs:comment "来源文档的标题或名称"@zh .

:hasSourceFormat rdf:type owl:DatatypeProperty ;
    rdfs:domain :SourceDocument ;
    rdfs:range xsd:string ;
    rdfs:label "has source format"@en ;
    rdfs:label "具有来源格式"@zh ;
    rdfs:comment "Format of the source document (PDF, DOCX, YAML, MD, HTML)"@en ;
    rdfs:comment "来源文档的格式（PDF, DOCX, YAML, MD, HTML）"@zh .

:hasModelName rdf:type owl:DatatypeProperty ;
    rdfs:domain :AIModel ;
    rdfs:range xsd:string ;
    rdfs:label "has model name"@en ;
    rdfs:label "具有模型名称"@zh ;
    rdfs:comment "Name of the AI model used for generation"@en ;
    rdfs:comment "用于生成的AI模型名称"@zh .

:hasModelVersion rdf:type owl:DatatypeProperty ;
    rdfs:domain :AIModel ;
    rdfs:range xsd:string ;
    rdfs:label "has model version"@en ;
    rdfs:label "具有模型版本"@zh ;
    rdfs:comment "Version of the AI model"@en ;
    rdfs:comment "AI模型的版本"@zh .

:hasConfidenceLevel rdf:type owl:DatatypeProperty ;
    rdfs:domain :OntologyProvenance ;
    rdfs:range xsd:float ;
    rdfs:label "has confidence level"@en ;
    rdfs:label "具有置信度"@zh ;
    rdfs:comment "Confidence level of the extraction (0-1)"@en ;
    rdfs:comment "抽取的置信度（0-1）"@zh .

:hasExtractionNotes rdf:type owl:DatatypeProperty ;
    rdfs:domain :OntologyProvenance ;
    rdfs:range xsd:string ;
    rdfs:label "has extraction notes"@en ;
    rdfs:label "具有抽取备注"@zh ;
    rdfs:comment "Additional notes about the extraction process"@en ;
    rdfs:comment "关于抽取过程的附加备注"@zh .

:hasOntologyElementId rdf:type owl:DatatypeProperty ;
    rdfs:domain :OntologyProvenance ;
    rdfs:range xsd:string ;
    rdfs:label "has ontology element ID"@en ;
    rdfs:label "具有本体元素ID"@zh ;
    rdfs:comment "ID of the ontology element this provenance tracks"@en ;
    rdfs:comment "此溯源追踪的本体元素的ID"@zh .

# =============================================================================
# INDIVIDUALS - Verification Status Values
# =============================================================================

:VERIFIED rdf:type :VerificationStatus ;
    rdfs:label "Verified"@en ;
    rdfs:label "已验证"@zh ;
    rdfs:comment "Content has been verified by domain expert"@en ;
    rdfs:comment "内容已由领域专家验证"@zh .

:PENDING rdf:type :VerificationStatus ;
    rdfs:label "Pending"@en ;
    rdfs:label "待验证"@zh ;
    rdfs:comment "Content is awaiting verification"@en ;
    rdfs:comment "内容等待验证中"@zh .

:DEPRECATED rdf:type :VerificationStatus ;
    rdfs:label "Deprecated"@en ;
    rdfs:label "已废弃"@zh ;
    rdfs:comment "Content is deprecated and should not be used"@en ;
    rdfs:comment "内容已废弃，不应使用"@zh .

# =============================================================================
# INDIVIDUALS - Example Source Documents
# =============================================================================

:polarionDocument_VehiclePowerManagement rdf:type :PolarionDocument ;
    rdfs:label "Vehicle Power Management Specification"@en ;
    rdfs:label "车辆电源管理规范"@zh ;
    :hasSourceUri "/projects/VEEA/spaces/3_SSTS_EEA/documents/Xi%20Tong%20She%20Ji%20Fang%20An%20Shu%20_Che%20Liang%20Dian%20Yuan%20Mo%20Shi%20Guan%20Li" ;
    :hasSourceTitle "Vehicle Power Mode Management System Design Document"@en ;
    :hasSourceTitle "车辆电源模式管理系统设计文档"@zh ;
    :hasSourceFormat "HTML" ;
    rdfs:comment "Source document from Polarion REST API containing power management specifications"@en ;
    rdfs:comment "来自Polarion REST API的电源管理规范来源文档"@zh .

:markdownDesignDoc rdf:type :LocalDocument ;
    rdfs:label "Power Management Design Document"@en ;
    rdfs:label "电源管理设计文档"@zh ;
    :hasSourceUri "file:///docs/power_management_design.md" ;
    :hasSourceTitle "Vehicle Power Mode Management Design"@en ;
    :hasSourceTitle "车辆电源模式管理设计"@zh ;
    :hasSourceFormat "MD" ;
    rdfs:comment "Local markdown design document for power management"@en ;
    rdfs:comment "本地的电源管理Markdown设计文档"@zh .

:pdfSpecDocument rdf:type :LocalDocument ;
    rdfs:label "Battery Specification PDF"@en ;
    rdfs:label "电池规范PDF"@zh ;
    :hasSourceUri "file:///specs/battery_spec_v2.1.pdf" ;
    :hasSourceTitle "High Voltage Battery Pack Specification v2.1"@en ;
    :hasSourceTitle "高压电池包规范 v2.1"@zh ;
    :hasSourceFormat "PDF" ;
    rdfs:comment "Technical specification document for battery system"@en ;
    rdfs:comment "电池系统的技术规范文档"@zh .

# =============================================================================
# INDIVIDUALS - Example Generator Agents
# =============================================================================

:sisyphusAgent rdf:type :AIModel ;
    rdfs:label "Sisyphus Agent"@en ;
    rdfs:label "Sisyphus代理"@zh ;
    :hasModelName "GLM-5-FP8" ;
    :hasModelVersion "2024.01" ;
    rdfs:comment "AI agent from OhMyOpenCode for ontology generation"@en ;
    rdfs:comment "来自OhMyOpenCode的用于本体生成的AI代理"@zh .

:ontologyExtractor rdf:type :AIModel ;
    rdfs:label "Ontology Extractor"@en ;
    rdfs:label "本体抽取器"@zh ;
    :hasModelName "GPT-4" ;
    :hasModelVersion "turbo-2024" ;
    rdfs:comment "AI model specialized in ontology concept extraction"@en ;
    rdfs:comment "专门用于本体概念抽取的AI模型"@zh .

:domainExpert_Zhang rdf:type :HumanExpert ;
    rdfs:label "Dr. Zhang Wei"@en ;
    rdfs:label "张伟博士"@zh ;
    rdfs:comment "Domain expert for vehicle power management systems"@en ;
    rdfs:comment "车辆电源管理系统领域专家"@zh .

# =============================================================================
# INDIVIDUALS - Example Generation Activities
# =============================================================================

:extractionActivity_20240315 rdf:type :OntologyExtraction ;
    rdfs:label "Power Management Ontology Extraction 2024-03-15"@en ;
    rdfs:label "电源管理本体抽取 2024-03-15"@zh ;
    :startedAtTime "2024-03-15T09:00:00Z"^^xsd:dateTime ;
    :endedAtTime "2024-03-15T10:30:00Z"^^xsd:dateTime ;
    :wasAssociatedWith :sisyphusAgent ;
    :used :polarionDocument_VehiclePowerManagement ;
    :used :markdownDesignDoc ;
    rdfs:comment "Extraction activity that generated the initial ontology structure"@en ;
    rdfs:comment "生成初始本体结构的抽取活动"@zh .

:validationActivity_20240316 rdf:type :OntologyValidation ;
    rdfs:label "Ontology Validation 2024-03-16"@en ;
    rdfs:label "本体验证 2024-03-16"@zh ;
    :startedAtTime "2024-03-16T14:00:00Z"^^xsd:dateTime ;
    :endedAtTime "2024-03-16T16:00:00Z"^^xsd:dateTime ;
    :wasAssociatedWith :domainExpert_Zhang ;
    rdfs:comment "Validation activity by domain expert"@en ;
    rdfs:comment "领域专家的验证活动"@zh .

# =============================================================================
# INDIVIDUALS - Example Provenance Records
# =============================================================================

:provenance_BatteryPack rdf:type :OntologyProvenance ;
    rdfs:label "Provenance for BatteryPack Class"@en ;
    rdfs:label "BatteryPack类的溯源"@zh ;
    :hasOntologyElementId "BatteryPack" ;
    :wasGeneratedBy :extractionActivity_20240315 ;
    :wasDerivedFrom :polarionDocument_VehiclePowerManagement ;
    :wasAttributedTo :sisyphusAgent ;
    :hasSource :polarionDocument_VehiclePowerManagement ;
    :hasGenerator :sisyphusAgent ;
    :generatedAtTime "2024-03-15T09:15:00Z"^^xsd:dateTime ;
    :hasCredibilityScore "0.95"^^xsd:float ;
    :hasConfidenceLevel "0.92"^^xsd:float ;
    :hasVerificationStatus :VERIFIED ;
    :validatedBy :domainExpert_Zhang ;
    :hasExtractionNotes "Extracted from section 3.2.1 of the Polarion document with high confidence"@en ;
    :hasExtractionNotes "从Polarion文档3.2.1节抽取，置信度高"@zh .

:provenance_PowerMode rdf:type :OntologyProvenance ;
    rdfs:label "Provenance for PowerMode Class"@en ;
    rdfs:label "PowerMode类的溯源"@zh ;
    :hasOntologyElementId "PowerMode" ;
    :wasGeneratedBy :extractionActivity_20240315 ;
    :wasDerivedFrom :polarionDocument_VehiclePowerManagement ;
    :wasDerivedFrom :markdownDesignDoc ;
    :wasAttributedTo :sisyphusAgent ;
    :hasSource :polarionDocument_VehiclePowerManagement ;
    :hasGenerator :sisyphusAgent ;
    :generatedAtTime "2024-03-15T09:45:00Z"^^xsd:dateTime ;
    :hasCredibilityScore "0.98"^^xsd:float ;
    :hasConfidenceLevel "0.95"^^xsd:float ;
    :hasVerificationStatus :VERIFIED ;
    :validatedBy :domainExpert_Zhang ;
    :hasExtractionNotes "Core concept extracted from multiple sources with consistent definition"@en ;
    :hasExtractionNotes "核心概念从多个来源抽取，定义一致"@zh .

:provenance_hasPowerMode rdf:type :OntologyProvenance ;
    rdfs:label "Provenance for hasPowerMode Property"@en ;
    rdfs:label "hasPowerMode属性的溯源"@zh ;
    :hasOntologyElementId "hasPowerMode" ;
    :wasGeneratedBy :extractionActivity_20240315 ;
    :wasDerivedFrom :polarionDocument_VehiclePowerManagement ;
    :wasAttributedTo :sisyphusAgent ;
    :hasSource :polarionDocument_VehiclePowerManagement ;
    :hasGenerator :sisyphusAgent ;
    :generatedAtTime "2024-03-15T10:00:00Z"^^xsd:dateTime ;
    :hasCredibilityScore "0.90"^^xsd:float ;
    :hasConfidenceLevel "0.88"^^xsd:float ;
    :hasVerificationStatus :PENDING ;
    :hasExtractionNotes "Object property linking Vehicle to PowerMode, awaiting validation"@en ;
    :hasExtractionNotes "连接Vehicle和PowerMode的对象属性，等待验证"@zh .

:provenance_DiagnosticRule rdf:type :OntologyProvenance ;
    rdfs:label "Provenance for DiagnosticRule Class"@en ;
    rdfs:label "DiagnosticRule类的溯源"@zh ;
    :hasOntologyElementId "DiagnosticRule" ;
    :wasGeneratedBy :extractionActivity_20240315 ;
    :wasDerivedFrom :pdfSpecDocument ;
    :wasAttributedTo :sisyphusAgent ;
    :hasSource :pdfSpecDocument ;
    :hasGenerator :sisyphusAgent ;
    :generatedAtTime "2024-03-15T10:15:00Z"^^xsd:dateTime ;
    :hasCredibilityScore "0.85"^^xsd:float ;
    :hasConfidenceLevel "0.80"^^xsd:float ;
    :hasVerificationStatus :PENDING ;
    :hasExtractionNotes "Extracted from PDF specification, requires further validation"@en ;
    :hasExtractionNotes "从PDF规范抽取，需要进一步验证"@zh .

# =============================================================================
# ANNOTATION PROPERTIES (for linking to main ontology)
# =============================================================================

:hasProvenance rdf:type owl:AnnotationProperty ;
    rdfs:domain owl:Class ;
    rdfs:range :OntologyProvenance ;
    rdfs:label "has provenance"@en ;
    rdfs:label "具有溯源"@zh ;
    rdfs:comment "Annotation property to link ontology elements to their provenance records"@en ;
    rdfs:comment "用于将本体元素链接到其溯源记录的注释属性"@zh .

:sourceDocument rdf:type owl:AnnotationProperty ;
    rdfs:subPropertyOf rdfs:seeAlso ;
    rdfs:domain owl:Class ;
    rdfs:range xsd:anyURI ;
    rdfs:label "source document"@en ;
    rdfs:label "来源文档"@zh ;
    rdfs:comment "Annotation pointing to the source document for an ontology element"@en ;
    rdfs:comment "指向本体元素来源文档的注释"@zh .

:extractionDate rdf:type owl:AnnotationProperty ;
    rdfs:subPropertyOf dcterms:date ;
    rdfs:domain owl:Class ;
    rdfs:range xsd:dateTime ;
    rdfs:label "extraction date"@en ;
    rdfs:label "抽取日期"@zh ;
    rdfs:comment "Date when the ontology element was extracted/generated"@en ;
    rdfs:comment "本体元素被抽取/生成的日期"@zh .

# =============================================================================
# CONSTRAINTS
# =============================================================================

# Credibility score must be between 0 and 1
:hasCredibilityScore rdfs:range [
    rdf:type rdfs:Datatype ;
    owl:onDatatype xsd:float ;
    owl:withRestrictions (
        [ xsd:minInclusive "0.0"^^xsd:float ]
        [ xsd:maxInclusive "1.0"^^xsd:float ]
    )
] .

# Confidence level must be between 0 and 1
:hasConfidenceLevel rdfs:range [
    rdf:type rdfs:Datatype ;
    owl:onDatatype xsd:float ;
    owl:withRestrictions (
        [ xsd:minInclusive "0.0"^^xsd:float ]
        [ xsd:maxInclusive "1.0"^^xsd:float ]
    )
] .

# =============================================================================
# USAGE EXAMPLE (Comment block for documentation)
# =============================================================================
# 
# To use this provenance model in your main ontology:
#
# @prefix prov-model: <http://example.org/vehicle-power-management/provenance#> .
#
# :BatteryPack rdf:type owl:Class ;
#     rdfs:label "Battery Pack"@en ;
#     prov-model:hasProvenance prov-model:provenance_BatteryPack ;
#     prov-model:sourceDocument "/projects/VEEA/..." ;
#     prov-model:extractionDate "2024-03-15T09:15:00Z"^^xsd:dateTime .
