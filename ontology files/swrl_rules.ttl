                swrl:argument1 :vehicle ;
                swrl:argument2 "1"^^xsd:integer ] ;
            rdf:rest rdf:nil ] ] .

# -----------------------------------------------------------------------------
# T_3_2: Local On → Convenience
# -----------------------------------------------------------------------------
# IF: Vehicle in LocalOnMode AND StartButtonShortPress
# THEN: transitionsTo ConvenienceMode

:ruleT_3_2 rdf:type swrl:Imp ;
    rdfs:label "T_3_2: Local On to Convenience via Short Press"@en ;
    rdfs:label "T_3_2: 短按启动按钮从Local On到Convenience"@zh ;
    rdfs:comment "Transition from Local On mode to Convenience mode on start button short press"@en ;
    rdfs:comment "短按启动按钮触发从Local On模式跳转到Convenience模式"@zh ;
