# -----------------------------------------------------------------------------
# T_4_3: Remote On → Local On
# -----------------------------------------------------------------------------
# IF: Vehicle in RemoteOnMode AND (StartButtonPressed OR BrakePressedWithStartButton)
# THEN: transitionsTo LocalOnMode

:ruleT_4_3_StartButton rdf:type swrl:Imp ;
    rdfs:label "T_4_3: Remote On to Local On via Start Button"@en ;
    rdfs:label "T_4_3: 按启动按钮从Remote On到Local On"@zh ;
    rdfs:comment "Transition from Remote On mode to Local On mode on start button press"@en ;
    rdfs:comment "按下启动按钮触发从Remote On模式跳转到Local On模式"@zh ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :Vehicle ;
            swrl:argument1 :vehicle ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerMode ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "2"^^xsd:integer ] ;
            rdf:rest [ rdf:type swrl:AtomList ;
                rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                    swrl:propertyPredicate :StartButtonPressed ;
                    swrl:argument1 :vehicle ;
                    swrl:argument2 "true"^^xsd:boolean ] ;
                rdf:rest rdf:nil ] ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
            swrl:propertyPredicate :LDCU_PowerMode ;
            swrl:argument1 :vehicle ;
            swrl:argument2 "1"^^xsd:integer ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerONSource ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "1"^^xsd:integer ] ;
            rdf:rest rdf:nil ] ] .

:ruleT_4_3_BrakeWithButton rdf:type swrl:Imp ;
    rdfs:label "T_4_3: Remote On to Local On via Brake with Start Button"@en ;
    rdfs:label "T_4_3: 踩刹车按启动按钮从Remote On到Local On"@zh ;
    rdfs:comment "Transition from Remote On mode to Local On mode on brake press with start button"@en ;
    rdfs:comment "踩刹车并按启动按钮触发从Remote On模式跳转到Local On模式"@zh ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :Vehicle ;
            swrl:argument1 :vehicle ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerMode ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "2"^^xsd:integer ] ;
            rdf:rest [ rdf:type swrl:AtomList ;
                rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                    swrl:propertyPredicate :BrakePressedWithStartButton ;
                    swrl:argument1 :vehicle ;
                    swrl:argument2 "true"^^xsd:boolean ] ;
                rdf:rest rdf:nil ] ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
            swrl:propertyPredicate :LDCU_PowerMode ;
            swrl:argument1 :vehicle ;
            swrl:argument2 "1"^^xsd:integer ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerONSource ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "2"^^xsd:integer ] ;
            rdf:rest rdf:nil ] ] .

# =============================================================================
# SECTION 2: KEY VALIDATION RULES
# =============================================================================

# -----------------------------------------------------------------------------
# Rule: Key in vehicle + valid signal → KeyValid
# -----------------------------------------------------------------------------

:ruleKeyValidation_InCar rdf:type swrl:Imp ;
    rdfs:label "Key Validation: Key In Car"@en ;
    rdfs:label "钥匙验证：钥匙在车内"@zh ;
    rdfs:comment "Key is valid when located in vehicle and authentication passed"@en ;
    rdfs:comment "钥匙位于车内且认证通过时为有效钥匙"@zh ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :Vehicle ;
            swrl:argument1 :vehicle ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:ObjectPropertyAtom ;
                swrl:propertyPredicate :hasKey ;
                swrl:argument1 :vehicle ;
                swrl:argument2 :key ] ;
            rdf:rest [ rdf:type swrl:AtomList ;
                rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                    swrl:propertyPredicate :KeyLocation ;
                    swrl:argument1 :key ;
                    swrl:argument2 "1"^^xsd:integer ] ;
                rdf:rest [ rdf:type swrl:AtomList ;
                    rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                        swrl:propertyPredicate :BLEKeyValidSt ;
                        swrl:argument1 :vehicle ;
                        swrl:argument2 "1"^^xsd:integer ] ;
                    rdf:rest rdf:nil ] ] ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
            swrl:propertyPredicate :KeyValidSt ;
            swrl:argument1 :vehicle ;
            swrl:argument2 "1"^^xsd:integer ] ;
        rdf:rest rdf:nil ] .

:ruleKeyValidation_RKE rdf:type swrl:Imp ;
    rdfs:label "Key Validation: RKE Key Valid"@en ;
    rdfs:label "钥匙验证：RKE钥匙有效"@zh ;
    rdfs:comment "RKE key validation when valid signal received"@en ;
    rdfs:comment "当接收到有效信号时RKE钥匙验证通过"@zh ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :Vehicle ;
            swrl:argument1 :vehicle ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :RKEKeyValidSt ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "1"^^xsd:integer ] ;
            rdf:rest [ rdf:type swrl:AtomList ;
                rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                    swrl:propertyPredicate :KeyLocation ;
                    swrl:argument1 :vehicle ;
                    swrl:argument2 "1"^^xsd:integer ] ;
                rdf:rest rdf:nil ] ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
            swrl:propertyPredicate :KeyValidSt ;
            swrl:argument1 :vehicle ;
            swrl:argument2 "1"^^xsd:integer ] ;
        rdf:rest rdf:nil ] .

# -----------------------------------------------------------------------------
# Rule: Key out of vehicle → KeyInvalid
# -----------------------------------------------------------------------------

:ruleKeyValidation_OutOfCar rdf:type swrl:Imp ;
    rdfs:label "Key Validation: Key Out of Car"@en ;
    rdfs:label "钥匙验证：钥匙不在车内"@zh ;
    rdfs:comment "Key is invalid when located outside vehicle and no valid authentication"@en ;
    rdfs:comment "钥匙位于车外且无有效认证时为无效钥匙"@zh ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :Vehicle ;
            swrl:argument1 :vehicle ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :KeyLocation ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "5"^^xsd:integer ] ;
            rdf:rest rdf:nil ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
            swrl:propertyPredicate :KeyValidSt ;
            swrl:argument1 :vehicle ;
            swrl:argument2 "0"^^xsd:integer ] ;
        rdf:rest rdf:nil ] .

:ruleKeyValidation_Timeout rdf:type swrl:Imp ;
    rdfs:label "Key Validation: Search Timeout"@en ;
    rdfs:label "钥匙验证：搜索超时"@zh ;
    rdfs:comment "Key is invalid when search timeout occurs (tKeySearch expired)"@en ;
    rdfs:comment "钥匙搜索超时（tKeySearch到期）时钥匙为无效"@zh ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :Vehicle ;
            swrl:argument1 :vehicle ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :KeySearchTimeout ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "true"^^xsd:boolean ] ;
            rdf:rest rdf:nil ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
            swrl:propertyPredicate :KeyValidSt ;
            swrl:argument1 :vehicle ;
            swrl:argument2 "0"^^xsd:integer ] ;
        rdf:rest rdf:nil ] .

# =============================================================================
# SECTION 3: AUTO POWER OFF RULES
# =============================================================================

# -----------------------------------------------------------------------------
# Rule: LocalOnMode + timeout (tKeySearch expired) → PowerOff
# -----------------------------------------------------------------------------

:ruleAutoPowerOff_KeySearchExpired rdf:type swrl:Imp ;
    rdfs:label "Auto Power Off: Key Search Expired in Local On"@en ;
    rdfs:label "自动下电：Local On模式下钥匙搜索超时"@zh ;
    rdfs:comment "Auto power off when key search timer expires in Local On mode"@en ;
    rdfs:comment "Local On模式下钥匙搜索计时器到期时自动下电"@zh ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :Vehicle ;
            swrl:argument1 :vehicle ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerMode ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "1"^^xsd:integer ] ;
            rdf:rest [ rdf:type swrl:AtomList ;
                rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                    swrl:propertyPredicate :KeySearchTimeout ;
                    swrl:argument1 :vehicle ;
                    swrl:argument2 "true"^^xsd:boolean ] ;
                rdf:rest [ rdf:type swrl:AtomList ;
                    rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                        swrl:propertyPredicate :KeyValidSt ;
                        swrl:argument1 :vehicle ;
                        swrl:argument2 "0"^^xsd:integer ] ;
                    rdf:rest rdf:nil ] ] ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
            swrl:propertyPredicate :LDCU_PowerMode ;
            swrl:argument1 :vehicle ;
            swrl:argument2 "0"^^xsd:integer ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerOFFSource ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "5"^^xsd:integer ] ;
            rdf:rest rdf:nil ] ] .

# -----------------------------------------------------------------------------
# Rule: LowBattery (voltage < threshold) → PowerOff
# -----------------------------------------------------------------------------

:ruleAutoPowerOff_LowBattery rdf:type swrl:Imp ;
    rdfs:label "Auto Power Off: Low Battery Voltage"@en ;
    rdfs:label "自动下电：低电量电压"@zh ;
    rdfs:comment "Auto power off when battery voltage is below threshold (11.5V)"@en ;
    rdfs:comment "电池电压低于阈值(11.5V)时自动下电"@zh ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :Vehicle ;
            swrl:argument1 :vehicle ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :BatteryVoltage ;
                swrl:argument1 :vehicle ;
                swrl:argument2 :voltage ] ;
            rdf:rest [ rdf:type swrl:AtomList ;
                rdf:first [ rdf:type swrl:BuiltinAtom ;
                    swrl:builtin swrlb:lessThan ;
                    swrl:arguments ( :voltage "11.5"^^xsd:float ) ] ;
                rdf:rest [ rdf:type swrl:AtomList ;
                    rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                        swrl:propertyPredicate :LVEM_LowBattPowerOff_Req ;
                        swrl:argument1 :vehicle ;
                        swrl:argument2 "1"^^xsd:integer ] ;
                    rdf:rest rdf:nil ] ] ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
            swrl:propertyPredicate :LowBatteryCondition ;
            swrl:argument1 :vehicle ;
            swrl:argument2 "true"^^xsd:boolean ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerMode ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "0"^^xsd:integer ] ;
            rdf:rest [ rdf:type swrl:AtomList ;
                rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                    swrl:propertyPredicate :LDCU_PowerOFFSource ;
                    swrl:argument1 :vehicle ;
                    swrl:argument2 "5"^^xsd:integer ] ;
                rdf:rest rdf:nil ] ] ] .

# -----------------------------------------------------------------------------
# Rule: 30min countdown complete in LocalOn/RemoteOn → PowerOff
# -----------------------------------------------------------------------------

:ruleAutoPowerOff_30MinCountdown rdf:type swrl:Imp ;
    rdfs:label "Auto Power Off: 30 Minute Countdown Complete"@en ;
    rdfs:label "自动下电：30分钟倒计时完成"@zh ;
    rdfs:comment "Auto power off after 30 minute countdown in Local On or Remote On mode"@en ;
    rdfs:comment "Local On或Remote On模式下30分钟倒计时完成后自动下电"@zh ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :Vehicle ;
            swrl:argument1 :vehicle ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_AutoPowerOffFuncSt ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "4"^^xsd:integer ] ;
            rdf:rest rdf:nil ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
            swrl:propertyPredicate :AutoPowerOffTimerExpired ;
            swrl:argument1 :vehicle ;
            swrl:argument2 "true"^^xsd:boolean ] ;
        rdf:rest rdf:nil ] .

# -----------------------------------------------------------------------------
# Rule: 10min countdown complete in Convenience → PowerOff
# -----------------------------------------------------------------------------

:ruleAutoPowerOff_10MinCountdown rdf:type swrl:Imp ;
    rdfs:label "Auto Power Off: 10 Minute Countdown Complete"@en ;
    rdfs:label "自动下电：10分钟倒计时完成"@zh ;
    rdfs:comment "Auto power off after 10 minute countdown in Convenience mode"@en ;
    rdfs:comment "Convenience模式下10分钟倒计时完成后自动下电"@zh ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :Vehicle ;
            swrl:argument1 :vehicle ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_AutoPowerOffFuncSt ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "3"^^xsd:integer ] ;
            rdf:rest rdf:nil ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
            swrl:propertyPredicate :AutoPowerOffTimerExpired ;
            swrl:argument1 :vehicle ;
            swrl:argument2 "true"^^xsd:boolean ] ;
        rdf:rest rdf:nil ] .

# =============================================================================
# SECTION 4: FORCED POWER OFF RULES
# =============================================================================

# -----------------------------------------------------------------------------
# Rule: EmergencySwitch + 5s duration + speed < 3km/h → ForcePowerOff
# -----------------------------------------------------------------------------

:ruleForcedPowerOff_Static rdf:type swrl:Imp ;
    rdfs:label "Forced Power Off: Static (Low Speed)"@en ;
    rdfs:label "强制下电：静态（低速）"@zh ;
    rdfs:comment "Forced power off when emergency switch held for 5s with speed below 3km/h"@en ;
    rdfs:comment "紧急开关持续按下5秒且车速低于3km/h时强制下电"@zh ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :Vehicle ;
            swrl:argument1 :vehicle ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :EmergencyPowerOffSwSt ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "1"^^xsd:integer ] ;
            rdf:rest [ rdf:type swrl:AtomList ;
                rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                    swrl:propertyPredicate :EmergencySwitchHoldDuration ;
                    swrl:argument1 :vehicle ;
                    swrl:argument2 :duration ] ;
                rdf:rest [ rdf:type swrl:AtomList ;
                    rdf:first [ rdf:type swrl:BuiltinAtom ;
                        swrl:builtin swrlb:greaterThanOrEqual ;
                        swrl:arguments ( :duration "5"^^xsd:integer ) ] ;
                    rdf:rest [ rdf:type swrl:AtomList ;
                        rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                            swrl:propertyPredicate :VehicleSpeed ;
                            swrl:argument1 :vehicle ;
                            swrl:argument2 :speed ] ;
                        rdf:rest [ rdf:type swrl:AtomList ;
                            rdf:first [ rdf:type swrl:BuiltinAtom ;
                                swrl:builtin swrlb:lessThan ;
                                swrl:arguments ( :speed "3"^^xsd:float ) ] ;
                            rdf:rest rdf:nil ] ] ] ] ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
            swrl:propertyPredicate :ForcedPowerOffRequest ;
            swrl:argument1 :vehicle ;
            swrl:argument2 "true"^^xsd:boolean ] ;
        rdf:rest rdf:nil ] .

# -----------------------------------------------------------------------------
# Rule: EmergencySwitch + 5s duration + speed >= 3km/h → ForcePowerOffWithConfirmation
# -----------------------------------------------------------------------------

:ruleForcedPowerOff_Dynamic rdf:type swrl:Imp ;
    rdfs:label "Forced Power Off: Dynamic (High Speed)"@en ;
    rdfs:label "强制下电：动态（高速）"@zh ;
    rdfs:comment "Forced power off with confirmation when emergency switch held for 5s with speed at or above 3km/h"@en ;
    rdfs:comment "紧急开关持续按下5秒且车速大于等于3km/h时需要确认后强制下电"@zh ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :Vehicle ;
            swrl:argument1 :vehicle ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :EmergencyPowerOffSwSt ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "1"^^xsd:integer ] ;
            rdf:rest [ rdf:type swrl:AtomList ;
                rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                    swrl:propertyPredicate :EmergencySwitchHoldDuration ;
                    swrl:argument1 :vehicle ;
                    swrl:argument2 :duration ] ;
                rdf:rest [ rdf:type swrl:AtomList ;
                    rdf:first [ rdf:type swrl:BuiltinAtom ;
                        swrl:builtin swrlb:greaterThanOrEqual ;
                        swrl:arguments ( :duration "5"^^xsd:integer ) ] ;
                    rdf:rest [ rdf:type swrl:AtomList ;
                        rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                            swrl:propertyPredicate :VehicleSpeed ;
                            swrl:argument1 :vehicle ;
                            swrl:argument2 :speed ] ;
                        rdf:rest [ rdf:type swrl:AtomList ;
                            rdf:first [ rdf:type swrl:BuiltinAtom ;
                                swrl:builtin swrlb:greaterThanOrEqual ;
                                swrl:arguments ( :speed "3"^^xsd:float ) ] ;
                            rdf:rest rdf:nil ] ] ] ] ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
            swrl:propertyPredicate :ForcePowerOffConfirmationRequired ;
            swrl:argument1 :vehicle ;
            swrl:argument2 "true"^^xsd:boolean ] ;
        rdf:rest rdf:nil ] .

# -----------------------------------------------------------------------------
# Rule: Dynamic force power off with second confirmation → ForcePowerOff
# -----------------------------------------------------------------------------

:ruleForcedPowerOff_DynamicConfirmed rdf:type swrl:Imp ;
    rdfs:label "Forced Power Off: Dynamic with Confirmation"@en ;
    rdfs:label "强制下电：动态确认后下电"@zh ;
    rdfs:comment "Forced power off after second confirmation for high speed scenario"@en ;
    rdfs:comment "高速场景下二次确认后强制下电"@zh ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :Vehicle ;
            swrl:argument1 :vehicle ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :ForcePowerOffConfirmationRequired ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "true"^^xsd:boolean ] ;
            rdf:rest [ rdf:type swrl:AtomList ;
                rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                    swrl:propertyPredicate :SecondOffResult ;
                    swrl:argument1 :vehicle ;
                    swrl:argument2 "1"^^xsd:integer ] ;
                rdf:rest rdf:nil ] ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
            swrl:propertyPredicate :ForcedPowerOffRequest ;
            swrl:argument1 :vehicle ;
            swrl:argument2 "true"^^xsd:boolean ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :ForcePowerOffConfirmationRequired ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "false"^^xsd:boolean ] ;
            rdf:rest rdf:nil ] ] .

# -----------------------------------------------------------------------------
# Rule: 3 presses within 2 seconds → ForcePowerOff
# -----------------------------------------------------------------------------

:ruleForcedPowerOff_RapidPress rdf:type swrl:Imp ;
    rdfs:label "Forced Power Off: Rapid Press (3 times in 2s)"@en ;
    rdfs:label "强制下电：快速按压（2秒内3次）"@zh ;
    rdfs:comment "Forced power off when start button pressed 3 times within 2 seconds"@en ;
    rdfs:comment "2秒内按压启动按钮3次触发强制下电"@zh ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :Vehicle ;
            swrl:argument1 :vehicle ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :StartButtonPressCount ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "3"^^xsd:integer ] ;
            rdf:rest [ rdf:type swrl:AtomList ;
                rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                    swrl:propertyPredicate :StartButtonPressTimeWindow ;
                    swrl:argument1 :vehicle ;
                    swrl:argument2 :timer ] ;
                rdf:rest [ rdf:type swrl:AtomList ;
                    rdf:first [ rdf:type swrl:BuiltinAtom ;
                        swrl:builtin swrlb:lessThanOrEqual ;
                        swrl:arguments ( :timer "2"^^xsd:integer ) ] ;
                    rdf:rest rdf:nil ] ] ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
            swrl:propertyPredicate :ForcedPowerOffRequest ;
            swrl:argument1 :vehicle ;
            swrl:argument2 "true"^^xsd:boolean ] ;
        rdf:rest rdf:nil ] .

# =============================================================================
# SECTION 5: AUXILIARY DATA PROPERTIES FOR SWRL RULES
# =============================================================================

# These properties are used by the SWRL rules above and extend the main ontology

# -----------------------------------------------------------------------------
# Signal Status Properties
# -----------------------------------------------------------------------------

:LDCU_PowerMode rdf:type owl:DatatypeProperty ;
    rdfs:label "LDCU Power Mode"@en ;
    rdfs:label "LDCU电源模式"@zh ;
    rdfs:comment "Current power mode signal value (0=OFF, 1=Local ON, 2=Remote ON, 3=Reserved, 4=Convenience)"@en ;
    rdfs:comment "当前电源模式信号值 (0=关闭, 1=本地开启, 2=远程开启, 3=保留, 4=舒适模式)"@zh ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:integer .

:LDCU_PowerONSource rdf:type owl:DatatypeProperty ;
    rdfs:label "LDCU Power On Source"@en ;
    rdfs:label "LDCU上电源"@zh ;
    rdfs:comment "Power on source signal (0=Invalid, 1=Door Open, 2=Brake Press, 3=OTA/Remote Diag, 4=XPU Request)"@en ;
    rdfs:comment "上电源信号 (0=无效, 1=车门打开, 2=制动踏板, 3=OTA/远程诊断, 4=XPU请求)"@zh ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:integer .

:LDCU_PowerOFFSource rdf:type owl:DatatypeProperty ;
    rdfs:label "LDCU Power Off Source"@en ;
    rdfs:label "LDCU下电源"@zh ;
    rdfs:comment "Power off source signal (0=Invalid, 1=Door Lock, 2=Force Power Off, 3=OTA/Remote Diag, 4=XPU Request, 5=Auto Power Off)"@en ;
    rdfs:comment "下电源信号 (0=无效, 1=门锁, 2=强制下电, 3=OTA/远程诊断, 4=XPU请求, 5=自动下电)"@zh ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:integer .

:KeyValidSt rdf:type owl:DatatypeProperty ;
    rdfs:label "Key Valid Status"@en ;
    rdfs:label "钥匙有效状态"@zh ;
    rdfs:comment "Overall key validity status (0=Invalid, 1=Valid)"@en ;
    rdfs:comment "整体钥匙有效状态 (0=无效, 1=有效)"@zh ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:integer .

:KeyLocation rdf:type owl:DatatypeProperty ;
    rdfs:label "Key Location Signal"@en ;
    rdfs:label "钥匙位置信号"@zh ;
    rdfs:comment "Key location signal value (0=Not Searched, 1=In Car, 2=Near FL Door, 3=In Trunk, 4=Near Trunk, 5=Not Found, 6=Near FR Door)"@en ;
    rdfs:comment "钥匙位置信号值 (0=未搜索, 1=车内, 2=前左门附近, 3=后备箱, 4=后备箱附近, 5=未找到, 6=前右门附近)"@zh ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:integer .

