:DoorOpenWithStartButton rdf:type owl:DatatypeProperty ;
    rdfs:label "Door Open with Start Button"@en ;
    rdfs:label "开门并按启动按钮"@zh ;
    rdfs:comment "Door open event combined with start button press"@en ;
    rdfs:comment "车门打开并按下启动按钮"@zh ;
    rdfs:domain :Vehicle ;
