            swrl:propertyPredicate :LDCU_PowerMode ;
            swrl:argument1 :vehicle ;
            swrl:argument2 "4"^^xsd:integer ] ;
        rdf:rest rdf:nil ] .

# -----------------------------------------------------------------------------
# T_4_1: Remote On → Off
# -----------------------------------------------------------------------------
# IF: Vehicle in RemoteOnMode AND (ExitRemoteDiag OR DoorLock OR ForcedPowerOff OR LowBattery)
# THEN: transitionsTo OffMode

