        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerOFFSource ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "2"^^xsd:integer ] ;
            rdf:rest rdf:nil ] ] .

:ruleT_4_1_LowBattery rdf:type swrl:Imp ;
    rdfs:label "T_4_1: Remote On to Off via Low Battery"@en ;
    rdfs:label "T_4_1: 低电量从Remote On到Off"@zh ;
    rdfs:comment "Transition from Remote On mode to Off mode on low battery condition"@en ;
    rdfs:comment "低电量状态触发从Remote On模式跳转到Off模式"@zh ;
