@prefix : <http://example.org/vehicle-power-management#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix swrlb: <http://www.w3.org/2003/11/swrlb#> .

# =============================================================================
# SWRL RULES FOR VEHICLE POWER MANAGEMENT ONTOLOGY
# =============================================================================

<http://example.org/vehicle-power-management/swrl> rdf:type owl:Ontology ;
    rdfs:label "Vehicle Power Management SWRL Rules"@en ;
    rdfs:label "车辆电源管理SWRL规则"@zh ;
    rdfs:comment "SWRL reasoning rules for vehicle power management"@en ;
    rdfs:comment "车辆电源管理的SWRL推理规则"@zh ;
    owl:versionInfo "1.0" ;
    owl:imports <http://example.org/vehicle-power-management/core> .
#
# This file contains SWRL (Semantic Web Rule Language) rules for the vehicle
# power management ontology. Rules are defined according to W3C SWRL specification.
#
# Rule Categories:
# 1. Power Mode Transition Rules (T_1_3 through T_4_3)
# 2. Key Validation Rules
# 3. Auto Power Off Rules
# 4. Forced Power Off Rules
#
# =============================================================================

# =============================================================================
# SWRL VARIABLES
# =============================================================================

:vehicle rdf:type swrl:Variable ;
    rdfs:label "Vehicle Variable"@en ;
    rdfs:label "车辆变量"@zh .

:fromMode rdf:type swrl:Variable ;
    rdfs:label "From Mode Variable"@en ;
    rdfs:label "源模式变量"@zh .

:toMode rdf:type swrl:Variable ;
    rdfs:label "To Mode Variable"@en ;
    rdfs:label "目标模式变量"@zh .

:key rdf:type swrl:Variable ;
    rdfs:label "Key Variable"@en ;
    rdfs:label "钥匙变量"@zh .

:signal rdf:type swrl:Variable ;
    rdfs:label "Signal Variable"@en ;
    rdfs:label "信号变量"@zh .

:source rdf:type swrl:Variable ;
    rdfs:label "Source Variable"@en ;
    rdfs:label "源变量"@zh .

:speed rdf:type swrl:Variable ;
    rdfs:label "Speed Variable"@en ;
    rdfs:label "速度变量"@zh .

:voltage rdf:type swrl:Variable ;
    rdfs:label "Voltage Variable"@en ;
    rdfs:label "电压变量"@zh .

:duration rdf:type swrl:Variable ;
    rdfs:label "Duration Variable"@en ;
    rdfs:label "持续时间变量"@zh .

:timer rdf:type swrl:Variable ;
    rdfs:label "Timer Variable"@en ;
    rdfs:label "计时器变量"@zh .

# =============================================================================
# SECTION 1: POWER MODE TRANSITION RULES
# =============================================================================

# -----------------------------------------------------------------------------
# T_1_3: Off → Local On (按启动按钮上电 / 踩刹车按启动按钮上电)
# -----------------------------------------------------------------------------
# IF: Vehicle in OffMode AND KeyValidSt=1 AND (BrakePressed OR StartButtonPressed)
# THEN: transitionsTo LocalOnMode, PowerONSource=StartButton

:ruleT_1_3_StartButton rdf:type swrl:Imp ;
    rdfs:label "T_1_3: Off to Local On via Start Button"@en ;
    rdfs:label "T_1_3: 按启动按钮从Off到Local On"@zh ;
    rdfs:comment "Transition from Off mode to Local On mode when start button is pressed with valid key"@en ;
    rdfs:comment "当按下启动按钮且钥匙有效时，从Off模式跳转到Local On模式"@zh ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :Vehicle ;
            swrl:argument1 :vehicle ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerMode ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "0"^^xsd:integer ] ;
            rdf:rest [ rdf:type swrl:AtomList ;
                rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                    swrl:propertyPredicate :KeyValidSt ;
                    swrl:argument1 :vehicle ;
                    swrl:argument2 "1"^^xsd:integer ] ;
                rdf:rest [ rdf:type swrl:AtomList ;
                    rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                        swrl:propertyPredicate :StartButtonPressed ;
                        swrl:argument1 :vehicle ;
                        swrl:argument2 "true"^^xsd:boolean ] ;
                    rdf:rest rdf:nil ] ] ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
            swrl:propertyPredicate :LDCU_PowerMode ;
            swrl:argument1 :vehicle ;
            swrl:argument2 "1"^^xsd:integer ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerONSource ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "1"^^xsd:integer ] ;
            rdf:rest rdf:nil ] ] .

:ruleT_1_3_BrakePress rdf:type swrl:Imp ;
    rdfs:label "T_1_3: Off to Local On via Brake Press"@en ;
    rdfs:label "T_1_3: 踩刹车从Off到Local On"@zh ;
    rdfs:comment "Transition from Off mode to Local On mode when brake is pressed with valid key"@en ;
    rdfs:comment "当踩下刹车且钥匙有效时，从Off模式跳转到Local On模式"@zh ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :Vehicle ;
            swrl:argument1 :vehicle ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerMode ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "0"^^xsd:integer ] ;
            rdf:rest [ rdf:type swrl:AtomList ;
                rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                    swrl:propertyPredicate :KeyValidSt ;
                    swrl:argument1 :vehicle ;
                    swrl:argument2 "1"^^xsd:integer ] ;
                rdf:rest [ rdf:type swrl:AtomList ;
                    rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                        swrl:propertyPredicate :BrakePressedSt ;
                        swrl:argument1 :vehicle ;
                        swrl:argument2 "true"^^xsd:boolean ] ;
                    rdf:rest rdf:nil ] ] ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
            swrl:propertyPredicate :LDCU_PowerMode ;
            swrl:argument1 :vehicle ;
            swrl:argument2 "1"^^xsd:integer ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerONSource ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "2"^^xsd:integer ] ;
            rdf:rest rdf:nil ] ] .

# -----------------------------------------------------------------------------
# T_1_4: Off → Remote On (OTA/远程诊断上电 / 自动泊车上电)
# -----------------------------------------------------------------------------
# IF: Vehicle in OffMode AND (OTAPowerOnValid=1 OR RemoteDiagRequest=1 OR XPUPowerReq=1)
# THEN: transitionsTo RemoteOnMode

:ruleT_1_4_OTA rdf:type swrl:Imp ;
    rdfs:label "T_1_4: Off to Remote On via OTA"@en ;
    rdfs:label "T_1_4: OTA上电从Off到Remote On"@zh ;
    rdfs:comment "Transition from Off mode to Remote On mode via OTA request"@en ;
    rdfs:comment "通过OTA请求从Off模式跳转到Remote On模式"@zh ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :Vehicle ;
            swrl:argument1 :vehicle ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerMode ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "0"^^xsd:integer ] ;
            rdf:rest [ rdf:type swrl:AtomList ;
                rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                    swrl:propertyPredicate :OTAPowerOnValid ;
                    swrl:argument1 :vehicle ;
                    swrl:argument2 "1"^^xsd:integer ] ;
                rdf:rest rdf:nil ] ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
            swrl:propertyPredicate :LDCU_PowerMode ;
            swrl:argument1 :vehicle ;
            swrl:argument2 "2"^^xsd:integer ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerONSource ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "3"^^xsd:integer ] ;
            rdf:rest rdf:nil ] ] .

:ruleT_1_4_RemoteDiag rdf:type swrl:Imp ;
    rdfs:label "T_1_4: Off to Remote On via Remote Diag"@en ;
    rdfs:label "T_1_4: 远程诊断上电从Off到Remote On"@zh ;
    rdfs:comment "Transition from Off mode to Remote On mode via remote diagnostics request"@en ;
    rdfs:comment "通过远程诊断请求从Off模式跳转到Remote On模式"@zh ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :Vehicle ;
            swrl:argument1 :vehicle ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerMode ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "0"^^xsd:integer ] ;
            rdf:rest [ rdf:type swrl:AtomList ;
                rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                    swrl:propertyPredicate :RemoteDiagRequest ;
                    swrl:argument1 :vehicle ;
                    swrl:argument2 "1"^^xsd:integer ] ;
                rdf:rest rdf:nil ] ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
            swrl:propertyPredicate :LDCU_PowerMode ;
            swrl:argument1 :vehicle ;
            swrl:argument2 "2"^^xsd:integer ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerONSource ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "3"^^xsd:integer ] ;
            rdf:rest rdf:nil ] ] .

:ruleT_1_4_XPU rdf:type swrl:Imp ;
    rdfs:label "T_1_4: Off to Remote On via XPU"@en ;
    rdfs:label "T_1_4: XPU请求上电从Off到Remote On"@zh ;
    rdfs:comment "Transition from Off mode to Remote On mode via XPU power request (auto parking)"@en ;
    rdfs:comment "通过XPU请求（自动泊车）从Off模式跳转到Remote On模式"@zh ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :Vehicle ;
            swrl:argument1 :vehicle ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerMode ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "0"^^xsd:integer ] ;
            rdf:rest [ rdf:type swrl:AtomList ;
                rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                    swrl:propertyPredicate :XPUPowerReq ;
                    swrl:argument1 :vehicle ;
                    swrl:argument2 "1"^^xsd:integer ] ;
                rdf:rest rdf:nil ] ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
            swrl:propertyPredicate :LDCU_PowerMode ;
            swrl:argument1 :vehicle ;
            swrl:argument2 "2"^^xsd:integer ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerONSource ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "4"^^xsd:integer ] ;
            rdf:rest rdf:nil ] ] .

# -----------------------------------------------------------------------------
# T_2_1: Convenience → Off
# -----------------------------------------------------------------------------
# IF: Vehicle in ConvenienceMode AND (DoorLockEvent OR DoorOpenEvent OR 
#     AutoPowerOffTimerExpired OR LowBattery)
# THEN: transitionsTo OffMode

:ruleT_2_1_DoorLock rdf:type swrl:Imp ;
    rdfs:label "T_2_1: Convenience to Off via Door Lock"@en ;
    rdfs:label "T_2_1: 门锁事件从Convenience到Off"@zh ;
    rdfs:comment "Transition from Convenience mode to Off mode on door lock event"@en ;
    rdfs:comment "门锁事件触发从Convenience模式跳转到Off模式"@zh ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :Vehicle ;
            swrl:argument1 :vehicle ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerMode ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "4"^^xsd:integer ] ;
            rdf:rest [ rdf:type swrl:AtomList ;
                rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                    swrl:propertyPredicate :DoorLockEvent ;
                    swrl:argument1 :vehicle ;
                    swrl:argument2 "true"^^xsd:boolean ] ;
                rdf:rest rdf:nil ] ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
            swrl:propertyPredicate :LDCU_PowerMode ;
            swrl:argument1 :vehicle ;
            swrl:argument2 "0"^^xsd:integer ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerOFFSource ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "1"^^xsd:integer ] ;
            rdf:rest rdf:nil ] ] .

:ruleT_2_1_DoorOpen rdf:type swrl:Imp ;
    rdfs:label "T_2_1: Convenience to Off via Door Open"@en ;
    rdfs:label "T_2_1: 车门打开从Convenience到Off"@zh ;
    rdfs:comment "Transition from Convenience mode to Off mode on door open event"@en ;
    rdfs:comment "车门打开事件触发从Convenience模式跳转到Off模式"@zh ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :Vehicle ;
            swrl:argument1 :vehicle ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerMode ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "4"^^xsd:integer ] ;
            rdf:rest [ rdf:type swrl:AtomList ;
                rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                    swrl:propertyPredicate :DoorOpenEvent ;
                    swrl:argument1 :vehicle ;
                    swrl:argument2 "true"^^xsd:boolean ] ;
                rdf:rest rdf:nil ] ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
            swrl:propertyPredicate :LDCU_PowerMode ;
            swrl:argument1 :vehicle ;
            swrl:argument2 "0"^^xsd:integer ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerOFFSource ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "1"^^xsd:integer ] ;
            rdf:rest rdf:nil ] ] .

:ruleT_2_1_AutoPowerOff rdf:type swrl:Imp ;
    rdfs:label "T_2_1: Convenience to Off via Auto Power Off Timer"@en ;
    rdfs:label "T_2_1: 自动下电超时从Convenience到Off"@zh ;
    rdfs:comment "Transition from Convenience mode to Off mode on auto power off timer expiration"@en ;
    rdfs:comment "自动下电计时器到期触发从Convenience模式跳转到Off模式"@zh ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :Vehicle ;
            swrl:argument1 :vehicle ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerMode ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "4"^^xsd:integer ] ;
            rdf:rest [ rdf:type swrl:AtomList ;
                rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                    swrl:propertyPredicate :AutoPowerOffTimerExpired ;
                    swrl:argument1 :vehicle ;
                    swrl:argument2 "true"^^xsd:boolean ] ;
                rdf:rest rdf:nil ] ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
            swrl:propertyPredicate :LDCU_PowerMode ;
            swrl:argument1 :vehicle ;
            swrl:argument2 "0"^^xsd:integer ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerOFFSource ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "5"^^xsd:integer ] ;
            rdf:rest rdf:nil ] ] .

:ruleT_2_1_LowBattery rdf:type swrl:Imp ;
    rdfs:label "T_2_1: Convenience to Off via Low Battery"@en ;
    rdfs:label "T_2_1: 低电量从Convenience到Off"@zh ;
    rdfs:comment "Transition from Convenience mode to Off mode on low battery condition"@en ;
    rdfs:comment "低电量状态触发从Convenience模式跳转到Off模式"@zh ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :Vehicle ;
            swrl:argument1 :vehicle ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerMode ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "4"^^xsd:integer ] ;
            rdf:rest [ rdf:type swrl:AtomList ;
                rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                    swrl:propertyPredicate :LowBatteryCondition ;
                    swrl:argument1 :vehicle ;
                    swrl:argument2 "true"^^xsd:boolean ] ;
                rdf:rest rdf:nil ] ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
            swrl:propertyPredicate :LDCU_PowerMode ;
            swrl:argument1 :vehicle ;
            swrl:argument2 "0"^^xsd:integer ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerOFFSource ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "5"^^xsd:integer ] ;
            rdf:rest rdf:nil ] ] .

# -----------------------------------------------------------------------------
# T_3_1: Local On → Off
# -----------------------------------------------------------------------------
# IF: Vehicle in LocalOnMode AND (DoorOpenWithStartButton OR AutoPowerOffTimerExpired OR 
#     ForcedPowerOff OR DiagCommand OR LowBattery OR DoorLockAfterLeave)
# THEN: transitionsTo OffMode

:ruleT_3_1_DoorOpenWithButton rdf:type swrl:Imp ;
    rdfs:label "T_3_1: Local On to Off via Door Open with Start Button"@en ;
    rdfs:label "T_3_1: 开门按启动按钮从Local On到Off"@zh ;
    rdfs:comment "Transition from Local On mode to Off mode on door open with start button press"@en ;
    rdfs:comment "开门并按下启动按钮触发从Local On模式跳转到Off模式"@zh ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :Vehicle ;
            swrl:argument1 :vehicle ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerMode ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "1"^^xsd:integer ] ;
            rdf:rest [ rdf:type swrl:AtomList ;
                rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                    swrl:propertyPredicate :DoorOpenWithStartButton ;
                    swrl:argument1 :vehicle ;
                    swrl:argument2 "true"^^xsd:boolean ] ;
                rdf:rest rdf:nil ] ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
            swrl:propertyPredicate :LDCU_PowerMode ;
            swrl:argument1 :vehicle ;
            swrl:argument2 "0"^^xsd:integer ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerOFFSource ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "1"^^xsd:integer ] ;
            rdf:rest rdf:nil ] ] .

:ruleT_3_1_AutoPowerOff rdf:type swrl:Imp ;
    rdfs:label "T_3_1: Local On to Off via Auto Power Off Timer"@en ;
    rdfs:label "T_3_1: 自动下电超时从Local On到Off"@zh ;
    rdfs:comment "Transition from Local On mode to Off mode on auto power off timer expiration"@en ;
    rdfs:comment "自动下电计时器到期触发从Local On模式跳转到Off模式"@zh ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :Vehicle ;
            swrl:argument1 :vehicle ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerMode ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "1"^^xsd:integer ] ;
            rdf:rest [ rdf:type swrl:AtomList ;
                rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                    swrl:propertyPredicate :AutoPowerOffTimerExpired ;
                    swrl:argument1 :vehicle ;
                    swrl:argument2 "true"^^xsd:boolean ] ;
                rdf:rest rdf:nil ] ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
            swrl:propertyPredicate :LDCU_PowerMode ;
            swrl:argument1 :vehicle ;
            swrl:argument2 "0"^^xsd:integer ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerOFFSource ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "5"^^xsd:integer ] ;
            rdf:rest rdf:nil ] ] .

:ruleT_3_1_ForcedPowerOff rdf:type swrl:Imp ;
    rdfs:label "T_3_1: Local On to Off via Forced Power Off"@en ;
    rdfs:label "T_3_1: 强制下电从Local On到Off"@zh ;
    rdfs:comment "Transition from Local On mode to Off mode via forced power off"@en ;
    rdfs:comment "强制下电触发从Local On模式跳转到Off模式"@zh ;
    swrl:body [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:ClassAtom ;
            swrl:classPredicate :Vehicle ;
            swrl:argument1 :vehicle ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerMode ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "1"^^xsd:integer ] ;
            rdf:rest [ rdf:type swrl:AtomList ;
                rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                    swrl:propertyPredicate :ForcedPowerOffRequest ;
                    swrl:argument1 :vehicle ;
                    swrl:argument2 "true"^^xsd:boolean ] ;
                rdf:rest rdf:nil ] ] ] ;
    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
            swrl:propertyPredicate :LDCU_PowerMode ;
            swrl:argument1 :vehicle ;
            swrl:argument2 "0"^^xsd:integer ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerOFFSource ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "2"^^xsd:integer ] ;
            rdf:rest rdf:nil ] ] .

