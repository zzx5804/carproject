    rdfs:label "远程诊断请求"@zh ;
    rdfs:comment "Remote diagnostics power on request"@en ;
    rdfs:comment "远程诊断上电请求"@zh ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:integer .

:XPUPowerReq rdf:type owl:DatatypeProperty ;
    rdfs:label "XPU Power Request"@en ;
    rdfs:label "XPU上电请求"@zh ;
    rdfs:comment "XPU power request signal (0=No Request, 1=Power On, 2=Power Off)"@en ;
    rdfs:comment "XPU上电请求信号 (0=无请求, 1=上电, 2=下电)"@zh ;
    rdfs:domain :Vehicle ;
