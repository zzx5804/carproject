    rdfs:label "蓝牙钥匙有效状态"@zh ;
    rdfs:comment "BLE key validity status (0=Invalid, 1=Valid)"@en ;
    rdfs:comment "蓝牙钥匙有效性状态 (0=无效, 1=有效)"@zh ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:integer .

:RKEKeyValidSt rdf:type owl:DatatypeProperty ;
    rdfs:label "RKE Key Valid Status"@en ;
    rdfs:label "遥控钥匙有效状态"@zh ;
    rdfs:comment "RKE key validity status (0=Invalid, 1=Valid)"@en ;
    rdfs:comment "遥控钥匙有效性状态 (0=无效, 1=有效)"@zh ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:integer .

:KeySearchTimeout rdf:type owl:DatatypeProperty ;
    rdfs:label "Key Search Timeout"@en ;
    rdfs:label "钥匙搜索超时"@zh ;
    rdfs:comment "Key search timer timeout flag"@en ;
    rdfs:comment "钥匙搜索计时器超时标志"@zh ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:boolean .

# -----------------------------------------------------------------------------
# Auto Power Off Properties
# -----------------------------------------------------------------------------

:AutoPowerOffTimerExpired rdf:type owl:DatatypeProperty ;
    rdfs:label "Auto Power Off Timer Expired"@en ;
    rdfs:label "自动下电计时器到期"@zh ;
    rdfs:comment "Auto power off countdown timer expired flag"@en ;
    rdfs:comment "自动下电倒计时器到期标志"@zh ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:boolean .

:LowBatteryCondition rdf:type owl:DatatypeProperty ;
    rdfs:label "Low Battery Condition"@en ;
    rdfs:label "低电量状态"@zh ;
    rdfs:comment "Low battery condition flag"@en ;
    rdfs:comment "低电量状态标志"@zh ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:boolean .

:LDCU_AutoPowerOffFuncSt rdf:type owl:DatatypeProperty ;
    rdfs:label "LDCU Auto Power Off Function State"@en ;
    rdfs:label "LDCU自动下电功能状态"@zh ;
    rdfs:comment "Auto power off function state (0=Not Active, 2=30min Countdown, 3=10min Countdown, 4=Countdown Completed)"@en ;
    rdfs:comment "自动下电功能状态 (0=未激活, 2=30分钟倒计时, 3=10分钟倒计时, 4=倒计时完成)"@zh ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:integer .

:LVEM_LowBattPowerOff_Req rdf:type owl:DatatypeProperty ;
    rdfs:label "Low Battery Power Off Request"@en ;
    rdfs:label "低电量下电请求"@zh ;
    rdfs:comment "Low battery power off request signal (0=Not Active, 1=Active)"@en ;
    rdfs:comment "低电量下电请求信号 (0=未激活, 1=激活)"@zh ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:integer .

:BatteryVoltage rdf:type owl:DatatypeProperty ;
    rdfs:label "Battery Voltage"@en ;
    rdfs:label "电池电压"@zh ;
    rdfs:comment "12V battery voltage in volts"@en ;
    rdfs:comment "12V电池电压，单位：伏特"@zh ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:float .

# -----------------------------------------------------------------------------
# Emergency/Forced Power Off Properties
# -----------------------------------------------------------------------------

:EmergencyPowerOffSwSt rdf:type owl:DatatypeProperty ;
    rdfs:label "Emergency Power Off Switch Status"@en ;
    rdfs:label "强制下电开关状态"@zh ;
    rdfs:comment "Emergency power off switch status (0=Not Pressed, 1=Pressed, 2=Invalid, 3=Not Used)"@en ;
    rdfs:comment "强制下电开关状态 (0=未按下, 1=已按下, 2=无效, 3=未使用)"@zh ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:integer .

:EmergencySwitchHoldDuration rdf:type owl:DatatypeProperty ;
    rdfs:label "Emergency Switch Hold Duration"@en ;
    rdfs:label "紧急开关按压持续时间"@zh ;
    rdfs:comment "Duration that emergency switch has been held in seconds"@en ;
    rdfs:comment "紧急开关持续按压时间，单位：秒"@zh ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:integer .

:ForcedPowerOffRequest rdf:type owl:DatatypeProperty ;
    rdfs:label "Forced Power Off Request"@en ;
    rdfs:label "强制下电请求"@zh ;
    rdfs:comment "Forced power off request flag"@en ;
    rdfs:comment "强制下电请求标志"@zh ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:boolean .

:ForcePowerOffConfirmationRequired rdf:type owl:DatatypeProperty ;
    rdfs:label "Force Power Off Confirmation Required"@en ;
    rdfs:label "强制下电需要确认"@zh ;
    rdfs:comment "Flag indicating confirmation is required for forced power off"@en ;
    rdfs:comment "指示强制下电需要确认的标志"@zh ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:boolean .

:SecondOffResult rdf:type owl:DatatypeProperty ;
    rdfs:label "Second Off Result"@en ;
    rdfs:label "强制下电二次确认结果"@zh ;
    rdfs:comment "Result of second confirmation (0=No Command, 1=OK, 2=Cancel)"@en ;
    rdfs:comment "二次确认结果 (0=无命令, 1=确认, 2=取消)"@zh ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:integer .

:StartButtonPressCount rdf:type owl:DatatypeProperty ;
    rdfs:label "Start Button Press Count"@en ;
    rdfs:label "启动按钮按压次数"@zh ;
    rdfs:comment "Number of start button presses within time window"@en ;
    rdfs:comment "时间窗口内启动按钮按压次数"@zh ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:integer .

:StartButtonPressTimeWindow rdf:type owl:DatatypeProperty ;
    rdfs:label "Start Button Press Time Window"@en ;
    rdfs:label "启动按钮按压时间窗口"@zh ;
    rdfs:comment "Time window for press count in seconds"@en ;
    rdfs:comment "按压次数计时时间窗口，单位：秒"@zh ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:integer .

:VehicleSpeed rdf:type owl:DatatypeProperty ;
    rdfs:label "Vehicle Speed"@en ;
    rdfs:label "车速"@zh ;
    rdfs:comment "Vehicle speed in km/h"@en ;
    rdfs:comment "车速，单位：公里/小时"@zh ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:float .

