    swrl:head [ rdf:type swrl:AtomList ;
        rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
            swrl:propertyPredicate :LDCU_PowerMode ;
            swrl:argument1 :vehicle ;
            swrl:argument2 "0"^^xsd:integer ] ;
        rdf:rest [ rdf:type swrl:AtomList ;
            rdf:first [ rdf:type swrl:DatavaluedPropertyAtom ;
                swrl:propertyPredicate :LDCU_PowerOFFSource ;
                swrl:argument1 :vehicle ;
                swrl:argument2 "1"^^xsd:integer ] ;
            rdf:rest rdf:nil ] ] .

