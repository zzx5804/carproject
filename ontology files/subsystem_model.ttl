:vehicleInstance rdf:type :Vehicle ;
    rdfs:label "Vehicle Instance"@en ;
    rdfs:label "车辆实例"@zh ;
    :hasSubsystem :subsystem_BodyElectronics ;
    :hasSubsystem :subsystem_PowerManagement ;
    :hasSubsystem :subsystem_Infotainment ;
    :hasSubsystem :subsystem_ADAS ;
    :hasSubsystem :subsystem_Comfort ;
    :hasSubsystem :subsystem_Network ;
    :hasSubsystem :subsystem_Safety ;
    :hasSubsystem :subsystem_ThermalManagement ;
    :hasSubsystem :subsystem_Chassis ;
    :hasSubsystem :subsystem_Electrical ;
    :hasSubsystem :subsystem_BatterySystem ;
    rdfs:comment "Reference vehicle instance for subsystem relationships"@en ;
    rdfs:comment "用于子系统关系的参考车辆实例"@zh .

# =============================================================================
# COMPLEX OWL CONSTRUCTS
# =============================================================================

# -----------------------------------------------------------------------------
# Subsystem with Active Fault
# -----------------------------------------------------------------------------

:SubsystemWithActiveFault rdf:type owl:Class ;
    rdfs:label "Subsystem With Active Fault"@en ;
    rdfs:label "具有活动故障的子系统"@zh ;
    rdfs:comment "Subsystem that has at least one active fault"@en ;
    rdfs:comment "至少具有一个活动故障的子系统"@zh ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :hasActiveFault ;
        owl:someValuesFrom :ActiveFault
    ] .

# -----------------------------------------------------------------------------
# Healthy Subsystem
# -----------------------------------------------------------------------------

:HealthySubsystem rdf:type owl:Class ;
    rdfs:label "Healthy Subsystem"@en ;
    rdfs:label "健康子系统"@zh ;
    rdfs:comment "Subsystem with health score above 80 and no active faults"@en ;
    rdfs:comment "健康分数高于80且无活动故障的子系统"@zh ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Subsystem
            [ rdf:type owl:Restriction ;
              owl:onProperty :hasHealthScore ;
              owl:someValuesFrom [
                  rdf:type rdfs:Datatype ;
                  owl:onDatatype xsd:integer ;
                  owl:withRestrictions ([xsd:minInclusive 80])
              ]
            ]
            [ rdf:type owl:Restriction ;
              owl:onProperty :hasActiveFault ;
              owl:cardinality 0
            ]
        )
    ] .

# -----------------------------------------------------------------------------
# Critical Subsystem
# -----------------------------------------------------------------------------

:CriticalSubsystem rdf:type owl:Class ;
    rdfs:label "Critical Subsystem"@en ;
    rdfs:label "关键子系统"@zh ;
    rdfs:comment "Subsystem with critical status or health score below 50"@en ;
    rdfs:comment "状态严重或健康分数低于50的子系统"@zh ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:unionOf (
            [ rdf:type owl:Restriction ;
              owl:onProperty :hasOverallStatus ;
              owl:hasValue :statusCritical
            ]
            [ rdf:type owl:Restriction ;
              owl:onProperty :hasHealthScore ;
              owl:someValuesFrom [
                  rdf:type rdfs:Datatype ;
                  owl:onDatatype xsd:integer ;
                  owl:withRestrictions ([xsd:maxExclusive 50])
              ]
            ]
        )
    ] .

# -----------------------------------------------------------------------------
# Powertrain Subsystem with High Voltage
# -----------------------------------------------------------------------------

:HighVoltageSubsystem rdf:type owl:Class ;
    rdfs:label "High Voltage Subsystem"@en ;
    rdfs:label "高压子系统"@zh ;
    rdfs:comment "Subsystem operating at high voltage (>60V)"@en ;
    rdfs:comment "工作电压大于60V的子系统"@zh ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf (
            :Subsystem
            [ rdf:type owl:Restriction ;
              owl:onProperty :hasOperatingVoltage ;
              owl:someValuesFrom [
                  rdf:type rdfs:Datatype ;
                  owl:onDatatype xsd:float ;
                  owl:withRestrictions ([xsd:minExclusive 60.0])
              ]
            ]
        )
    ] .

# -----------------------------------------------------------------------------
# Connected Subsystem
# -----------------------------------------------------------------------------

:ConnectedSubsystem rdf:type owl:Class ;
    rdfs:label "Connected Subsystem"@en ;
    rdfs:label "已连接子系统"@zh ;
    rdfs:comment "Subsystem that communicates with at least one other subsystem"@en ;
    rdfs:comment "与至少一个其他子系统通信的子系统"@zh ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :communicatesWith ;
        owl:someValuesFrom :Subsystem
    ] .

# -----------------------------------------------------------------------------
# Controlling Subsystem
# -----------------------------------------------------------------------------

:ControllingSubsystem rdf:type owl:Class ;
    rdfs:label "Controlling Subsystem"@en ;
    rdfs:label "控制子系统"@zh ;
    rdfs:comment "Subsystem that controls at least one other subsystem"@en ;
    rdfs:comment "控制至少一个其他子系统的子系统"@zh ;
    owl:equivalentClass [
        rdf:type owl:Restriction ;
        owl:onProperty :controls ;
        owl:someValuesFrom :Subsystem
    ] .
