    :hasOperatingVoltage "12.0"^^xsd:float ;
    :hasOperatingTempMin "-40.0"^^xsd:float ;
    :hasOperatingTempMax "85.0"^^xsd:float ;
    :hasHealthScore 97 ;
    :hasPerformanceScore 95 ;
    :hasOverallStatus :statusNormal ;
    :usesCommunicationBus :busEthernet_1Gbps ;
