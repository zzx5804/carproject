    :hasPrimaryFunction "提供自动驾驶和驾驶辅助功能"@zh ;
    :hasSecondaryFunctions "Parking assist, lane keeping, adaptive cruise control"@en ;
    :hasSecondaryFunctions "泊车辅助、车道保持、自适应巡航控制"@zh ;
