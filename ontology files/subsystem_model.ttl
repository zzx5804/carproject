# -----------------------------------------------------------------------------
# ADAS Subsystem
# -----------------------------------------------------------------------------

:subsystem_ADAS rdf:type :ADASSubsystem ;
    rdfs:label "ADAS Subsystem"@en ;
    rdfs:label "高级驾驶辅助系统子系统"@zh ;
    :hasSubsystemId "SUB-ADAS-001" ;
    :hasSubsystemName "Advanced Driver Assistance System" ;
    :hasSubsystemCode "ADAS" ;
    :hasCategoryCode "ADAS" ;
