# =============================================================================
# INDIVIDUALS - ECU to Subsystem Mappings
# =============================================================================

# ECU mappings to their primary subsystems
# These are defined using belongsToSubsystem property

:ecu_LDCU_BodyMap rdf:type :LDCU ;
    rdfs:label "LDCU Body Mapping"@en ;
    rdfs:label "LDCU车身映射"@zh ;
    :belongsToSubsystem :subsystem_BodyElectronics ;
    rdfs:comment "LDCU is primarily part of the Body Electronics subsystem"@en ;
    rdfs:comment "LDCU主要属于车身电子子系统"@zh .

:ecu_RDCU_BodyMap rdf:type :RDCU ;
    rdfs:label "RDCU Body Mapping"@en ;
    rdfs:label "RDCU车身映射"@zh ;
    :belongsToSubsystem :subsystem_BodyElectronics ;
    rdfs:comment "RDCU is primarily part of the Body Electronics subsystem"@en ;
    rdfs:comment "RDCU主要属于车身电子子系统"@zh .

:ecu_CDCU_ComfortMap rdf:type :CDCU ;
    rdfs:label "CDCU Comfort Mapping"@en ;
    rdfs:label "CDCU舒适映射"@zh ;
    :belongsToSubsystem :subsystem_Comfort ;
    rdfs:comment "CDCU is part of Comfort subsystem for infotainment and comfort"@en ;
    rdfs:comment "CDCU属于舒适子系统，用于信息娱乐和舒适功能"@zh .

:ecu_TBOX_NetworkMap rdf:type :TBOX ;
    rdfs:label "TBOX Network Mapping"@en ;
    rdfs:label "TBOX网络映射"@zh ;
    :belongsToSubsystem :subsystem_Network ;
    rdfs:comment "TBOX is part of Network subsystem for telematics"@en ;
    rdfs:comment "TBOX属于网络子系统，用于远程通信"@zh .

:ecu_XPU_ADASMap rdf:type :XPU ;
    rdfs:label "XPU ADAS Mapping"@en ;
    rdfs:label "XPU ADAS映射"@zh ;
