# =============================================================================
# LLM Configuration
# =============================================================================

# Provider selection: "local" (default) or "openrouter"
LLM_PROVIDER=local

# --- OpenRouter Configuration (when LLM_PROVIDER=openrouter) ---
LLM_OPENROUTER_API_KEY=your-openrouter-api-key-here
LLM_OPENROUTER_MODEL=openai/gpt-3.5-turbo

# --- Local LLM Configuration (when LLM_PROVIDER=local) ---
LLM_ENDPOINT=https://llm-gateway.dev.cn-vwa.volkswagen-cea.com
LLM_API_KEY=your-local-api-key-here
LLM_MODEL=GLM-5-FP8

# --- Common Configuration ---
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60
LLM_ENABLE_FALLBACK=true
LLM_LOG_REQUESTS=true
